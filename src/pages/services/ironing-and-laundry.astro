      offer: {
        headline: "Start With Your Laundry Architecture",
        details: "Send the item types, load size, collection area, turnaround needs and whether this is home, professional, family or Airbnb laundry support.",
        cta: {
          text: "Request Laundry Support",
          url: "/contact/laundry-consultation?offer=first20"
        }
