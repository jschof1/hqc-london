---

<Layout
  title="HQC Concierge Laundry London | High Quality Clean"
  description="HQC Concierge Laundry across London: dry cleaning coordination, wash and fold, wash and iron, ironing-only care, family packages and Airbnb linen support."
>
  <Header />
  <ServiceTemplate service={ironingLaundryPage.service} />
</Layout>
