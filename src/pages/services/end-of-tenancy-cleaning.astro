---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PriorityServicePage from '../../components/PriorityServicePage.astro';
import { servicePageBySlug } from '../../data/servicePages';

const page = {
  ...servicePageBySlug['end-of-tenancy-cleaning'],
  h1: 'End of tenancy cleaning in London for move-outs and handovers',
  seoTitle: 'End of Tenancy Cleaning London | Move-Out & Handover Cleaning | HQC',
  metaDescription:
    'End of tenancy cleaning in London for tenants, landlords, agents and property managers preparing homes for check-out, move-out, handover or re-let.',
};
---

<Layout title={page.seoTitle} description={page.metaDescription}>
  <Header />
  <PriorityServicePage
    page={page}
    eyebrow="Move-out cleaning"
    intro="High Quality Clean provides detailed end of tenancy and move-out cleaning across London for tenants, landlords, agents and property managers who need a property prepared for check-out, handover or the next occupier."
    inclusions={[
      'Kitchen cleaning including worktops, splashbacks, sinks, accessible cupboards and appliance exteriors',
      'Bathroom cleaning with attention to limescale-prone fittings, mirrors, tiles and sanitary areas',
      'Bedrooms, living rooms and hallways cleaned for dust, marks, touchpoints and presentation',
      'Vacuuming, mopping and floor-detailing based on the property surfaces',
      'Optional add-ons such as carpet cleaning, upholstery cleaning, balcony cleaning or internal window cleaning',
      'Access and timing arranged around check-out, inventory, landlord visit or handover windows',
    ]}
    audiences={[
      'Tenants preparing a home for check-out',
      'Landlords and homeowners getting a property ready for the next stage',
      'Estate and lettings agents arranging move-out or pre-let cleaning',
      'Property managers coordinating cleaning between occupancy, maintenance and handover',
    ]}
    process={[
      'We confirm the property size, layout, access, timing and any known condition issues.',
      'We agree the main cleaning scope and any practical add-ons before the quote is confirmed.',
      'The clean focuses on presentation-critical areas including kitchens, bathrooms, floors and touchpoints.',
      'Where a cleaning-related issue is raised after the visit, we handle it against the agreed scope.',
    ]}
    links={[
      { label: 'Home cleaning', href: '/home-cleaning/' },
      { label: 'Property and facilities cleaning', href: '/property-and-facilities-cleaning/' },
      { label: 'End of tenancy cleaning Wandsworth', href: '/services/end-of-tenancy-cleaning-wandsworth/' },
      { label: 'Void and post-tenancy cleaning', href: '/services/void-and-post-tenancy-cleaning/' },
      { label: 'Estate and lettings agents cleaning', href: '/services/estate-and-lettings-agents-cleaning/' },
      { label: 'Post-renovation cleaning', href: '/services/post-renovation-cleaning/' },
    ]}
    faqs={[
      {
        question: 'Can cleaning affect a tenancy deposit decision?',
        answer:
          'A detailed clean can help prepare the property for check-out, but deposit decisions sit with the landlord, agent, inventory process or deposit scheme. We avoid promising outcomes we do not control.',
      },
      {
        question: 'Do you clean ovens and appliances?',
        answer:
          'We can include appliance cleaning in the scope where access and condition allow. Tell us what needs attention when requesting the quote.',
      },
      {
        question: 'Can carpets be added?',
        answer:
          'Yes. Carpet cleaning can be scoped with the tenancy clean so the quote reflects the full handover requirement.',
      },
    ]}
  />
</Layout>
