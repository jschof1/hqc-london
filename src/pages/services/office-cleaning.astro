          text: "Enquire Now",
          url: "/contact/office-consultation?offer=b2b"
        }
      },
      objections: {
        headline: "FAQ: Office Cleaning",
        faqs: [
          {
            question: "Do you offer daily cleaning?",
            answer: "Yes, we offer daily, weekly, or bi-weekly schedules to suit your office needs."
