---
import ServiceTemplate from '../../components/ServiceTemplate.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const deepCleaningPage = {
    service: {
      hero: {
        headline: "Deep House Cleaning Service: London's Most Thorough Spring Clean",
        subheadline: "A complete reset for your home. We go beyond standard cleaning with our WellClean™ method – combining deep hygiene protocols with wellness-grade products. Perfect for spring cleaning, post-renovation, or just a fresh start.",
        badges: [
          "Complete Home Reset",
          "Wellness-Grade Products", 
          "Agreed Cleaning Scope",
          "Access Notes Confirmed"
        ],
        cta: {
          text: "Book Your Deep Clean",
          url: "/contact/deep-clean"
        }
      },
      trustbar: {
        logos: [],
        reviews: [
          {
            text: "The WellClean deep clean transformed my home. It feels physically lighter and the air quality has noticeably improved.",
            author: "Home deep-clean enquiry",
            rating: 5
          },
          {
            text: "Incredible attention to detail. They reached places I haven't seen in years. Truly a premium service.",
            author: "Chelsea home support",
            rating: 5
          },
          {
            text: "The home can be scoped for a deeper hygiene reset with a calmer, fresher finish.",
            author: "Hampstead home support",
            rating: 5
          }
        ]
      },
      painpoint: {
        headline: "Is Your Current 'Deep Clean' Actually Deep?",
        text: "Most cleaners wipe surfaces and vacuum. But true deep cleaning requires reaching the hidden dust, sanitizing neglected areas, and refreshing the entire atmosphere of your home. Standard cleaning often misses the details that matter most for hygiene and wellbeing.",
        painpoints: [
          {
            text: "Hidden dust and allergens remain in carpets, upholstery, and behind furniture"
          },
          {
            text: "Limescale and grime build up in bathrooms and kitchens despite regular cleaning"
          },
          {
            text: "Chemical odors from harsh products disrupt your home's peaceful atmosphere"
          },
          {
            text: "Standard cleaners lack the tools and training for a true top-to-bottom reset"
          },
          {
            text: "Inconsistent results leave you feeling like the job wasn't finished"
          },
          {
            text: "Stress of managing cleaners who don't understand your high standards"
          }
        ]
      },
      serviceExplanation: {
        headline: "The WellClean™ Deep Cleaning Method",
        steps: [
          {
            icon: "fas fa-search",
            title: "Comprehensive Home Assessment", 
            description: "We start with a walkthrough to identify high-traffic areas, specific concerns, and delicate surfaces requiring special care."
          },
          {
            icon: "fas fa-hands-bubbles",
            title: "Top-to-Bottom Hygiene Reset",
            description: "From ceiling corners to skirting boards, we clean every inch. This includes inside cupboards, behind appliances, and detailed light fixture cleaning."
          },
          {
            icon: "fas fa-wind",
            title: "Air Quality & Wellness Focus",
            description: "We use HEPA-filter vacuums and eco-wellness products to remove allergens and improve indoor air quality, leaving your home healthier."
          },
          {
            icon: "fas fa-pump-soap",
            title: "Sanitization of High-Touch Areas",
            description: "Door handles, switches, and remotes are cleaned with appropriate high-touch hygiene routines agreed for the property."
          },
          {
            icon: "fas fa-spray-can",
            title: "Fabric & Upholstery Refresh",
            description: "Gentle steaming and refreshing of sofas, curtains, and carpets to lift surface dust and revitalize fabrics."
          },
          {
            icon: "fas fa-check-double",
            title: "Final White-Glove Inspection",
            description: "We review the agreed scope before handover and note any practical follow-up points."
          }
        ]
      },
      benefits: {
        headline: "Why Choose Our Deep House Cleaning Service?",
        bullets: [
          "Experience a true 'spring clean' feeling any time of year",
          "Support a fresher-feeling home by reducing dust, build-up and high-touch grime",
          "Protect your family with eco-friendly, wellness-grade cleaning products",
          "Save days of hard work with our efficient, multi-person professional teams",
          "Enjoy a home that feels brand new, fresh, and revitalizing",
          "Extend the life of your carpets, furniture, and fixtures",
          "Perfect for pre-event preparation or post-party restoration",
          "Designed for London homes that need a detailed one-off reset",
          "Scope reviewed before handover so follow-up points are clear",
          "Access notes and property requirements agreed before work starts"
        ]
      },
      gallery: {
        headline: "Deep Cleaning Results You Can See & Feel",
        images: [
          {
            src: "/images/services/well-clean/well-clean-1.webp",
            alt: "Kitchen deep clean transformation",
            caption: "Restoring kitchens to showroom brilliance"
          },
          {
            src: "/images/services/well-clean/well-clean-2.webp", 
            alt: "Bathroom sanitization and limescale removal",
            caption: "Spa-like hygiene for your bathrooms"
          },
          {
            src: "/images/services/well-clean/well-clean-3.webp",
            alt: "Living area dust-free perfection",
            caption: "Dust-free living spaces that breathe"
          },
          {
            src: "/images/services/well-clean/well-clean-4.webp",
            alt: "Bedroom deep clean for better sleep",
            caption: "Sanitized bedrooms for a restful sleep environment"
          },
          {
            src: "/images/services/well-clean/well-clean-5.webp",
            alt: "Detailed corner and skirting board cleaning",
            caption: "We reach the corners others miss"
          },
          {
            src: "/images/services/well-clean/well-clean-6.webp",
            alt: "Eco-friendly product application",
            caption: "Wellness-grade products safe for your home"
          }
        ]
      },
      socialProof: {
        headline: "What Londoners Say About Our Deep Cleaning",
        reviews: [
          {
            text: "A deep-clean reset can help a home feel lighter, calmer and easier to use again.",
            author: "Belgravia home support"
          },
          {
            text: "Priority areas such as bathrooms, appliances and hard-to-reach dust can be agreed before the team arrives.",
            author: "Wandsworth home support"
          },
          {
            text: "WellClean is positioned for clients who want hygiene, calm and careful product choices, not just a surface wipe.",
            author: "WellClean enquiry"
          },
          {
            text: "Post-renovation cleans can be scoped around dust removal, surfaces, access and practical handover needs.",
            author: "Post-renovation support"
          }
        ],
        cta: {
          text: "Book Your Deep Clean Today",
          url: "/contact/deep-clean"
        }
      },
      offer: {
        headline: "Spring Clean Special Offer",
        details: "Send your postcode, property type and cleaning priorities so we can confirm the right deep-cleaning scope.",
        cta: {
          text: "Claim Your Offer",
          url: "/contact/deep-clean?offer=spring"
        }
      },
      objections: {
        headline: "Common Questions About Deep Cleaning",
        faqs: [
          {
            question: "How long does a deep clean take?",
            answer: "It depends on the size and condition of your property, but typically a team of 2-3 professionals will settle in for a full day (6-8 hours) to ensure every detail is addressed."
          },
          {
            question: "Do I need to be home?",
            answer: "Not necessarily. We can arrange key collection or entry via concierge. We can discuss key collection, concierge entry and access requirements before booking."
          },
          {
            question: "What is included in the deep clean?",
            answer: "Everything from inside kitchen cupboards (if emptied) and appliances, to descaling bathrooms, washing skirting boards, cleaning inside windows, and deep vacuuming all upholstery."
          },
          {
            question: "Do you bring your own equipment?",
            answer: "Yes, we bring all professional equipment and our specialized wellness-grade cleaning products. You don't need to provide anything."
          },
          {
            question: "Can you clean carpets and upholstery too?",
            answer: "Yes, we can add professional carpet and upholstery steam cleaning to your deep clean package for a complete soft furnishing restoration."
          },
          {
            question: "How is this different from a regular weekly clean?",
            answer: "A regular clean maintains cleanliness. A deep clean restores it. We tackle the build-up that regular cleaning misses – limescale, deep dust, grease, and hidden grime."
          }
        ]
      },
      finalCta: {
        headline: "Ready for a Fresh Start?",
        cta: {
          text: "Get Your Deep Clean Quote",
          url: "/contact/deep-clean"
        },
        subtext: "Experience the difference of a true professional deep clean. Your home deserves a WellClean reset."
      }
    }
  };
---

<Layout
  title="Deep Cleaning Service London | High Quality Clean"
  description="Wellness-grade deep cleaning for London homes: kitchens, bathrooms, ovens, behind appliances, skirtings and high-touch detail. Clear scopes, access planning and high-touch detail. Book a quote today."
>
  <Header />
  <ServiceTemplate service={deepCleaningPage.service} />
</Layout>
