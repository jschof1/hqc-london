---
import ServiceTemplate from '../../components/ServiceTemplate.astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const airbnbCleaningPage = {
  service: {
    hero: {
      headline: "Airbnb Cleaning Service London: 5-Star Turnovers",
      subheadline: "Professional Airbnb, short-let and holiday rental cleaning with agreed presentation standards, linen notes and turnover timing.",
      badges: [
        "Specialist Airbnb Cleaners",
        "Linen Rental Available",
        "Photo Reporting",
        "Inventory Checks"
      ],
      cta: {
        text: "Get A Host Quote",
        url: "/contact/airbnb-consultation"
      }
    },
    trustbar: {
      logos: [],
      reviews: [
        {
          text: "Guest-ready presentation can be scoped around each turnover.",
          author: "Short-let host",
          rating: 5
        },
        {
          text: "Checkout-window reliability can be planned around each property calendar.",
          author: "Turnover planning",
          rating: 5
        },
        {
          text: "Photo handovers are useful when a host or property contact is managing remotely.",
          author: "Remote-host support",
          rating: 5
        }
      ]
    },
    painpoint: {
      headline: "Guest Expectations are Higher Than Ever",
      text: "In the competitive London market, a single hair in the bathroom or a missed spot on the counter leads to a poor guest experience. You need a cleaning partner who understands hospitality standards, not just domestic cleaning.",
      painpoints: [
        {
          text: "Missed turnover windows causing check-in disasters"
        },
        {
          text: "Inconsistent standards affecting guest experience"
        },
        {
          text: "Lack of communication about damages or low supplies"
        },
        {
          text: "Staging not matching your listing photos"
        },
        {
          text: "Managing linen and laundry logistics"
        },
        {
          text: "No feedback on the property condition"
        }
      ]
    },
    serviceExplanation: {
      headline: "The Airbnb Turnover Process",
      steps: [
        {
          icon: "fas fa-clock",
          title: "Timely Arrival",
          description: "We arrive promptly after checkout to ensure the property is ready well before the next guest."
        },
        {
          icon: "fas fa-search-plus",
          title: "Damage & Theft Check",
          description: "We inspect for damages or missing items immediately and report to you/your platform."
        },
        {
          icon: "fas fa-bed",
          title: "Hotel-Style Bed Making",
          description: "Crisp hospital corners, perfectly fluffed pillows, and pristine presentation."
        },
        {
          icon: "fas fa-bath",
          title: "Spa Bathroom Reset",
          description: "Deep sanitization, lime-scale removal, and perfect towel arrangement."
        },
        {
          icon: "fas fa-camera",
          title: "Staging & Photos",
          description: "We arrange cushions and throws to match your photos, and send you confirmation images."
        },
        {
          icon: "fas fa-archive",
          title: "Restocking Essentials",
          description: "Replenishing toilet roll, toiletries, coffee, and other guest essentials."
        }
      ]
    },
    benefits: {
      headline: "Why Hosts Love Us",
      bullets: [
        "Reliability planned around checkout and check-in windows",
        "Linen and laundering notes can be discussed alongside the turnover",
        "Photo handover options available where agreed in scope",
        "Availability confirmed around the host calendar before scheduling",
        "Key management and safe access protocols",
        "Maintenance reporting (we spot the leak before the guest does)",
        "Short-let presentation standards planned around your listing and guest expectations",
        "Consistent presentation standards for your listing"
      ]
    },
    gallery: {
      headline: "Gallery: Guest-Ready Properties",
      images: [
        {
          src: "/images/services/airbnb/airbnb-1.webp",
          alt: "Staged bedroom",
          caption: "Inviting bedrooms"
        },
        {
          src: "/images/services/airbnb/airbnb-2.webp",
          alt: "Clean kitchen",
          caption: "Sparkling kitchens"
        },
        {
          src: "/images/services/airbnb/airbnb-3.webp",
          alt: "Sanitized bathroom",
          caption: "Immaculate bathrooms"
        },
        {
          src: "/images/services/airbnb/airbnb-4.webp",
          alt: "Living room setup",
          caption: "Photo-ready living areas"
        },
        {
          src: "/images/services/airbnb/airbnb-5.webp",
          alt: "Turnover context",
          caption: "Efficient turnover planning"
        },
        {
          src: "/images/services/airbnb/airbnb-6.webp",
          alt: "Guest-ready presentation",
          caption: "Perfect presentation"
        }
      ]
    },
    socialProof: {
      headline: "Host Success Stories",
      reviews: [
        {
          text: "Turnover cleaning can be planned around check-out, check-in and guest-ready presentation.",
          author: "Kensington host support"
        },
        {
          text: "For multi-property hosts, linen notes, access instructions and presentation standards can be documented before the rota starts.",
          author: "Portfolio support"
        }
      ],
      cta: {
        text: "Get A Quote",
        url: "/contact/airbnb-consultation"
      }
    },
    offer: {
      headline: "New Host Offer",
      details: "Sign up for regular turnovers and get your first clean at 50% off.",
      cta: {
        text: "Claim Offer",
        url: "/contact/airbnb-consultation?offer=host50"
      }
    },
    objections: {
      headline: "FAQ: Airbnb Cleaning",
      faqs: [
        {
          question: "Can you provide linen?",
          answer: "Yes, we offer a full linen rental and laundry service with hotel-quality sheets and towels."
        },
        {
          question: "Do you cover weekends and bank holidays?",
          answer: "Share your booking calendar requirements and we can confirm practical availability before scheduling."
        },
        {
          question: "How do you handle keys?",
          answer: "We can use key safes, collect from agents, or hold a set securely. We also work with smart locks."
        }
      ]
    },
    finalCta: {
      headline: "Turnovers With Laundry Notes Included",
      cta: {
        text: "Book Your First Clean",
        url: "/contact/airbnb-consultation"
      },
      subtext: "Ask about sheets, towels and pickup or delivery options through HQC Concierge Laundry."
    }
  }
};
---

<Layout
  title="Airbnb Cleaning & Turnover Service London | High Quality Clean"
  description="Airbnb and short-let turnover cleaning across London with agreed linen notes, reporting, inventory checks and practical scheduling."
>
  <Header />
  <ServiceTemplate service={airbnbCleaningPage.service} />
</Layout>
