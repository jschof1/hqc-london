    socialProof: {
      headline: "Host Success Stories",
      reviews: [
        {
          text: "Turnover cleaning can be planned around check-out, check-in and guest-ready presentation.",
          author: "James, Kensington"
        },
        {
          text: "They manage my entire portfolio of 5 flats. Professional, fast, and great quality.",
          author: "Victoria, Property Investor"
        }
      ],
      cta: {
        text: "Get A Quote",
        url: "/contact/airbnb-consultation"
      }
    },
    offer: {
      headline: "New Host Offer",
      details: "Sign up for regular turnovers and get your first clean at 50% off.",
      cta: {
        text: "Claim Offer",
        url: "/contact/airbnb-consultation?offer=host50"
      }
    },
    objections: {
      headline: "FAQ: Airbnb Cleaning",
      faqs: [
        {
          question: "Can you provide linen?",
          answer: "Yes, we offer a full linen rental and laundry service with hotel-quality sheets and towels."
        },
        {
          question: "Do you cover weekends and bank holidays?",
          answer: "Share your booking calendar requirements and we can confirm practical availability before scheduling."
        },
        {
          question: "How do you handle keys?",
          answer: "We can use key safes, collect from agents, or hold a set securely. We also work with smart locks."
        }
      ]
    },
    finalCta: {
      headline: "Automate Your Cleaning",
      cta: {
        text: "Book Your First Clean",
        url: "/contact/airbnb-consultation"
      },
      subtext: "Focus on your guests, we'll handle the rest."
    }
