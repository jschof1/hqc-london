---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout 
  title="Contact High Quality Clean | London"
  description="Contact High Quality Clean for existing bookings, general enquiries, supplier matters or administrative support. New cleaning enquiries can use our quotation route."
  pageType="ContactPage"
>
  <Header />
  
  <main class="page-transition pt-16">
    <!-- Hero Section -->
    <HeroSection 
      title="Contact High Quality Clean"
      subtitle="For new cleaning requirements, tell us about the property, site and result required through the quotation form. For existing-client, supplier or general administrative matters, contact HQC here."
      imageSrc="/images/generated/hqc-restoration-interior.png"
      imageAlt="Illustrative London interior prepared with careful attention to detail"
      primaryCta={{
        text: "Contact HQC",
        href: "#contact-methods"
      }}
      secondaryCta={{
        text: "Request a Cleaning Quote",
        href: "/request-a-quote/"
      }}
      trustBadges={[
        { icon: "fas fa-list-check", text: "Clear scope" },
        { icon: "fas fa-calculator", text: "Labour-based quotations" },
        { icon: "fas fa-hand-sparkles", text: "Careful delivery" }
      ]}
      backgroundClass="bg-navy relative overflow-hidden"
    />
    <section class="bg-white py-14 md:py-18" aria-labelledby="new-cleaning-enquiry-title">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-gold">New cleaning enquiry</p>
          <h2 id="new-cleaning-enquiry-title" class="mt-3 font-serif text-3xl font-semibold text-navy md:text-4xl">Tell us what the property or site needs</h2>
          <p class="mt-4 leading-7 text-ink/70">For home, property, office, commercial, post-construction, portfolio or complex-property work, use the central quotation route so HQC can identify the correct service.</p>
        </div>
        <a href="/request-a-quote/" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-full bg-navy px-7 py-4 font-semibold text-white transition hover:bg-gold hover:text-navy">Request a Cleaning Quote <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- Contact Information Cards -->
    <section id="contact-methods" class="scroll-mt-24 py-20 md:py-28 bg-mist" aria-labelledby="contact-methods-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 id="contact-methods-title" class="font-serif text-3xl md:text-4xl text-navy font-semibold mb-4">
            Contact HQC
          </h2>
          <p class="text-ink/70 text-lg max-w-2xl mx-auto">
            Use these contact details for existing bookings, general enquiries, supplier matters or administrative support.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
          <!-- Phone Card -->
          <div class="bg-white rounded-xl border border-gold/30 p-6 shadow-soft-sm hover:shadow-soft transition-all duration-300 hover:-translate-y-1">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-gold/10 mb-4">
              <i class="fas fa-phone text-gold text-xl"></i>
            </div>
            <h3 class="font-semibold text-navy mb-2">Phone</h3>
            <p class="text-sm text-ink/70 mb-4">Call us directly</p>
            <a 
              href="tel:+442088703925" 
              class="text-gold hover:text-navy transition-colors font-medium"
            >
              0208 8703925
            </a>
          </div>

          <!-- Email Card -->
          <div class="bg-white rounded-xl border border-gold/30 p-6 shadow-soft-sm hover:shadow-soft transition-all duration-300 hover:-translate-y-1">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-gold/10 mb-4">
              <i class="fas fa-envelope text-gold text-xl"></i>
            </div>
            <h3 class="font-semibold text-navy mb-2">Email</h3>
            <p class="text-sm text-ink/70 mb-4">Send us a message</p>
            <a 
              href="mailto:sales@highqualityclean.co.uk" 
              class="text-gold hover:text-navy transition-colors font-medium break-all"
            >
              sales@highqualityclean.co.uk
            </a>
          </div>

          <!-- WhatsApp Card -->
          <div class="bg-white rounded-xl border border-gold/30 p-6 shadow-soft-sm hover:shadow-soft transition-all duration-300 hover:-translate-y-1">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-gold/10 mb-4">
              <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.787"/>
              </svg>
            </div>
            <h3 class="font-semibold text-navy mb-2">WhatsApp</h3>
            <p class="text-sm text-ink/70 mb-4">Chat with us</p>
            <a 
              href="https://wa.me/442088703925" 
              target="_blank"
              rel="noopener nofollow"
              class="text-gold hover:text-navy transition-colors font-medium"
            >
              Start a conversation
            </a>
          </div>

          <!-- Address Card -->
          <div class="bg-white rounded-xl border border-gold/30 p-6 shadow-soft-sm hover:shadow-soft transition-all duration-300 hover:-translate-y-1">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-gold/10 mb-4">
              <i class="fas fa-map-marker-alt text-gold text-xl"></i>
            </div>
            <h3 class="font-semibold text-navy mb-2">Location</h3>
            <p class="text-sm text-ink/70 mb-4">Service area</p>
            <p class="text-gold font-medium">
              London, SW1<br />
              Greater London
            </p>
          </div>
        </div>

        <!-- Social Media Links -->
        <div class="text-center">
          <p class="text-ink/70 mb-4">Follow us on social media</p>
          <div class="flex items-center justify-center gap-4">
            <a 
              href="https://www.instagram.com/highqualitycleanltd" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-12 h-12 rounded-full bg-white border border-gold/30 flex items-center justify-center text-ink/60 hover:text-gold hover:border-gold transition-all duration-300 hover:-translate-y-1"
              aria-label="Instagram"
            >
              <i class="fab fa-instagram text-xl"></i>
            </a>
            <a 
              href="https://www.linkedin.com/company/high-quality-cleaning/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-12 h-12 rounded-full bg-white border border-gold/30 flex items-center justify-center text-ink/60 hover:text-gold hover:border-gold transition-all duration-300 hover:-translate-y-1"
              aria-label="LinkedIn"
            >
              <i class="fab fa-linkedin text-xl"></i>
            </a>
            <a 
              href="https://tiktok.com/@highqualityclean" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-12 h-12 rounded-full bg-white border border-gold/30 flex items-center justify-center text-ink/60 hover:text-gold hover:border-gold transition-all duration-300 hover:-translate-y-1"
              aria-label="TikTok"
            >
              <i class="fab fa-tiktok text-xl"></i>
            </a>
            <a 
              href="https://www.facebook.com/highqualityclean" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-12 h-12 rounded-full bg-white border border-gold/30 flex items-center justify-center text-ink/60 hover:text-gold hover:border-gold transition-all duration-300 hover:-translate-y-1"
              aria-label="Facebook"
            >
              <i class="fab fa-facebook text-xl"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-20" aria-label="Other contact routes">
      <div class="mx-auto grid max-w-7xl gap-5 px-4 sm:px-6 md:grid-cols-3 lg:px-8">
        <article class="rounded-2xl border border-gold/25 bg-mist p-6">
          <h2 class="font-serif text-2xl font-semibold text-navy">Existing clients</h2>
          <p class="mt-3 leading-7 text-ink/70">For a booking, access update, invoice query, service question, recurring arrangement, feedback or administrative support, include the relevant name, property address and booking date or reference where available.</p>
        </article>
        <article class="rounded-2xl border border-gold/25 bg-mist p-6">
          <h2 class="font-serif text-2xl font-semibold text-navy">Suppliers and subcontractors</h2>
          <p class="mt-3 leading-7 text-ink/70">Please mark supplier or subcontractor enquiries clearly. Recruitment, supplier introductions, subcontractor administration, product sales and general business proposals are not cleaning quotation requests.</p>
        </article>
        <article class="rounded-2xl border border-gold/25 bg-mist p-6">
          <h2 class="font-serif text-2xl font-semibold text-navy">Media and partnerships</h2>
          <p class="mt-3 leading-7 text-ink/70">Include who you are, your organisation, the purpose of your enquiry, relevant website or information and your preferred contact details.</p>
        </article>
      </div>
    </section>

    <section class="bg-navy py-12 text-white" aria-labelledby="assessment-media-title">
      <div class="mx-auto grid max-w-7xl gap-5 px-4 sm:px-6 md:grid-cols-[1fr_auto] md:items-center lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-gold">Assessment media</p>
          <h2 id="assessment-media-title" class="mt-2 font-serif text-2xl font-semibold">Use WhatsApp only when HQC has requested photos or video</h2>
          <p class="mt-3 max-w-3xl leading-7 text-white/75">Do not send sensitive documents unless HQC has specifically requested them through an appropriate route.</p>
        </div>
        <a href="https://wa.me/447824390336" target="_blank" rel="noopener nofollow" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 px-6 py-3 font-semibold text-white transition hover:border-gold hover:text-gold">WhatsApp 07824 390336 <span class="ml-2" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section class="py-20 md:py-28 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-3xl md:text-4xl text-navy font-semibold mb-4">
            General and administrative enquiry
          </h2>
          <p class="text-ink/70 text-lg">
            Use this contact form for existing-client, supplier or general administrative matters. For new cleaning work, use the quotation route.
          </p>
        </div>

        <form
          id="contact-form"
          class="bg-mist rounded-2xl p-8 md:p-10 border border-gold/50 shadow-soft transition-all duration-300"
        >
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Full Name *</span>
              <input
                type="text"
                name="name"
                required
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="Your full name"
              />
            </label>
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Email Address *</span>
              <input
                type="email"
                name="email"
                required
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="your.email@example.com"
              />
            </label>
          </div>
          
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Phone Number</span>
              <input
                type="tel"
                name="phone"
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="0208 8703925"
              />
            </label>
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Postcode</span>
              <input
                type="text"
                name="postcode"
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="SW1, W8, etc."
              />
            </label>
          </div>

          <label class="block mb-6">
            <span class="block mb-2 text-navy font-medium">How can we help? *</span>
            <select
              name="service"
              required
              class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
            >
              <option value="">Select a topic...</option>
              <option value="general-inquiry">General Inquiry</option>
              <option value="existing-client">Existing Client Support</option>
              <option value="supplier">Supplier or Subcontractor Enquiry</option>
              <option value="partnership">Media or Partnership Enquiry</option>
              <option value="administrative">Administrative Support</option>
              <option value="other">Other</option>
            </select>
          </label>
          
          <label class="block mb-8">
            <span class="block mb-2 text-navy font-medium">Message *</span>
            <textarea
              name="message"
              rows="6"
              required
              class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors resize-none"
              placeholder="Tell us about your cleaning needs, questions, or how we can assist you..."
            ></textarea>
          </label>
          
          <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:justify-between">
            <label class="inline-flex items-start gap-3 text-sm text-navy/80 max-w-md">
              <input type="checkbox" name="privacy_consent" value="yes" required class="mt-1 accent-gold scale-110" />
              <span>I agree to be contacted by High Quality Clean regarding my inquiry.</span>
            </label>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-md bg-gold text-navy px-8 py-4 font-semibold border border-gold hover:bg-gold/90 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-105 min-h-[48px]"
            >
              <i class="fas fa-paper-plane mr-2"></i>
              Send Message
            </button>
          </div>
        </form>

        <div id="contact-preview-status" class="mt-5 hidden rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950" role="status" aria-live="polite">
          This preview does not send contact forms. Your message was not sent. Use the contact details above to reach HQC.
        </div>

        <div id="contact-success" class="hidden bg-mist rounded-2xl p-12 text-center border border-gold/50 shadow-soft animate-fade-in">
          <div class="w-20 h-20 bg-gold/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-check text-gold text-4xl"></i>
          </div>
          <h3 class="font-serif text-3xl font-bold text-navy mb-4">Message Sent</h3>
          <p class="text-ink/70 text-lg mb-8">
            Thank you for reaching out. We've received your message and our team will get back to you as soon as possible.
          </p>
          <button 
            onclick="window.location.reload()" 
            class="text-gold hover:text-navy transition-colors font-semibold"
          >
            Send another message
          </button>
        </div>

        <script>
          const form = document.getElementById('contact-form');
          const successMessage = document.getElementById('contact-success');
          const submitBtn = form?.querySelector('button[type="submit"]');
          const originalBtnText = submitBtn?.innerHTML;

          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Sending...';
            }

            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            
            data.source = 'contact_page';
            data.timestamp = new Date().toISOString();

            try {
              const response = await fetch('/api/quick-form/', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(data),
              });

              const result = await response.json().catch(() => null);
              if (!response.ok) throw new Error('Submission failed');

              if (result?.preview === true) {
                document.getElementById('contact-preview-status')?.classList.remove('hidden');
                document.getElementById('contact-preview-status')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = originalBtnText;
                }
                return;
              }

              form.style.display = 'none';
              successMessage.classList.remove('hidden');
              successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (error) {
              console.error('Error submitting form:', error);
              alert('Something went wrong. Please try again or call us directly at 0208 8703925.');
              
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
              }
            }
          });
        </script>
      </div>
    </section>

    <section class="bg-mist py-16 md:py-20" aria-labelledby="contact-quote-title">
      <div class="mx-auto grid max-w-7xl gap-8 rounded-3xl bg-navy px-6 py-10 text-white sm:px-10 md:grid-cols-[1fr_auto] md:items-center md:py-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-gold">Need a cleaning quote?</p>
          <h2 id="contact-quote-title" class="mt-3 font-serif text-3xl font-semibold md:text-4xl">Choose the route that matches your enquiry</h2>
          <p class="mt-4 max-w-2xl leading-7 text-white/75">For postcode questions, check the areas HQC covers. For new cleaning work, send the property, site and service details through the quotation form.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
          <a href="#contact-methods" class="inline-flex min-h-12 items-center justify-center rounded-full bg-gold px-6 py-3 font-semibold text-navy transition hover:bg-white">Contact HQC</a>
          <a href="/request-a-quote/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 px-6 py-3 font-semibold text-white transition hover:border-gold hover:text-gold">Request a Cleaning Quote</a>
          <a href="/areas-we-cover/" class="inline-flex min-h-11 items-center justify-center px-5 py-2 text-sm font-semibold text-white/75 underline decoration-gold underline-offset-4 hover:text-gold">Check Areas We Cover</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
