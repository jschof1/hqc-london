---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MotionKit from '../components/MotionKit.astro';
import { cardImage, cardLibrary, contactCardImagery } from '../data/card-imagery';
import '../styles/enquiry-pages.css';

// Image-led round (10 Nov 2026): one library image per information card.
const contactImage = (heading: string) => cardImage(contactCardImagery[heading])!;
// Site-wide design (11 Nov 2026): decorative library photographs beside the form and behind the
// closing band. They repeat nothing written on the page, so they carry empty alt text.
const formPhoto = cardLibrary['g-phone-desk'];
const closingPhoto = cardLibrary['p-mansion-blocks'];
// Lucide icons (ISC licence), inlined so no icon package is added.
const needIcons = [
  '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
  '<path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"/><path d="m18 15 4-4"/><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"/>',
  '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  '<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 12 1.5 1.5L13 11"/><path d="M15 12h1"/><path d="m9 17 1.5 1.5L13 16"/><path d="M15 17h1"/>'
];
const methodIcons = {
  phone: '<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>'
};
---

<Layout
  title="Contact High Quality Clean | London"
  description="Contact High Quality Clean for existing bookings, general enquiries, supplier matters or administrative support. New cleaning enquiries can use our quotation route."
  pageType="ContactPage"
>
  <Header />
  <MotionKit />

  <main class="hm-page eq-page page-transition bg-porcelain pt-20">
    {/* Hero: midnight copy beside the photograph; paints at once, no reveal. */}
    <section class="eq-hero">
      <div class="eq-hero-copy">
        <h1 class="eq-hero-h1 font-serif font-medium">Contact High Quality Clean</h1>
        <p class="eq-hero-lead">For new cleaning requirements, the fastest route is usually to tell us about the property, site and result required through the quotation form. For existing-client, supplier or general administrative matters, contact HQC here.</p>
        <div class="eq-hero-actions">
          <a href="#contact-methods" class="button button-primary">Contact HQC</a>
          <a href="/request-a-quote/" class="button button-ghost">Request a Quote</a>
        </div>
        <div class="hm-trust-row eq-trust"><span>Clear scope</span><span>Labour-based quotations</span><span>Careful delivery</span></div>
      </div>
      <figure class="eq-hero-media">
        <img src="/images/generated/hqc-restoration-interior.png" alt="Period living room with a bay window and a fireplace." width="1536" height="1024" fetchpriority="high" loading="eager" decoding="async" />
      </figure>
    </section>

    {/* New cleaning enquiry: heading beside an icon grid of what to quote for, then the route. */}
    <section class="eq-section bg-porcelain" aria-labelledby="new-cleaning-enquiry-title">
      <div class="eq-shell">
        <div class="eq-needs">
          <div class="eq-needs-head">
            <h2 id="new-cleaning-enquiry-title" class="section-title" data-reveal="title">New Cleaning Enquiry</h2>
            <p class="hm-label mt-6" data-reveal>If you need:</p>
          </div>
          <ul class="hm-considers eq-considers" data-stagger="50" data-stagger-type="fade">
            {['home cleaning;', 'property cleaning;', 'office or commercial cleaning;', 'post-construction work;', 'portfolio support;', 'complex-property assessment;'].map((item, index) => (
              <li><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={needIcons[index]} /><span>{item}</span></li>
            ))}
          </ul>
        </div>
        <div class="hm-outcome-foot">
          <p class="eq-foot-text" data-reveal>use the central Request a Quote route so we receive the information needed to identify the correct service.</p>
          <a href="/request-a-quote/" class="hm-cta-link hm-cta-dark shrink-0" data-reveal>Request a Cleaning Quote <span class="hm-cta-chip" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    {/* Contact details: three dark cards on midnight, social links beneath. */}
    <section id="contact-methods" class="eq-section eq-dark hm-dark scroll-mt-24" aria-labelledby="contact-methods-title">
      <div class="eq-shell">
        <div class="eq-head eq-head-center">
          <h2 id="contact-methods-title" class="section-title mx-auto text-white" data-reveal="title">
            Contact HQC
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75" data-reveal>
            Use these contact details for existing bookings, general enquiries, supplier matters or administrative support.
          </p>
        </div>

        <div class="eq-methods" data-stagger="80">
          <div class="eq-method">
            <span class="eq-method-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={methodIcons.phone} /></span>
            <h3 class="eq-method-title">Phone</h3>
            <p class="eq-method-note">Call us directly</p>
            <a
              href="tel:+442088703925"
              class="hm-cta-link eq-method-cta"
            >
              0208 8703925
            <span class="hm-cta-chip eq-chip" aria-hidden="true"></span></a>
          </div>

          <div class="eq-method">
            <span class="eq-method-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={methodIcons.mail} /></span>
            <h3 class="eq-method-title">Email</h3>
            <p class="eq-method-note">Send us a message</p>
            <a
              href="mailto:sales@highqualityclean.co.uk"
              class="hm-cta-link eq-method-cta eq-break"
            >
              sales@highqualityclean.co.uk
            <span class="hm-cta-chip eq-chip" aria-hidden="true"></span></a>
          </div>

          <div class="eq-method">
            <span class="eq-method-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={methodIcons.pin} /></span>
            <h3 class="eq-method-title">Location</h3>
            <p class="eq-method-note">Service area</p>
            <p class="eq-method-value">
              London, SW1<br />
              Greater London
            </p>
          </div>
        </div>

        <div class="eq-social" data-reveal>
          <p>Follow us on social media</p>
          <div class="eq-social-links">
            <a
              href="https://www.instagram.com/highqualitycleanltd"
              target="_blank"
              rel="noopener noreferrer"
              class="eq-social-link"
              aria-label="Instagram"
            >
              <i class="fab fa-instagram text-xl"></i>
            </a>
            <a
              href="https://www.linkedin.com/company/high-quality-cleaning/"
              target="_blank"
              rel="noopener noreferrer"
              class="eq-social-link"
              aria-label="LinkedIn"
            >
              <i class="fab fa-linkedin text-xl"></i>
            </a>
            <a
              href="https://tiktok.com/@highqualityclean"
              target="_blank"
              rel="noopener noreferrer"
              class="eq-social-link"
              aria-label="TikTok"
            >
              <i class="fab fa-tiktok text-xl"></i>
            </a>
            <a
              href="https://www.facebook.com/highqualityclean"
              target="_blank"
              rel="noopener noreferrer"
              class="eq-social-link"
              aria-label="Facebook"
            >
              <i class="fab fa-facebook text-xl"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Other contact routes: three photo cards on white. */}
    <section class="eq-section bg-white" aria-label="Other contact routes">
      <div class="eq-shell eq-info-cards" data-stagger="90">
        <article class="eq-info-card">
          <span class="eq-info-media"><img src={contactImage('Existing Clients').src} alt={contactImage('Existing Clients').alt} loading="lazy" decoding="async" width="1200" height="900" /></span>
          <div class="eq-info-body">
            <h2 class="eq-card-title">Existing Clients</h2>
            <p>Use the contact route for matters such as:</p>
            <ul class="eq-ticks eq-ticks-light">
              <li><span>an existing booking;</span></li>
              <li><span>access update;</span></li>
              <li><span>invoice query;</span></li>
              <li><span>service question;</span></li>
              <li><span>existing recurring arrangement;</span></li>
              <li><span>feedback;</span></li>
              <li><span>administrative support.</span></li>
            </ul>
            <p>Where a matter relates to a booking, include the relevant name, property address and booking date or reference where available.</p>
          </div>
        </article>
        <article class="eq-info-card">
          <span class="eq-info-media"><img src={contactImage('Suppliers and Subcontractors').src} alt={contactImage('Suppliers and Subcontractors').alt} loading="lazy" decoding="async" width="1200" height="900" /></span>
          <div class="eq-info-body">
            <h2 class="eq-card-title">Suppliers and Subcontractors</h2>
            <p>Supplier or subcontractor enquiries should be clearly marked as such.</p>
            <p>Please do not use the customer quotation route for:</p>
            <ul class="eq-ticks eq-ticks-light">
              <li><span>recruitment;</span></li>
              <li><span>supplier introductions;</span></li>
              <li><span>subcontractor administration;</span></li>
              <li><span>product sales;</span></li>
              <li><span>general business proposals.</span></li>
            </ul>
          </div>
        </article>
        <article class="eq-info-card">
          <span class="eq-info-media"><img src={contactImage('Media, Partnerships and Other Enquiries').src} alt={contactImage('Media, Partnerships and Other Enquiries').alt} loading="lazy" decoding="async" width="1200" height="900" /></span>
          <div class="eq-info-body">
            <h2 class="eq-card-title">Media, Partnerships and Other Enquiries</h2>
            <p>For legitimate business, media or partnership enquiries, provide enough information for HQC to understand who you are, your organisation, purpose of contact, relevant website or information and preferred contact details.</p>
          </div>
        </article>
      </div>
    </section>

    {/* Assessment media: full-bleed photograph, dark panel on the left. */}
    <section class="hm-stage eq-stage-left" aria-labelledby="assessment-media-title">
      <div class="hm-stage-media hm-parallax">
        <img src={contactImage('Assessment Media').src} alt={contactImage('Assessment Media').alt} loading="lazy" decoding="async" width="1200" height="900" />
      </div>
      <div class="hm-stage-panel eq-panel-dark hm-dark" data-reveal>
        <h2 id="assessment-media-title" class="section-title text-white" data-reveal="title">Assessment Media</h2>
        <p class="mt-6 text-lg leading-8 text-white/80" data-reveal>Where HQC has specifically requested photos or video to assess a cleaning requirement, these may be sent using the approved assessment channel:</p>
        <p class="eq-whatsapp mt-4" data-reveal>WhatsApp: 07824 390336</p>
        <p class="mt-4 leading-7 text-white/70" data-reveal>Do not send sensitive documents unless HQC has specifically requested them through an appropriate route.</p>
        <a href="https://wa.me/447824390336" target="_blank" rel="noopener nofollow" class="hm-cta-link mt-8" data-reveal>WhatsApp 07824 390336 <span class="hm-cta-chip" aria-hidden="true">↗</span></a>
      </div>
    </section>

    {/* Service area and quotation: two photo cards with a flat tint. */}
    <section class="eq-section bg-white" aria-label="Service area and quotation routes">
      <div class="eq-shell eq-photo-cards" data-stagger="100">
        <article class="eq-photo-card hm-dark">
          <img class="eq-photo-card-bg" src={contactImage('Service Area Questions').src} alt={contactImage('Service Area Questions').alt} loading="lazy" decoding="async" width="1200" height="900" />
          <div class="eq-photo-card-body">
            <h2 class="eq-card-title">Service Area Questions</h2>
            <p>If you want to know whether HQC covers your postcode:</p>
            <div class="eq-actions"><a href="/areas-we-cover/" class="hm-cta-link">Check Areas We Cover <span class="hm-cta-chip" aria-hidden="true">→</span></a></div>
          </div>
        </article>
        <article class="eq-photo-card hm-dark">
          <img class="eq-photo-card-bg" src={contactImage('Need a Cleaning Quote Rather Than General Support?').src} alt={contactImage('Need a Cleaning Quote Rather Than General Support?').alt} loading="lazy" decoding="async" width="1200" height="900" />
          <div class="eq-photo-card-body">
            <h2 class="eq-card-title">Need a Cleaning Quote Rather Than General Support?</h2>
            <p>Use the quotation route so we can direct the enquiry correctly.</p>
            <div class="eq-actions">
              <a href="/request-a-quote/" class="hm-cta-link">Request a Cleaning Quote <span class="hm-cta-chip" aria-hidden="true">→</span></a>
              <a href="#contact-methods" class="hm-cta-link hm-cta-secondary">Contact HQC <span class="hm-cta-chip" aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
      </div>
    </section>

    {/* Form: heading and a photograph beside the form in a white panel. No reveal on the form. */}
    <section class="eq-section bg-porcelain eq-rule">
      <div class="eq-shell eq-form-layout">
        <div class="eq-form-intro">
          <div class="eq-sticky">
          <h2 class="section-title" data-reveal="title">
            General and administrative enquiry
          </h2>
          <p class="mt-6 text-lg leading-8 text-slate" data-reveal>
            Use this contact form for existing-client, supplier or general administrative matters. For new cleaning work, use the quotation route.
          </p>
          <figure class="eq-form-photo">
            <img src={formPhoto.src} alt="" loading="lazy" decoding="async" width="1200" height="900" />
          </figure>
          </div>
        </div>
        <div class="eq-form-col">
        <form
          id="contact-form"
          class="eq-form-panel"
        >
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Full Name *</span>
              <input
                type="text"
                name="name"
                required
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="Your full name"
              />
            </label>
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Email Address *</span>
              <input
                type="email"
                name="email"
                required
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="your.email@example.com"
              />
            </label>
          </div>
          
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Phone Number</span>
              <input
                type="tel"
                name="phone"
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="0208 8703925"
              />
            </label>
            <label class="block">
              <span class="block mb-2 text-navy font-medium">Postcode</span>
              <input
                type="text"
                name="postcode"
                class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
                placeholder="SW1, W8, etc."
              />
            </label>
          </div>

          <label class="block mb-6">
            <span class="block mb-2 text-navy font-medium">How can we help? *</span>
            <select
              name="service"
              required
              class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy focus:border-gold focus:ring-gold focus:ring-1 transition-colors"
            >
              <option value="">Select a topic...</option>
              <option value="general-inquiry">General Inquiry</option>
              <option value="existing-client">Existing Client Support</option>
              <option value="supplier">Supplier or Subcontractor Enquiry</option>
              <option value="partnership">Media or Partnership Enquiry</option>
              <option value="administrative">Administrative Support</option>
              <option value="other">Other</option>
            </select>
          </label>
          
          <label class="block mb-8">
            <span class="block mb-2 text-navy font-medium">Message *</span>
            <textarea
              name="message"
              rows="6"
              required
              class="w-full rounded-lg px-4 py-3 bg-white border border-gold/30 text-navy placeholder:text-navy/40 focus:border-gold focus:ring-gold focus:ring-1 transition-colors resize-none"
              placeholder="Tell us about your cleaning needs, questions, or how we can assist you..."
            ></textarea>
          </label>
          
          <p class="mb-4 text-sm text-navy/80">By submitting this form, you acknowledge that High Quality Clean Ltd will use the information you provide to respond to and manage your enquiry. See our <a href="/privacy-policy/" class="underline">Privacy Policy</a>.</p>
          <label class="mb-6 flex items-start gap-3 text-sm text-navy/80">
            <input type="checkbox" name="email_marketing_consent" value="yes" class="mt-1 accent-gold" />
            <span>I would like to receive occasional HQC offers and service updates by email. I can unsubscribe at any time.</span>
          </label>
          <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:justify-between">
            <button
              type="submit"
              class="eq-submit"
            >
              <i class="fas fa-paper-plane mr-2" aria-hidden="true"></i>
              Send Message
            </button>
          </div>
        </form>

        <p id="contact-error" class="scroll-mt-32 mt-5 hidden rounded-lg bg-red-50 p-4 text-red-900" role="alert" tabindex="-1"></p>

        <div id="contact-preview-status" class="mt-5 hidden rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950" role="status" aria-live="polite">
          This preview does not send contact forms. Your message was not sent. Use the contact details above to reach HQC.
        </div>

        <div id="contact-success" class="hidden bg-mist rounded-2xl p-12 text-center border border-gold/50 shadow-soft animate-fade-in">
          <div class="w-20 h-20 bg-gold/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-check text-gold text-4xl"></i>
          </div>
          <h3 class="font-serif text-3xl font-bold text-navy mb-4">Message Sent</h3>
          <p class="text-ink/70 text-lg mb-8">
            Thank you for reaching out. We've received your message and our team will get back to you as soon as possible.
          </p>
          <button 
            onclick="window.location.reload()" 
            class="text-copper-ink hover:text-navy transition-colors font-semibold"
          >
            Send another message
          </button>
        </div>

        <script>
          const form = document.getElementById('contact-form');
          const successMessage = document.getElementById('contact-success');
          const submitBtn = form?.querySelector('button[type="submit"]');
          const originalBtnText = submitBtn?.innerHTML;

          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn?.disabled) return;
            document.getElementById('contact-error')?.classList.add('hidden');
            document.getElementById('contact-preview-status')?.classList.add('hidden');
            
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Sending...';
            }

            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            
            data.source = 'contact_page';
            data.timestamp = new Date().toISOString();

            try {
              window.dispatchEvent(new CustomEvent('hqc:form-stage', { detail: { id: 'contact-form', stage: 'attempted' } }));
              const response = await fetch('/api/contact/', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(data),
              });

              const result = await response.json().catch(() => null);
              if (!response.ok) throw new Error('Submission failed');

              if (result?.preview === true) {
                window.dispatchEvent(new CustomEvent('hqc:form-stage', { detail: { id: 'contact-form', stage: 'preview' } }));
                document.getElementById('contact-preview-status')?.classList.remove('hidden');
                document.getElementById('contact-preview-status')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = originalBtnText;
                }
                return;
              }

              if (result?.ok !== true) throw new Error('Receipt not confirmed');
              window.dispatchEvent(new CustomEvent('hqc:form-stage', { detail: { id: 'contact-form', stage: 'receipt' } }));
              form.style.display = 'none';
              successMessage.classList.remove('hidden');
              successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (error) {
              window.dispatchEvent(new CustomEvent('hqc:form-stage', { detail: { id: 'contact-form', stage: 'error' } }));
              console.error('Error submitting form:', error);
              const errorMessage = document.getElementById('contact-error');
              if (errorMessage) {
                errorMessage.textContent = 'We could not confirm receipt. Your message is still here. Please call 0208 870 3925 before submitting again.';
                errorMessage.classList.remove('hidden');
                errorMessage.focus();
              }
              
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
              }
            }
          });
        </script>
        </div>
      </div>
    </section>

    {/* Closing: London street under a flat tint, words left, three routes right. */}
    <section class="hm-closing hm-parallax eq-closing relative isolate overflow-hidden text-white hm-dark" aria-labelledby="contact-quote-title">
      <img class="hm-closing-bg" src={closingPhoto.src} alt="" loading="lazy" decoding="async" width="1200" height="900" />
      <div class="eq-shell eq-closing-grid">
        <div class="eq-closing-copy">
          <p class="section-kicker" data-reveal="fade">Need a cleaning quote?</p>
