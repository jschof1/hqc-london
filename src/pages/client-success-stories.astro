---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const stories = [
  {
    title: 'Mr. Edwards, from disappointment to dependability',
    image: '/images/instock/IMG-20250812-WA0015.jpg',
    tag: 'Home cleaning trust',
    quote: "It wasn't just the clean. It was how you handled the whole situation that made me trust you.",
    body: [
      "Mr. Edwards came to HQC after previous cleaning companies had missed details and failed to treat his home with respect.",
      "HQC began with a full top-to-bottom clean, protected surfaces, detailed the kitchen and bathrooms, and handled an early issue openly. The result was not just a cleaner property, but a client relationship built on trust and referrals."
    ]
  },
  {
    title: 'Mrs. Dean, a home restored before the first brick was laid',
    image: '/images/instock/IMG-20250813-WA0030.jpg',
    tag: 'Chelsea property support',
    quote: 'Please do what you can.',
    body: [
      "Mrs. Dean was away from London and needed her Chelsea flat cleaned before renovation works began. A video inspection showed the property needed more care than expected.",
      "HQC cleaned top to bottom, removed rubbish, restored order and sent a follow-up video walkthrough. That first experience led to post-build cleaning, maintenance cleans, window cleaning, laundry coordination and practical support with a second property."
    ]
  },
  {
    title: "Neylan's experience, from skepticism to satisfaction",
    image: '/images/before-after/after.jpg',
    tag: 'Recommendation-led clean',
    quote: "Pedro's care and attention to detail exceeded my expectations.",
    body: [
      "Neylan came through a recommendation but had been disappointed by professional cleaners before.",
      "HQC listened, stayed realistic and delivered with quiet consistency. What stood out was the combination of top-tier cleaning and thoughtful, responsive service."
    ]
  },
  {
    title: "Myreete's story, from doubt to repeat bookings",
    image: '/images/before-after/before-after-1.jpg',
    tag: 'Deep reset',
    quote: 'They cleaned the heck out of my house. They were AWESOME!',
    body: [
      "Myreete started unsure whether the service was real. The first appointment changed that.",
      "The team arrived on time, fully equipped and focused on a full reset. Doubt turned into trust, and she has continued booking for maintenance and deeper cleans."
    ]
  },
  {
    title: "Lucy's deep clean experience",
    image: '/images/before-after/after-3.jpg',
    tag: 'One-off transformation',
    quote: 'Absolutely blown away by the service, the property looks completely different!',
    body: [
      "Lucy booked a one-off deep clean expecting a professional service and received a full reset.",
      "The team restored the space with care, precision and attention to detail, leaving a lasting impression as well as a cleaner home."
    ]
  },
  {
    title: "Amy's sales-prep clean",
    image: '/images/instock/IMG-20250813-WA0007.jpg',
    tag: 'Market preparation',
    quote: 'Very high quality clean, I was impressed with the speed and the friendliness of the owner.',
    body: [
      "Amy needed her property cleaned and ready for sale quickly.",
      "HQC responded within the short window and delivered a deep, presentation-ready clean to support estate-agent timelines and buyer viewings."
    ]
  },
  {
    title: "Courtney's short-notice clean",
    image: '/images/instock/IMG-20250813-WA0062.jpg',
    tag: 'Personal service',
    quote: "This experience was by far the best I've ever had.",
    body: [
      "Courtney needed a deep clean at short notice and Pedro attended personally.",
      "He explained products, surface treatment and priorities, helping the client feel confident as well as cared for."
    ]
  },
  {
    title: "Ozlem's attention-to-detail experience",
    image: '/images/instock/IMG-20250812-WA0019.jpg',
    tag: 'Careful communication',
    quote: 'My most satisfied cleaning experience.',
    body: [
      "Ozlem had worked with cleaners before, but this experience felt different from the first message to the final walkthrough.",
      "Prompt communication, prepared service and respectful attention to detail set the tone for an ongoing relationship."
    ]
  },
  {
    title: "Tawfeeq's return visit",
    image: '/images/before-after/after-2.jpg',
    tag: 'Repeat client care',
    quote: 'They clean from the heart and take their time on it.',
    body: [
      "Tawfeeq returned because the service felt personal as well as thorough.",
      "The bathrooms and priority areas were handled with care, time and detail, creating the consistency that brings clients back."
    ]
  }
];
---

<Layout
  title="Client Success Stories | High Quality Clean London"
  description="Existing High Quality Clean client stories, presented with local proof imagery and cautious wording around named claims and permissions."
>
  <Header />

  <main class="page-transition pt-16">
    <section class="relative bg-night py-20 text-white md:py-32">
      <div class="absolute inset-0" aria-hidden="true">
        <img src="/images/instock/IMG-20250812-WA0018.jpg" alt="" class="h-full w-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-night/78"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Client success stories</p>
          <h1 class="mt-4 font-serif text-4xl font-semibold md:text-7xl">
            Real words, carefully presented
          </h1>
          <p class="mt-6 max-w-3xl text-xl leading-relaxed text-white/86">
            These stories are already present in HQC copy. They show the pattern behind the service: respect the home, communicate clearly, and leave the client with confidence.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#stories" class="inline-flex items-center justify-center rounded-md bg-brass px-6 py-3 text-sm font-semibold text-night transition-colors hover:bg-brass/90">
              Read the stories
            </a>
            <a href="/case-studies/" class="inline-flex items-center justify-center rounded-md border border-brass px-6 py-3 text-sm font-semibold text-brass transition-colors hover:bg-white/10">
              View case-study summary
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="stories" class="bg-porcelain py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {stories.map((story) => (
            <article class="overflow-hidden rounded-[1.5rem] border border-stone bg-white shadow-soft-sm">
              <img src={story.image} alt="Local proof or property imagery supporting the client story" class="h-56 w-full object-cover" loading="lazy" />
              <div class="p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{story.tag}</p>
                <h2 class="mt-3 font-serif text-2xl font-semibold text-night">{story.title}</h2>
                <blockquote class="mt-4 border-l-4 border-brass pl-4 font-serif text-lg text-night">
                  “{story.quote}”
                </blockquote>
                <div class="mt-5 space-y-3 text-sm leading-relaxed text-ink/72">
                  {story.body.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-night py-20 text-white md:py-24">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Your story starts with the scope</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold md:text-5xl">
          Need a home, turnover or property-care clean scoped properly?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-white/78">
          Tell us what needs to feel calmer, cleaner or more under control, and we will recommend the right route.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/quote/" class="inline-flex items-center justify-center rounded-md bg-brass px-6 py-3 text-sm font-semibold text-night transition-colors hover:bg-brass/90">
            Request Your Personalised Quote
          </a>
          <a href="/contact/" class="inline-flex items-center justify-center rounded-md border border-brass px-6 py-3 text-sm font-semibold text-brass transition-colors hover:bg-white/10">
            Speak to the team
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
