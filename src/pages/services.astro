---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import HeroSection from '../components/HeroSection.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import IntroRateBanner from "../components/IntroRateBanner.astro";
import CTABanner from '../components/CTABanner.astro';
import ServiceTierComparison from '../components/ServiceTierComparison.astro';
---

<Layout 
  title="Luxury Cleaning Services in London | High Quality Clean"
  description="Explore premium home, deep, office, Airbnb, end-of-tenancy and laundry cleaning services for discerning London and Surrey clients. careful cleaning teams."
>
  <Header />
  
  <main class="page-transition pt-16">
    <!-- 1. Hero -->
    <HeroSection 
      title="All Your Cleaning Needs Covered"
      subtitle="From deep cleans to daily maintenance, we offer a range of services to suit your needs."
      imageSrc="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=1600&h=900&fit=crop&crop=center&auto=format&q=80"
      imageAlt="Luxury home interior showcase"
    />

    <!-- Intro Rate Banner -->
    <IntroRateBanner />

    <!-- 2. Proof Bar -->
    <section class="bg-white border-y border-gold/20 py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div
            class="rounded-xl bg-navy border border-gold/50 p-6 flex items-center gap-4"
          >
            <div class="h-12 w-12 rounded-lg bg-gold/20 border border-gold flex items-center justify-center">
              <i class="fas fa-chart-line text-gold text-lg"></i>
            </div>
            <div>
              <div class="text-white font-semibold text-xl">Repeat</div>
              <div class="text-sm text-white/70">client work</div>
            </div>
          </div>
          <div
            class="rounded-xl bg-navy border border-gold/50 p-6 flex items-center gap-4"
          >
            <div class="h-12 w-12 rounded-lg bg-gold/20 border border-gold flex items-center justify-center">
              <i class="fas fa-shield-alt text-gold text-lg"></i>
            </div>
            <div>
              <div class="text-white font-semibold text-xl">Scope</div>
              <div class="text-sm text-white/70">scope planning</div>
            </div>
          </div>
          <div
            class="rounded-xl bg-navy border border-gold/50 p-6 flex items-center gap-4"
          >
            <div class="h-12 w-12 rounded-lg bg-gold/20 border border-gold flex items-center justify-center">
              <i class="fas fa-clock text-gold text-lg"></i>
            </div>
            <div>
              <div class="text-white font-semibold text-xl">Clear</div>
              <div class="text-sm text-white/70">response steps</div>
            </div>
          </div>
          <div
            class="rounded-xl bg-navy border border-gold/50 p-6 flex items-center gap-4"
          >
            <div class="h-12 w-12 rounded-lg bg-gold/20 border border-gold flex items-center justify-center">
              <i class="fas fa-user-check text-gold text-lg"></i>
            </div>
            <div>
              <div class="text-white font-semibold text-xl">100%</div>
              <div class="text-sm text-white/70">access-aware staff</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2.5. Service Tiers Detail -->
    <ServiceTierComparison
      sectionId="services"
      title="Signature home cleaning tiers"
      subtitle="Choose from Essentials Clean™, Signature Clean™ and WellClean™ Premium with clear inclusions, exclusions and indicative ranges before your personalised quote is confirmed."
      eyebrow="Home cleaning tiers"
      backgroundClass="bg-white"
    />

    <!-- 2.6. Specialised Services -->
    <section class="py-20 sm:py-24 bg-navy">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
              <h2 class="font-serif text-4xl md:text-5xl font-bold text-white mb-4">
                  Specialised 
                  <span class="text-gold">
                      Services
                  </span>
              </h2>
              <p class="text-lg text-white/80 max-w-3xl mx-auto">
                  Bespoke cleaning solutions for unique needs — book separately or as premium add-ons
              </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              <!-- Move In/Move Out Reset -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
                  <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-gold rounded-lg flex items-center justify-center mr-4">
                          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2v0a2 2 0 01-2-2v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2a2 2 0 01-2 2 2 2 0 01-2-2V9a2 2 0 012-2h2V7"/>
                          </svg>
                      </div>
                      <h4 class="font-semibold text-gold">Move In / Move Out Reset™</h4>
                  </div>
                  <p class="text-white/80 text-sm mb-3">Deep, compliant cleaning to meet landlord or agent expectations — inventory-ready and stress-free.</p>
                  <p class="text-gold text-sm font-medium italic mb-4">"Leave it spotless. Start fresh."</p>
                  <a href="/services/end-of-tenancy-cleaning/" class="inline-flex items-center text-white/80 hover:text-gold transition-colors text-sm">
                      Learn More
                      <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                  </a>
              </div>

              <!-- Airbnb Turnover Clean -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
                  <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-gold rounded-lg flex items-center justify-center mr-4">
                          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"/>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 15h8M8 11h8m-4-4h4"/>
                          </svg>
                      </div>
                      <h4 class="font-semibold text-gold">Airbnb Turnover Clean™</h4>
                  </div>
                  <p class="text-white/80 text-sm mb-3">Rapid reset between guests — linen, restocking, staging. Hosts trust our touch.</p>
                  <p class="text-gold text-sm font-medium italic mb-4">"Five-star hosting, every time"</p>
                  <a href="/services/airbnb-cleaning/" class="inline-flex items-center text-white/80 hover:text-gold transition-colors text-sm">
                      Learn More
                      <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                  </a>
              </div>

              <!-- HQC Office Clean -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
                  <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-gold rounded-lg flex items-center justify-center mr-4">
                          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                          </svg>
                      </div>
                      <h4 class="font-semibold text-gold">HQC Office Clean™</h4>
                  </div>
                  <p class="text-white/80 text-sm mb-3">Office cleaning for premium spaces. Confidential, consistent, and concierge-level.</p>
                  <p class="text-gold text-sm font-medium italic mb-4">"Confidence in your first impression"</p>
                  <a href="/services/office-cleaning/" class="inline-flex items-center text-white/80 hover:text-gold transition-colors text-sm">
                      Learn More
                      <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                  </a>
              </div>

              <!-- WellClean Studio Edition -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
                  <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-gold rounded-lg flex items-center justify-center mr-4">
                          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                          </svg>
                      </div>
                      <h4 class="font-semibold text-gold">WellClean™ Studio Edition</h4>
                  </div>
                  <p class="text-white/80 text-sm mb-3">Cleaning support for spas, saunas, cold plunges and wellness studios, scoped around touchpoints, limescale, hygiene and guest confidence.</p>
                  <p class="text-gold text-sm font-medium italic mb-4">"Trust at a wellness level"</p>
                  <a href="/services/deep-cleaning/" class="inline-flex items-center text-white/80 hover:text-gold transition-colors text-sm">
                      Learn More
                      <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                  </a>
              </div>

              <!-- WellClean Studio Advisory -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
                  <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-gold rounded-lg flex items-center justify-center mr-4">
                          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                          </svg>
                      </div>
                      <h4 class="font-semibold text-gold">WellClean™ Advisory</h4>
                  </div>
                  <p class="text-white/80 text-sm mb-3">Consulting for wellness operators from design flow to maintenance & operations.</p>
                  <p class="text-gold text-sm font-medium italic mb-4">"Clarity and confidence in your operations"</p>
                  <a href="/services/deep-cleaning/" class="inline-flex items-center text-white/80 hover:text-gold transition-colors text-sm">
                      Learn More
                      <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                  </a>
              </div>

              <!-- HQC Concierge Laundry -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
                  <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-gold rounded-lg flex items-center justify-center mr-4">
                          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-10 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2M7 4h10M9 9h6m-6 4h6"/>
                          </svg>
                      </div>
                      <h4 class="font-semibold text-gold">HQC Concierge Laundry</h4>
                  </div>
                  <p class="text-white/80 text-sm mb-3">Wellness-grade care, luxury presentation, trustworthy consistency — far beyond the bulk wash-and-fold apps.</p>
                  <p class="text-gold text-sm font-medium italic mb-4">"Your Home, Your Wardrobe, Five-Star Clean"</p>
                  <a href="/services/ironing-and-laundry/" class="inline-flex items-center text-white/80 hover:text-gold transition-colors text-sm">
                      Learn More
                      <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                  </a>
              </div>
          </div>

          <div class="text-center mt-12">
              <p class="text-white/80 text-sm mb-6">Specialised services can be booked separately or added to your home, commercial or property-team scope</p>
              <a href="/quote/" class="inline-flex items-center justify-center px-8 py-3 bg-gold text-navy font-semibold rounded-xl hover:bg-gold/90 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105">
                  Enquire About Specialised Services
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
              </a>
          </div>
      </div>
    </section>

    <!-- 2.7. Pricing and fit language -->
    <section class="py-20 sm:py-24 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-gold/25 bg-cream p-8 text-center shadow-soft-sm md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold">Bespoke quote, clear tiering</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold text-navy md:text-5xl">Pricing is guided by the standard you want to feel</h2>
          <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-ink/75">
            The ranges above are indicative. Your final quote reflects size, condition, frequency, access, add-ons and the level of calm, precision and consistency required. HQC is not positioned as the cheapest cleaner, it is for clients who want the clean to feel considered and dependable.
          </p>
          <a href="/quote/" class="mt-8 inline-flex items-center justify-center rounded-xl bg-navy px-8 py-3 font-semibold text-white transition duration-300 hover:bg-navy/90">
            Request Your Personalised Quote
            <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. Photo Story Strip -->
    <TransformationGallery />

    <!-- 6. Founder Vision -->
     <section class="py-24 md:py-32 bg-white">
      <div
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-16 items-center"
      >
        <div class="flex justify-center">
          <img
            src="/images/pedro.jpg"
            alt="Pedro, founder of High Quality Clean"
            class="w-3/4 h-auto rounded-xl border border-gold/30 shadow-lg"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="font-serif text-3xl md:text-4xl text-navy mb-6 flex items-center gap-3">
            <i class="fas fa-user-tie text-gold"></i>
            Pedro's Vision
          </h3>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            After a decade in luxury hospitality, Pedro founded HQC to merge
            wellness science with concierge etiquette.
          </p>
          <ul class="text-slate-600 space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <i class="fas fa-check text-gold mt-1"></i>
              Quiet presence, precise standards
            </li>
            <li class="flex items-start gap-3">
              <i class="fas fa-check text-gold mt-1"></i>
              Surface‑safe methods, long‑term care
            </li>
            <li class="flex items-start gap-3">
              <i class="fas fa-check text-gold mt-1"></i>
              Predictable outcomes, photo handovers
            </li>
          </ul>
          <blockquote class="text-xl italic text-gold font-medium border-l-4 border-gold pl-6">
            "True luxury is the calm you feel when every detail is handled."
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 9. FAQs -->
    <section id="faqs" class="py-24 md:py-32 bg-navy">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-3xl md:text-4xl text-white text-center mb-12">
          Frequently Asked Questions
        </h2>
      <FAQ />
      </div>
    </section>

    <!-- 10. Final CTA Banner -->
    <CTABanner />

    <!-- Quote Route CTA -->
    <section id="quote" class="py-24 md:py-32 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl bg-navy p-8 md:p-12 border border-gold/50 shadow-xl text-center">
          <p class="text-gold text-sm font-semibold uppercase tracking-[0.2em] mb-3">Secure quote route</p>
          <h2 class="font-serif text-3xl md:text-4xl text-white mb-4">Request Your Personalised Quote</h2>
          <p class="text-white/80 text-lg max-w-2xl mx-auto">
            Tell us about your service, property and preferred outcome on the dedicated quote page so we can respond with the right scope.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/quote/" class="inline-flex items-center justify-center rounded-md bg-gold text-navy px-6 py-3 text-base font-medium border border-gold hover:bg-gold/90 transition-colors">
              <i class="fas fa-paper-plane mr-2"></i>
              Open Quote Form
            </a>
            <a href="/contact/" class="inline-flex items-center justify-center rounded-md border border-gold text-gold px-6 py-3 text-base font-medium hover:bg-gold/10 transition-colors">
              Speak to the Team
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
