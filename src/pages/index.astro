---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ServiceSelector from '../components/ServiceSelector.astro';
import ClientEvidence from '../components/ClientEvidence.astro';
import ReviewMarquee from '../components/ReviewMarquee.astro';
import reviewsData from '../data/google-reviews.json';
import phase8Copy from '../data/phase8-copy.json';
import { controlledCtaHref } from '../data/controlled-cta-links';
import { offeringImages, sectionImagery } from '../data/section-imagery';
import { libraryPhotos } from '../data/page-visuals';
import { isIllustrativeImage, illustrativeAlt, cardImage, cardLibrary, homeComplexStepImagery, homeProcessImagery, type CardImageId } from '../data/card-imagery';
import MotionKit from '../components/MotionKit.astro';

const homeCopy = phase8Copy.home;
const homeSection = (heading: string) => homeCopy.sections.find((section) => section.heading === heading);
const ctaLabels = (heading: string) => (homeSection(heading)?.blocks ?? []).filter((block) => block.kind === 'cta').map((block) => block.text ?? '');
const paragraphs = (heading: string) => (homeSection(heading)?.blocks ?? []).filter((block) => block.kind === 'p').map((block) => block.text ?? '');
// Three core offerings at hero level (6 Nov 2026), in the approved Batch 1 buyer-route order.
const offerings = [
  { eyebrow: 'Property & Facilities', title: 'Managed properties, portfolios and projects', href: '/property-facilities-cleaning-london/', image: offeringImages.complex },
  { eyebrow: 'Workplaces & Commercial', title: 'Recurring programmes and operational resets', href: '/commercial-cleaning-london/', image: offeringImages.workplace },
  { eyebrow: 'Homes & Private Clients', title: 'Maintenance, restoration and moving services', href: '/home-cleaning-london/', image: offeringImages.home }
];
const outcomeImage = sectionImagery['cleaning-prices-london'][0].images[0];
// Illustrative library images (card-imagery.ts); each appears once on the page.
const lib = (id: CardImageId) => cardLibrary[id];

// Presentation only. Approved blocks render in their authored order; each chapter has its own
// composition so the page alternates between split, full-bleed and centred layouts.
type Block = (typeof homeCopy.sections)[number]['blocks'][number];
const section = (heading: string) => homeSection(heading)!;
const groupBlocks = (blocks: Block[], trailingCtasOutside = false) => {
  const groups: { heading: Block; body: Block[] }[] = [];
  for (const block of blocks) {
    if (block.kind === 'h3') groups.push({ heading: block, body: [] });
    else if (groups.length) groups[groups.length - 1].body.push(block);
  }
  const outro: Block[] = [];
  const last = groups[groups.length - 1];
  while (trailingCtasOutside && last && last.body.length && last.body[last.body.length - 1].kind === 'cta') outro.unshift(last.body.pop()!);
  return { groups, outro };
};
// Jack, 11 Nov 2026 (C8): list items render without trailing semicolons or full stops.
const listItem = (item: string) => item.replace(/\s*[;.]\s*$/, '');

const outcome = section('Cleaning Defined by the Outcome');
const homes = groupBlocks(section('Cleaning Services for London Homes').blocks);
const partner = section('One Cleaning Partner Across Properties, Projects and Portfolios');
const workplace = section('Cleaning Programmes Built Around the Workplace');
const why = groupBlocks(section('Why Clients Choose HQC When the Result Matters').blocks, true);
const homeServiceImages: CardImageId[] = ['r-kitchen-wipe', 'r-shower-glass', 'r-boxes-movein', 'r-inventory', 'p-snagging'];
---

<Layout
  title="Professional Cleaning Services London | High Quality Clean"
  description="Professional cleaning services for London homes, workplaces and managed properties. Find the right HQC service for the condition, outcome and work required."
>
  <MotionKit />
  <Header />
  <div class="hm-progress" data-page-progress aria-hidden="true"></div>

  <main class="hm-page bg-porcelain pt-20">
    {/* Hero: one decisive photograph, the promise, two actions, three routes that steer the photograph. */}
    <section class="hm-hero relative isolate bg-midnight text-white" data-hero>
      <div class="hm-hero-main">
        <div class="hm-hero-copy">
          <p class="section-kicker hm-kicker-line text-copper" data-intro="fade">Cleaning Defined by the Outcome</p>
          <h1 class="hm-hero-h1 mt-5 font-serif font-medium" data-intro="title">
            The Right Cleaning Service<br /><em class="font-medium text-copper">for the Result You Need</em>
          </h1>
          <ul class="hm-hero-tabs mt-6 grid grid-cols-3 gap-2 lg:hidden" aria-label="Our three core services">
            {offerings.map((offering, index) => (
              <li data-intro style={`--d: ${160 + index * 60}ms`}>
                <a href={offering.href} class:list={['group block text-white no-underline', index === 0 && 'is-active']} data-slide-tab={index}>
                  <span class="hm-hero-thumb block overflow-hidden rounded-lg">
                    <img src={offering.image.src} srcset={offering.image.srcset} sizes="33vw" alt={illustrativeAlt(offering.image.src, offering.image.alt)} class="aspect-[4/3] w-full object-cover object-[70%_50%]" width="800" height="600" loading="lazy" decoding="async" />{isIllustrativeImage(offering.image.src) && <span class="image-disclosure">Illustrative</span>}
                  </span>
                  <span class="mt-1.5 block text-[11px] font-bold leading-tight">{offering.eyebrow}&nbsp;<span class="text-copper" aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 max-w-[34rem] text-base leading-7 text-white/80 sm:text-lg sm:leading-8" data-intro style="--d: 120ms">From recurring home cleaning to workplace programmes, property handovers and complex projects, High Quality Clean matches the service, labour and delivery approach to the condition of the space and the outcome required.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-hero-actions data-intro style="--d: 180ms">
            <a href="#find-my-service" class="button button-primary" data-track="find_my_service">Find my service <span class="hm-arrow-nudge" aria-hidden="true">↓</span></a>
            <a href="/request-a-quote/" class="button button-ghost" data-track="request_quote">Request a Cleaning Quote</a>
          </div>
          <p class="mt-6 text-lg leading-8 text-white/85" data-controlled-trust-line>Join more than 300 clients who have chosen HQC.</p>
          <div class="hm-trust-row mt-9 flex flex-wrap gap-x-7 gap-y-2 text-[11px] font-bold uppercase tracking-[.18em] text-white/65" data-intro="fade" style="--d: 320ms">
            <a href="#google-reviews" class="hm-trust-rating"><span class="text-copper" aria-hidden="true">★★★★★</span>{reviewsData.rating} on <span class="hm-google-g"><span class="sr-only">Google</span><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span> from {reviewsData.reviewCount} reviews</a><span>London-based</span><span>Outcome-led</span><span>Founder-led</span>
          </div>
        </div>

        <div class="hm-hero-media" data-hero-media>
          {offerings.map((offering, index) => (
            <img
              src={offering.image.src}
              srcset={offering.image.srcset}
              sizes="(min-width: 1024px) 54vw, 100vw"
              alt={illustrativeAlt(offering.image.src, offering.image.alt)}
              class:list={['hm-slide', index === 0 && 'is-active']}
              data-slide={index}
              width="1600"
              height="900"
              fetchpriority={index === 0 ? 'high' : undefined}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />{isIllustrativeImage(offering.image.src) && <span class="image-disclosure">Illustrative</span>}
          ))}
        </div>
      </div>

      <ul class="hm-routebar" aria-label="Our three core services">
        {offerings.map((offering, index) => (
          <li data-intro style={`--d: ${240 + index * 70}ms`}>
            <a href={offering.href} class:list={['hm-route-tab group', index === 0 && 'is-active']} data-slide-tab={index}>
              <span class="hm-route-tab-timer" aria-hidden="true"></span>
              <span class="hm-route-tab-eyebrow block text-[11px] font-bold uppercase tracking-[.18em] text-copper">{offering.eyebrow}</span>
              <span class="hm-route-tab-title block font-serif font-medium">{offering.title}</span>
              <span class="hm-offer-cta text-sm font-bold text-white/85">Explore <span class="text-copper" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <ReviewMarquee />

    {/* Routes: centred introduction, three tall photographic routes. */}
    <section class="hm-routes-section bg-white">
      <div class="section-shell">
      <div class="mx-auto max-w-3xl text-center">
        <p class="section-kicker" data-reveal="fade">Start with what you need to achieve</p>
        <h2 class="section-title mx-auto" data-reveal="title">Tell Us the Result You Need</h2>
        {paragraphs('Start with what you need to achieve').slice(0, 2).map((paragraph, index) => <p class:list={['mx-auto max-w-2xl text-lg leading-8 text-slate', index === 0 ? 'mt-7' : 'mt-3']} data-reveal style={`--d: ${100 + index * 80}ms`}>{paragraph}</p>)}
      </div>
      <div class="hm-routes mt-10 grid gap-5 md:mt-12 lg:grid-cols-3" data-stagger="110">
        {[
          {
            number: '01',
            eyebrow: 'Property & Facilities',
            title: 'Managed properties, portfolios and projects',
            copy: paragraphs('Start with what you need to achieve')[2],
            cta: ctaLabels('Start with what you need to achieve')[0],
            href: '/property-facilities-cleaning-london/',
            image: '/images/generated/hqc-property-hero.webp',
            alt: 'Empty flat hallway with wooden floors and open doors.'
          },
          {
            number: '02',
            eyebrow: 'Workplaces & Commercial',
            title: 'Recurring programmes and operational resets',
            copy: paragraphs('Start with what you need to achieve')[3],
            cta: ctaLabels('Start with what you need to achieve')[1],
            href: '/commercial-cleaning-london/',
            image: '/images/generated/hqc-office-hero.png',
            alt: 'Meeting room with a long table and a view of the City of London.'
          },
          {
            number: '03',
            eyebrow: 'Homes & Private Clients',
            title: 'Maintenance, restoration and moving services',
            copy: paragraphs('Start with what you need to achieve')[4],
            cta: ctaLabels('Start with what you need to achieve')[2],
            href: '/home-cleaning-london/',
            image: '/images/generated/hqc-home-hero.webp',
            alt: 'Living room with a corner sofa and tall windows.'
          }
        ].map((route) => (
          <a href={route.href} class="hm-route group flex flex-col overflow-hidden rounded-[1.25rem] bg-porcelain text-inherit no-underline">
            <span class="hm-route-media block overflow-hidden">
              <img src={route.image} alt={illustrativeAlt(route.image, route.alt)} class="aspect-[4/3] w-full object-cover lg:aspect-[5/4]" loading="lazy" decoding="async" width="800" height="650" />{isIllustrativeImage(route.image) && <span class="image-disclosure">Illustrative</span>}
            </span>
            <span class="flex flex-1 flex-col p-6 md:p-8">
              <span class="flex items-center justify-between gap-4"><h3 class="meta-label">{route.eyebrow}</h3><span class="font-serif text-2xl text-copper-ink">{route.number}</span></span>
              <span class="mt-4 block font-serif text-[1.75rem] font-medium leading-tight text-midnight md:text-[2rem]">{route.title}</span>
              <span class="mt-4 block text-[15px] leading-6 text-slate">{route.copy}</span>
              <span class="mt-auto block pt-7"><span class="hm-cta-link">{route.cta} <span class="hm-cta-chip" aria-hidden="true">→</span></span></span>
            </span>
          </a>
        ))}
      </div>
      </div>
    </section>

    <div data-dock-hide>
      <ServiceSelector />
    </div>


    <div data-controlled-copy="Batch 1, page 1">
      {/* Outcome (Jack's layout, 11 Nov): heading beside the opening lines, photograph beside an icon grid of
          what HQC considers, then the support line and the pricing link. Copy and order unchanged. */}
      <section class="hm-outcome bg-porcelain py-20 md:py-28">
        <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
          {(() => {
            const b = outcome.blocks;
            const ul = b.find((block) => block.kind === 'ul');
            const ulIndex = b.findIndex((block) => block.kind === 'ul');
            const intro = b.slice(0, ulIndex - 1).filter((block) => block.kind === 'p');
            const label = b[ulIndex - 1];
            const after = b.slice(ulIndex + 1).filter((block) => block.kind === 'p');
            const support = b.find((block) => block.kind === 'support');
            const cta = b.find((block) => block.kind === 'cta');
            // Lucide icons (ISC licence), inlined so no icon package is added.
            const icons = [
              '<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 12 1.5 1.5L13 11"/><path d="M15 12h1"/><path d="m9 17 1.5 1.5L13 16"/><path d="M15 17h1"/>',
              '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
              '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
              '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/>',
              '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
              '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'
            ];
            return (
              <>
                <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-16">
                  <h2 class="hm-outcome-title font-serif font-medium text-midnight" data-reveal="title">{outcome.heading}</h2>
                  <div class="space-y-3">
                    {intro.map((block, index) => <p class:list={[index === 0 ? 'hm-outcome-lead' : 'text-lg leading-8 text-slate']} data-reveal style={`--d: ${index * 80}ms`}>{block.text}</p>)}
                  </div>
                </div>
                <div class="mt-12 grid gap-10 md:mt-16 lg:grid-cols-[.95fr_1.05fr] lg:items-center lg:gap-16">
                  <figure class="hm-outcome-media" data-reveal="clip" style="--hm-cover: var(--color-porcelain)">
                    <img src={outcomeImage.src} srcset={outcomeImage.srcset} sizes="(min-width: 1024px) 45vw, 100vw" alt={illustrativeAlt(outcomeImage.src, outcomeImage.alt)} loading="lazy" decoding="async" width="1600" height="900" />{isIllustrativeImage(outcomeImage.src) && <span class="image-disclosure">Illustrative</span>}
                  </figure>
                  <div>
                    {label && <p class="hm-label" data-reveal>{label.text}</p>}
                    {ul && ul.kind === 'ul' && (
                      <ul class="hm-considers" data-stagger="50" data-stagger-type="fade">
                        {ul.items.map((item, index) => (
                          <li><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[index % icons.length]} /><span>{listItem(item)}</span></li>
                        ))}
                      </ul>
                    )}
                    {after.map((block) => <p class="mt-6 text-lg leading-8 text-slate" data-reveal>{block.text}</p>)}
                  </div>
                </div>
                <div class="hm-outcome-foot">
                  {support && <p class="hm-outcome-support" data-reveal>{support.text}</p>}
                  {cta && <a href={controlledCtaHref(cta.text ?? '')} class="hm-cta-link hm-cta-dark shrink-0" data-reveal>{cta.text} <span class="hm-cta-chip" aria-hidden="true">→</span></a>}
                </div>
              </>
            );
          })()}
        </div>
      </section>

      {/* Homes: one continuous section over a tinted photograph; the heading sits directly above the cards. */}
      <section class="hm-dark hm-homes hm-parallax relative isolate overflow-hidden text-white">
        <img class="hm-homes-bg" src={lib('r-living-dust').src} alt={illustrativeAlt(lib('r-living-dust').src, lib('r-living-dust').alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(lib('r-living-dust').src) && <span class="image-disclosure">Illustrative</span>}
        <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 md:py-24 lg:px-14">
          <h2 class="hm-homes-title mx-auto text-center font-serif font-medium text-white" data-reveal="title">Cleaning Services for London Homes</h2>
          <div class="hm-cards mt-10 md:mt-12 md:grid-cols-2 xl:grid-cols-4" data-stagger="90">
            {homes.groups.map((group, groupIndex) => {
              const featured = groupIndex === 0;
              const image = lib(homeServiceImages[groupIndex]);
              return (
                <article class:list={['hm-card hm-card-dark', featured && 'hm-card-featured md:col-span-2 xl:col-span-4']}>
                  <span class="hm-card-media block overflow-hidden"><img src={image.src} alt={illustrativeAlt(image.src, image.alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(image.src) && <span class="image-disclosure">Illustrative</span>}</span>
                  <div class="hm-card-body">
                    {(() => {
                      // Service name, then its short descriptor; the full heading stays the accessible name.
                      const [name, ...rest] = (group.heading.text ?? '').split(' - ');
                      return <h3 class="hm-service-title" aria-label={group.heading.text}><span class="hm-service-name">{name}</span>{rest.length > 0 && <><span class="sr-only"> - </span><span class="hm-service-sub">{rest.join(' - ')}</span></>}</h3>;
                    })()}
                    {group.body.map((block, blockIndex) => {
                      if (block.kind === 'cta') return <p class="hm-card-foot text-base"><a href={controlledCtaHref(block.text ?? '')} class="hm-cta-link">{block.text} <span class="hm-cta-chip" aria-hidden="true">→</span></a></p>;
                      if (featured && blockIndex === 1) return <p class="hm-offer-note text-base leading-7">{block.text}</p>;
                      return <p class="text-base leading-7">{block.text}</p>;
                    })}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      {/* Partner: full-bleed street photograph, content panel on the right. */}
      <section class="hm-stage">
        <div class="hm-stage-media hm-parallax">
          <img src={lib('p-van-street').src} alt={illustrativeAlt(lib('p-van-street').src, lib('p-van-street').alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(lib('p-van-street').src) && <span class="image-disclosure">Illustrative</span>}
        </div>
        <div class="hm-stage-panel" data-reveal="right">
          <h2 class="section-title" data-reveal="title">{partner.heading}</h2>
          <div class="mt-7 space-y-5 text-lg leading-8 text-slate">
            {partner.blocks.map((block, index) => {
              const next = partner.blocks[index + 1];
              if (block.kind === 'ul') return <ul class="hm-checks" data-stagger="40" data-stagger-type="fade">{block.items.map((item) => <li><span>{listItem(item)}</span></li>)}</ul>;
              if (block.kind === 'cta') return <p class="pt-2 text-base" data-reveal><a href={controlledCtaHref(block.text ?? '')} class="hm-cta-link">{block.text} <span class="hm-cta-chip" aria-hidden="true">→</span></a></p>;
              if (index === 0) return <p class="hm-lead" data-reveal>{block.text}</p>;
              if (next?.kind === 'ul') return <p class="hm-label pt-2" data-reveal>{block.text}</p>;
              return <p data-reveal>{block.text}</p>;
            })}
          </div>
        </div>
      </section>

      {/* Workplace: reasoning left, full-height photograph right. */}
      <section class="hm-split hm-split-media-right bg-porcelain">
        <div class="hm-split-copy">
          <h2 class="section-title" data-reveal="title">{workplace.heading}</h2>
          <div class="mt-8 space-y-5 text-lg leading-8 text-slate">
            {workplace.blocks.map((block, index) => {
              const next = workplace.blocks[index + 1];
              if (block.kind === 'ul') return <ul class="hm-checks hm-checks-panel" data-stagger="40" data-stagger-type="fade">{block.items.map((item) => <li><span>{listItem(item)}</span></li>)}</ul>;
              if (block.kind === 'cta') return <p class="text-base" data-reveal><a href={controlledCtaHref(block.text ?? '')} class:list={['hm-cta-link', workplace.blocks[index - 1]?.kind === 'cta' && 'hm-cta-secondary']}>{block.text} <span class="hm-cta-chip" aria-hidden="true">→</span></a></p>;
              if (index === 0) return <p class="hm-lead" data-reveal>{block.text}</p>;
              if (next?.kind === 'ul') return <p class="hm-label pt-2" data-reveal>{block.text}</p>;
              return <p data-reveal>{block.text}</p>;
            })}
          </div>
        </div>
        <figure class="hm-split-media" data-reveal="clip" style="--hm-cover: var(--color-porcelain)">
          <img src={lib('c-after-hours').src} alt={illustrativeAlt(lib('c-after-hours').src, lib('c-after-hours').alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(lib('c-after-hours').src) && <span class="image-disclosure">Illustrative</span>}
        </figure>
      </section>

      {/* Why HQC: centred heading, one photograph beside six reasons. */}
      <section class="hm-why-section bg-white py-20 md:py-28">
        <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
          <div class="mx-auto max-w-4xl text-center">
            <h2 class="section-title mx-auto" data-reveal="title">Why Clients Choose HQC When the Result Matters</h2>
          </div>
          <div class="hm-why mt-10 md:mt-12">
            <figure class="hm-why-media" data-reveal="clip" style="--hm-cover: white">
              <img src={lib('p-signoff').src} alt={illustrativeAlt(lib('p-signoff').src, lib('p-signoff').alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(lib('p-signoff').src) && <span class="image-disclosure">Illustrative</span>}
            </figure>
            <div class="hm-why-grid" data-stagger="70">
              {why.groups.map((group) => (
                <article class="hm-reason">
                  <h3 class="font-serif text-2xl font-medium leading-tight text-midnight">{group.heading.text}</h3>
                  {group.body.map((block) => <p class="mt-3 text-base leading-7 text-slate">{block.text}</p>)}
                </article>
              ))}
            </div>
          </div>
          {why.outro.length > 0 && <div class="mt-12 text-center" data-reveal>{why.outro.map((block) => <a href={controlledCtaHref(block.text ?? '')} class="hm-cta-link">{block.text} <span class="hm-cta-chip" aria-hidden="true">→</span></a>)}</div>}
        </div>
      </section>
    </div>

    {/* How HQC works: centred statement, pinned five-step sequence. */}
    <section class="hm-pin relative overflow-clip bg-midnight py-20 text-white md:py-28" data-pin>
      <div class="hm-pin-stage relative mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14" data-pin-stage>
        <div class="mx-auto max-w-3xl text-center">
          <p class="section-kicker text-copper" data-reveal="fade">How HQC works</p>
          <h2 class="mt-4 font-serif text-4xl font-medium leading-[1.02] tracking-tight md:text-6xl" data-reveal="title">Clarity before anyone picks up a cloth.</h2>
          <p class="hm-pin-intro mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75" data-reveal style="--d: 120ms">The condition, access, timing and required finish are captured before the work is confirmed. That means the service can be staffed and delivered responsibly.</p>
        </div>
        <div class="hm-steps relative mt-12 grid gap-px overflow-hidden rounded-[1.25rem] border border-white/15 bg-white/15 lg:grid-cols-5" data-scroll-track data-reveal="fade">
          <div class="hm-track-line" aria-hidden="true"></div>
          {[
            ['01', 'Site review', 'Understand the outcome, condition, access and operating constraints.'],
            ['02', 'Service profile', 'Define the areas, tasks, frequencies and relevant site requirements.'],
            ['03', 'Mobilisation', 'Confirm access, allocation, equipment and practical controls before delivery.'],
            ['04', 'Delivery', 'Work from the authorised service and property information, not assumptions.'],
            ['05', 'Quality review', 'Review the standard and adjust the service as requirements change.']
          ].map(([number, title, copy], index) => {
            const image = cardImage(homeProcessImagery[title]);
            return (
            <article class:list={['hm-step flex flex-col', index === 2 ? 'bg-copper text-midnight' : 'bg-midnight']} data-step>
              {image && <span class="block overflow-hidden"><img src={image.src} alt={illustrativeAlt(image.src, image.alt)} class="aspect-[16/10] w-full object-cover lg:aspect-[4/3]" loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(image.src) && <span class="image-disclosure">Illustrative</span>}</span>}
              <div class="p-7 md:p-9">
                <span class:list={['hm-step-num font-serif text-4xl', index === 2 ? 'text-midnight' : 'text-copper']}>{number}</span>
                <h3 class="mt-8 font-serif text-3xl font-medium">{title}</h3>
                <p class:list={['mt-4 leading-7', index === 2 ? 'text-midnight' : 'text-white/70']}>{copy}</p>
              </div>
            </article>
            );
          })}
        </div>
        <div class="text-center">
          <a href="/how-we-work/" class="button button-ghost mt-9">See how the service works <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    {/* Complex route: photographic steps left, reasoning right. */}
    <section class="bg-white py-20 md:py-28">
      <div class="mx-auto grid max-w-[1440px] gap-12 px-5 sm:px-8 lg:grid-cols-[1.25fr_.75fr] lg:gap-20 lg:px-14">
        <div class="hm-chapter-head lg:order-2"><div class="hm-sticky">
          <p class="section-kicker" data-reveal="fade">Complex service route</p>
          <h2 class="section-title" data-reveal="title">When Routine Cleaning Is Not Enough</h2>
          {paragraphs('When Routine Cleaning Is Not Enough').map((paragraph) => <p class="mt-6 text-lg leading-8 text-slate" data-reveal>{paragraph}</p>)}
          {ctaLabels('When Routine Cleaning Is Not Enough').map((label) => <a href={controlledCtaHref(label)} class="hm-cta-link mt-7" data-reveal>{label} <span class="hm-cta-chip" aria-hidden="true">→</span></a>)}
        </div></div>
        <ol class="hm-complex grid gap-3 sm:grid-cols-2 lg:order-1 lg:grid-cols-3" aria-label="Complex service process" data-stagger="80">
          {['Qualification', 'Assessment', 'Defined scope', 'Delivery plan', 'Controlled delivery', 'Handover'].map((step, index) => {
            const image = cardImage(homeComplexStepImagery[step]);
            return (
            <li class="hm-complex-step relative overflow-hidden rounded-[1.25rem] bg-midnight text-white">
              {image && <img src={image.src} alt={illustrativeAlt(image.src, image.alt)} class="aspect-[4/5] w-full object-cover" loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(image.src) && <span class="image-disclosure">Illustrative</span>}}
              <div class="hm-complex-caption">
                <span class="font-serif text-2xl text-copper">0{index + 1}</span>
                <p class="mt-1 font-serif text-2xl leading-tight">{step}</p>
              </div>
            </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* Client evidence: full-bleed London street, statement centred. */}
    <div class="hm-evidence hm-parallax">
      <img class="hm-evidence-bg" src={lib('p-mansion-blocks').src} alt={illustrativeAlt(lib('p-mansion-blocks').src, lib('p-mansion-blocks').alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(lib('p-mansion-blocks').src) && <span class="image-disclosure">Illustrative</span>}
      <div class="relative" data-reveal>
        <ClientEvidence id="proof-release-title" />
      </div>
    </div>

    <section class="hm-visible bg-porcelain">
    <div class="section-shell">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_.85fr] lg:gap-20">
        <div class="grid auto-rows-[210px] grid-cols-2 gap-4 md:auto-rows-[260px]">
          {[libraryPhotos.bedroom, libraryPhotos.livingArea].map((photo, index) => (
            <figure class="relative row-span-2 overflow-hidden rounded-[1.25rem]" data-reveal="clip" style={`--d: ${index * 140}ms`}>
              <img src={photo.src} alt={illustrativeAlt(photo.src, photo.alt)} class="h-full w-full object-cover" loading="lazy" decoding="async" width="1536" height="2048" />{isIllustrativeImage(photo.src) && <span class="image-disclosure">Illustrative</span>}
            </figure>
          ))}
        </div>
        <div>
          <p class="section-kicker" data-reveal="fade">Evidence, not adjectives</p>
          <h2 class="section-title" data-reveal="title">The work should be visible.</h2>
          <p class="mt-7 text-lg leading-8 text-slate" data-reveal>Each quotation starts with the property, workplace or project in front of us.</p>
          <div class="mt-8 grid grid-cols-2 gap-4 border-y border-midnight/10 py-7" data-stagger="100">
            <div><strong class="font-serif text-5xl font-medium text-midnight">1</strong><span class="mt-1 block text-sm text-slate">clear route from requirement to review</span></div>
            <div><strong class="font-serif text-5xl font-medium text-midnight">3</strong><span class="mt-1 block text-sm text-slate">clear enquiry routes</span></div>
          </div>
          <a href="/reviews-case-studies/" class="hm-cta-link mt-8" data-reveal>View project evidence <span class="hm-cta-chip">→</span></a>
        </div>
      </div>
    </div>
    </section>

    {/* Founder (Jack, 11 Nov): portrait left as a full-height photograph, words right on a dark ground. */}
    <section class="hm-founder hm-dark overflow-hidden bg-midnight text-white">
      <div class="grid lg:grid-cols-[1fr_1fr]">
        <figure class="hm-founder-photo" data-reveal="clip" style="--hm-cover: var(--color-midnight)">
          <img src="/images/pedro-on-site-original.png" alt="Pedro Ndombasi, founder of High Quality Clean, on site with a team member." loading="lazy" decoding="async" width="1448" height="1086" style="object-position: 50% 40%;" />
        </figure>
        <div class="hm-founder-copy">
          <div class="w-full max-w-[38rem]">
            <p class="section-kicker" data-reveal="fade">Founder-led</p>
            <h2 class="section-title text-white" data-reveal="title">Pedro’s Vision for High Quality Clean</h2>
            {paragraphs('Pedro’s Vision for High Quality Clean').map((paragraph, index) => <p class:list={['mt-6 text-lg leading-8 text-white/80', index === 0 && 'hm-lead !text-white']} data-reveal>{paragraph}</p>)}
            <p class="mt-7 font-bold text-white" data-reveal>Pedro Ndombasi <span class="ml-2 font-normal text-white/70">Founder & Managing Director</span></p>
            {ctaLabels('Pedro’s Vision for High Quality Clean').map((label) => <a href={controlledCtaHref(label)} class="hm-cta-link mt-8">{label} <span class="hm-cta-chip" aria-hidden="true">→</span></a>)}
          </div>
        </div>
      </div>
    </section>

    {/* Closing call to action: handover photograph, centred. */}
    <section class="hm-closing hm-parallax relative isolate overflow-hidden text-white" data-dock-hide="after">
      <img class="hm-closing-bg" src={lib('p-handover-keys').src} alt={illustrativeAlt(lib('p-handover-keys').src, lib('p-handover-keys').alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(lib('p-handover-keys').src) && <span class="image-disclosure">Illustrative</span>}
      <div class="relative mx-auto flex max-w-[1440px] flex-col items-center px-5 py-24 text-center sm:px-8 md:py-36 lg:px-14">
        <h2 class="max-w-4xl font-serif text-4xl font-medium leading-tight md:text-6xl" data-reveal="title">Not Sure Which Cleaning Service You Need?</h2>
        {paragraphs('Not Sure Which Cleaning Service You Need?').map((paragraph) => <p class="mt-5 max-w-2xl text-lg leading-8 text-white/90" data-reveal style="--d: 120ms">{paragraph}</p>)}
        <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal style="--d: 200ms">
          <a href="#find-my-service" class="button button-primary">Find My Service <span class="hm-arrow-nudge" aria-hidden="true">↓</span></a>
          <a href="/request-a-quote/" class="button button-ghost">Request a Quote</a>
        </div>
      </div>
    </section>
  </main>

  <div class="hm-dock" data-action-dock aria-hidden="true" inert>
    <a href="#find-my-service" class="bg-copper text-midnight" data-track="find_my_service">Find my service <span aria-hidden="true">↓</span></a>
    <a href="/request-a-quote/" class="border border-white/25 text-white" data-track="request_quote">Request a Cleaning Quote</a>
  </div>

</Layout>
