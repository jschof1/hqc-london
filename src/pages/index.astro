---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LandingHeroSection from '../components/LandingHeroSection.astro';
import SpecializedServicesSection from '../components/SpecializedServicesSection.astro';
import DifferentiationSection from '../components/DifferentiationSection.astro';
import AreasServed from '../components/AreasServed.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import IntroRateBanner from '../components/IntroRateBanner.astro';
import BuyerRoutes from '../components/BuyerRoutes.astro';
import ServiceTierComparison from '../components/ServiceTierComparison.astro';
---

<Layout
  title="Premium Cleaning Services London | Homes & Commercial Spaces | HQC"
  description="High Quality Clean provides premium, carefully scoped cleaning for London homes, commercial spaces and managed properties, with personalised quotes and calm property-care standards."
>
  <Header />

  <main class="page-transition pt-16 relative">
    <LandingHeroSection />

    <section class="border-y border-stone bg-white py-6" aria-label="HQC assurance strip">
      <div class="mx-auto grid max-w-7xl gap-4 px-4 sm:px-6 md:grid-cols-4 lg:px-8">
        {[
          ['London property care', 'Homes, studios, offices and managed spaces'],
          ['Quote before work begins', 'Scope, access and finish confirmed first'],
          ['Real proof below', 'Before-after and local in-property imagery'],
          ['Built for consistency', 'Recurring fit, handover notes and clear standards'],
        ].map(([label, detail]) => (
          <div class="rounded-2xl border border-stone bg-porcelain px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{label}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{detail}</p>
          </div>
        ))}
      </div>
    </section>

    <BuyerRoutes />

    <ServiceTierComparison
      sectionId="service-tiers"
      eyebrow="Residential tier preview"
      title="Home cleaning tiers, all quoted around the real property"
      subtitle="Essentials Clean™, Signature Clean™ and WellClean™ Premium give home clients a clearer starting point without duplicating scope copy across the site."
      showComparison={false}
      backgroundClass="bg-white"
    />

    <IntroRateBanner />

    <ProcessSteps />

    <TransformationGallery />

    <DifferentiationSection />

    <SpecializedServicesSection />

    <AreasServed />

    <section
      id="personalised-quote"
      class="relative overflow-hidden py-20 text-white md:py-24"
      style="background-image: url('/images/instock/IMG-20250812-WA0018.jpg'); background-size: cover; background-position: center;"
    >
      <div class="absolute inset-0 bg-night/78" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Request your personalised quote</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold text-white md:text-5xl">
          No standard homes. No standard packages. Start with the clean that fits yours.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/82">
          Tell HQC about the property, route, access, desired finish and any specialist requirements. The quote conversation confirms the right tier or support route before work begins.
        </p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href="/quote/"
            class="inline-flex items-center justify-center rounded-full bg-brass px-8 py-4 font-semibold text-night no-underline transition duration-300 hover:bg-brass/90 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          >
            Request Your Personalised Quote
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-full border border-white/25 bg-white/10 px-8 py-4 font-semibold text-white no-underline transition duration-300 hover:bg-white/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          >
            Speak to HQC first
          </a>
        </div>
        <p class="mt-6 text-sm text-white/68">
          Introductory recurring-client rate may be discussed after scope confirmation. <a href="#offer" class="text-brass underline underline-offset-4 hover:text-white">See offer note</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>
