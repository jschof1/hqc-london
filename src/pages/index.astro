---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LandingHeroSection from '../components/LandingHeroSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import SpecializedServicesSection from '../components/SpecializedServicesSection.astro';
import DifferentiationSection from '../components/DifferentiationSection.astro';
import AreasServed from '../components/AreasServed.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import IntroRateBanner from '../components/IntroRateBanner.astro';
import BuyerRoutes from '../components/BuyerRoutes.astro';
---

<Layout
  title="Cleaning Services London | Homes, Property Teams & Offices | HQC"
  description="High Quality Clean provides high-standard cleaning for London homes, managed properties, offices and client-facing spaces with clear scopes, careful handling and consistent standards."
>
  <Header />
  
  <main class="page-transition pt-16 relative">
	<!-- 1. Hero (Above the Fold) -->
	<div class="hero-transition">
		<LandingHeroSection />
	</div>
	<BuyerRoutes />
	<IntroRateBanner />

	<!-- 2. Social Proof Strip -->
	<TestimonialsSection />
	<!-- 7. Process Transparency -->
	<ProcessSteps />
	<!-- 4. Blue Ocean Differentiation -->
	<DifferentiationSection />
	
	<!-- 3b. Specialized Services -->
	<SpecializedServicesSection />
	
	<!-- 5. Areas We Serve -->
	<AreasServed />
	<!-- 9. Recent Work / Case Studies -->
	<TransformationGallery />

		<!-- 10. Final CTA -->
	<section
	  id="quote"
	  class="relative py-20 md:py-24 text-white parallax"
	  style="background-image: url('https://images.unsplash.com/photo-1622015663319-e97e697503ee?q=80&w=1600&auto=format&fit=crop'); background-size: cover; background-position: center; background-attachment: fixed;"
	>
	  <div
		class="absolute inset-0 bg-navy/75 backdrop-blur-sm"
		aria-hidden="true"
	  ></div>
	  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
		  <h2 class="font-serif text-3xl md:text-5xl font-bold text-gold mb-6">
			Ready to scope your clean?
		  </h2>
		  <p class="text-lg text-white/90 max-w-2xl mx-auto mb-8">
			Tell us what needs to be ready, where it is, and what standard matters. HQC will confirm the right cleaning route and quote.
		  </p>
		</div>

		<div class="text-center">
		  <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
			<a
			  href="/quote/"
			  class="px-10 py-5 rounded-lg transition-all duration-300 hover:scale-105 hover:shadow-2xl flex items-center justify-center gap-3 border-2 font-bold text-lg no-underline"
			  style="background-color: var(--color-gold); border-color: white; color: var(--color-navy);"
			>
			  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
				<path d="M14 2v6h6"/>
				<path d="M16 13H8"/>
				<path d="M16 17H8"/>
				<path d="M10 9H8"/>
			  </svg>
			  Request a Cleaning Quote
			</a>
			<a
			  href="/contact/"
			  class="px-10 py-5 rounded-lg transition-all duration-300 hover:scale-105 hover:shadow-2xl flex items-center justify-center gap-3 border-2 font-bold text-lg no-underline"
			  style="background-color: white; border-color: var(--color-gold); color: var(--color-navy);"
			>
			  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.11 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/>
			  </svg>
			  Contact HQC
			</a>
		  </div>
		  <p class="text-white/70 text-sm">
			A scoped quote can cover service type, property condition, access, timing, add-ons and ongoing maintenance if needed.
		  </p>
		</div>
	  </div>
	</section>
  </main>
</Layout>
