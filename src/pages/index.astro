---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ServiceSelector from '../components/ServiceSelector.astro';
import TrustRail from '../components/TrustRail.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import ClientEvidence from '../components/ClientEvidence.astro';
import phase8Copy from '../data/phase8-copy.json';
import { controlledCtaHref } from '../data/controlled-cta-links';
import { offeringImages, sectionImagery } from '../data/section-imagery';
import { libraryPhotos } from '../data/page-visuals';

const homeCopy = phase8Copy.home;
const approvedSections = homeCopy.sections.filter((section) => [
  'Cleaning Defined by the Outcome',
  'Cleaning Services for London Homes',
  'One Cleaning Partner Across Properties, Projects and Portfolios',
  'Cleaning Programmes Built Around the Workplace',
  'Why Clients Choose HQC When the Result Matters'
].includes(section.heading));
const homeSection = (heading: string) => homeCopy.sections.find((section) => section.heading === heading);
const ctaLabels = (heading: string) => (homeSection(heading)?.blocks ?? []).filter((block) => block.kind === 'cta').map((block) => block.text ?? '');
const paragraphs = (heading: string) => (homeSection(heading)?.blocks ?? []).filter((block) => block.kind === 'p').map((block) => block.text ?? '');
// Three core offerings at hero level (6 Nov 2026), in the approved Batch 1 buyer-route order.
const offerings = [
  { eyebrow: 'Property & Facilities', title: 'Managed properties, portfolios and projects', href: '/property-facilities-cleaning-london/', image: offeringImages.complex },
  { eyebrow: 'Workplaces & Commercial', title: 'Recurring programmes and operational resets', href: '/commercial-cleaning-london/', image: offeringImages.workplace },
  { eyebrow: 'Homes & Private Clients', title: 'Maintenance, restoration and moving services', href: '/home-cleaning-london/', image: offeringImages.home }
];
const outcomeImage = sectionImagery['cleaning-prices-london'][0].images[0];
---

<Layout
  title="Professional Cleaning Services London | High Quality Clean"
  description="Professional cleaning services for London homes, workplaces and managed properties. Find the right HQC service for the condition, outcome and work required."
>
  <Header />

  <main class="bg-porcelain pt-20">
    <section class="relative overflow-hidden bg-midnight text-white">
      <div class="absolute inset-0 opacity-[.08]" style="background-image:radial-gradient(circle at 1px 1px,#fff 1px,transparent 0);background-size:34px 34px"></div>
      <div class="relative mx-auto grid min-h-[780px] max-w-[1440px] items-center gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[.92fr_1.08fr] lg:px-14">
        <div class="relative z-10 py-8">
          <p class="section-kicker text-copper">Cleaning Defined by the Outcome</p>
          <h1 class="mt-6 max-w-3xl font-serif text-[clamp(3.8rem,7vw,7.2rem)] font-medium leading-[.88] tracking-[-.045em]">
            The Right Cleaning Service<br /><em class="font-medium text-copper">for the Result You Need</em>
          </h1>
          <ul class="mt-6 grid grid-cols-3 gap-2 lg:hidden" aria-label="Our three core services">
            {offerings.map((offering) => (
              <li>
                <a href={offering.href} class="block text-white no-underline">
                  <img src={offering.image.src} srcset={offering.image.srcset} sizes="33vw" alt={offering.image.alt} class="aspect-[4/3] w-full rounded-lg object-cover object-[70%_50%]" width="800" height="600" fetchpriority="high" />
                  <span class="mt-1.5 block text-[11px] font-bold leading-tight">{offering.eyebrow} <span class="text-copper" aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-8 max-w-xl text-lg leading-8 text-white/75 md:text-xl">From recurring home cleaning to workplace programmes, property handovers and complex projects, High Quality Clean matches the service, labour and delivery approach to the condition of the space and the outcome required.</p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href="#find-my-service" class="button button-primary" data-track="find_my_service">Find my service <span aria-hidden="true">↓</span></a>
            <a href="/request-a-quote/" class="button button-ghost" data-track="request_quote">Request a Cleaning Quote</a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/15 pt-7 text-xs font-semibold uppercase tracking-[.14em] text-white/55">
            <span>London-based</span><span>Outcome-led</span><span>Founder-led</span>
          </div>
        </div>

        <div class="relative z-10 hidden lg:block">
          <ul class="grid gap-4" aria-label="Our three core services">
            {offerings.map((offering) => (
              <li>
                <a href={offering.href} class="group grid grid-cols-[42%_1fr] overflow-hidden rounded-2xl border border-white/15 bg-white/[.05] text-white no-underline transition duration-300 hover:-translate-y-0.5 hover:border-copper sm:grid-cols-[1.15fr_1fr]">
                  <img src={offering.image.src} srcset={offering.image.srcset} sizes="(min-width: 1024px) 380px, 42vw" alt={offering.image.alt} class="aspect-[4/3] h-full w-full object-cover object-[70%_50%] transition duration-700 group-hover:scale-[1.03] sm:aspect-[2/1]" width="800" height="400" fetchpriority="high" />
                  <span class="flex flex-col justify-center p-4 sm:p-6">
                    <span class="text-[11px] font-bold uppercase tracking-[.16em] text-copper sm:text-xs">{offering.eyebrow}</span>
                    <span class="mt-2 font-serif text-xl font-medium leading-tight sm:text-2xl">{offering.title}</span>
                    <span class="mt-3 text-sm font-bold text-white/85">Explore <span class="inline-block text-copper transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24">
        <div>
          <p class="section-kicker">Start with what you need to achieve</p>
          <h2 class="section-title">Tell Us the Result You Need</h2>
          {paragraphs('Start with what you need to achieve').slice(0, 2).map((paragraph) => <p class="mt-7 text-lg leading-8 text-slate">{paragraph}</p>)}
        </div>
        <div class="space-y-4">
          {[
            {
              number: '01',
              eyebrow: 'Property & Facilities',
              title: 'Managed properties, portfolios and projects',
              copy: paragraphs('Start with what you need to achieve')[2],
              cta: ctaLabels('Start with what you need to achieve')[0],
              href: '/property-facilities-cleaning-london/',
              image: '/images/generated/hqc-property-hero.webp',
              alt: 'Empty flat hallway with wooden floors and open doors.'
            },
            {
              number: '02',
              eyebrow: 'Workplaces & Commercial',
              title: 'Recurring programmes and operational resets',
              copy: paragraphs('Start with what you need to achieve')[3],
              cta: ctaLabels('Start with what you need to achieve')[1],
              href: '/commercial-cleaning-london/',
              image: '/images/generated/hqc-office-hero.png',
              alt: 'Meeting room with a long table and a view of the City of London.'
            },
            {
              number: '03',
              eyebrow: 'Homes & Private Clients',
              title: 'Maintenance, restoration and moving services',
              copy: paragraphs('Start with what you need to achieve')[4],
              cta: ctaLabels('Start with what you need to achieve')[2],
              href: '/home-cleaning-london/',
              image: '/images/generated/hqc-home-hero.webp',
              alt: 'Living room with a corner sofa and tall windows.'
            }
          ].map((route) => (
            <a href={route.href} class="group grid min-h-56 overflow-hidden rounded-2xl border border-midnight/10 bg-white text-inherit no-underline transition duration-500 hover:-translate-y-1 hover:border-copper hover:shadow-[0_25px_70px_rgba(14,42,49,.12)] sm:grid-cols-[1fr_15rem]">
              <div class="flex flex-col p-6 md:p-8">
                <div class="flex items-center justify-between"><span class="meta-label">{route.eyebrow}</span><span class="font-serif text-2xl text-copper-ink">{route.number}</span></div>
                <h3 class="mt-8 max-w-xl font-serif text-3xl font-medium leading-tight text-midnight md:text-4xl">{route.title}</h3>
                <p class="mt-4 max-w-xl text-sm leading-6 text-slate">{route.copy}</p>
                <span class="mt-7 font-bold text-midnight">{route.cta} <span class="inline-block text-copper-ink transition group-hover:translate-x-1">→</span></span>
              </div>
              <div class="relative min-h-56 overflow-hidden">
                <img src={route.image} alt={route.alt} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" width="800" height="650" />
                <div class="absolute inset-0 bg-gradient-to-r from-midnight/15 to-transparent"></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ServiceSelector />

    <TrustRail />

    <div data-controlled-copy="Batch 1, page 1">
      {approvedSections.map((section, index) => (
        <section class:list={['py-20 md:py-28', index % 2 ? 'bg-porcelain' : 'bg-white']}>
          <div class="mx-auto grid max-w-[1440px] gap-10 px-5 sm:px-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-20 lg:px-14">
            <div>
              <p class="section-kicker">Cleaning Defined by the Outcome</p>
              <h2 class="section-title">{section.heading}</h2>
              {section.heading === 'Cleaning Defined by the Outcome' && (
                <figure class="mt-8 overflow-hidden rounded-2xl bg-midnight">
                  <img src={outcomeImage.src} srcset={outcomeImage.srcset} sizes="(min-width: 1024px) 480px, 100vw" alt={outcomeImage.alt} class="aspect-[16/10] w-full object-cover" loading="lazy" width="1600" height="1000" />
                </figure>
              )}
            </div>
            <div class="space-y-5 text-lg leading-8 text-slate">
              {section.blocks.map((block) => (
                block.kind === 'h3' ? <h3 class="pt-4 font-serif text-2xl font-medium text-midnight">{block.text}</h3> :
                block.kind === 'ul' ? <ul class="list-disc space-y-2 pl-6">{block.items.map((item) => <li>{item}</li>)}</ul> :
                block.kind === 'cta' ? <p class="text-base"><a href={controlledCtaHref(block.text ?? '')} class="inline-flex font-bold text-midnight no-underline hover:text-copper-ink">{block.text} <span class="ml-2 text-copper-ink" aria-hidden="true">→</span></a></p> :
                block.kind === 'support' ? <p class="font-semibold text-midnight">{block.text}</p> :
                <p>{block.text}</p>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="bg-midnight py-20 text-white md:py-28">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
        <div class="grid items-end gap-10 lg:grid-cols-[1fr_.7fr]">
          <div>
            <p class="section-kicker text-copper">How HQC works</p>
            <h2 class="mt-4 max-w-4xl font-serif text-4xl font-medium leading-[1.02] tracking-tight md:text-7xl">Clarity before anyone picks up a cloth.</h2>
          </div>
          <p class="max-w-xl text-lg leading-8 text-white/65">The condition, access, timing and required finish are captured before the work is confirmed. That means the service can be staffed and delivered responsibly.</p>
        </div>
        <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/15 bg-white/15 lg:grid-cols-5">
          {[
            ['01', 'Site review', 'Understand the outcome, condition, access and operating constraints.'],
            ['02', 'Service profile', 'Define the areas, tasks, frequencies and relevant site requirements.'],
            ['03', 'Mobilisation', 'Confirm access, allocation, equipment and practical controls before delivery.'],
            ['04', 'Delivery', 'Work from the authorised service and property information, not assumptions.'],
            ['05', 'Quality review', 'Review the standard and adjust the service as requirements change.']
          ].map(([number, title, copy], index) => (
            <article class:list={['min-h-72 p-7 md:p-9', index === 2 ? 'bg-copper text-midnight' : 'bg-midnight']}>
              <span class:list={['font-serif text-4xl', index === 2 ? 'text-midnight' : 'text-copper']}>{number}</span>
              <h3 class="mt-16 font-serif text-3xl font-medium">{title}</h3>
              <p class:list={['mt-4 leading-7', index === 2 ? 'text-midnight' : 'text-white/65']}>{copy}</p>
            </article>
          ))}
        </div>
        <a href="/how-we-work/" class="button button-ghost mt-9">See how the service works <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="bg-white py-20 md:py-28">
      <div class="mx-auto grid max-w-[1440px] gap-12 px-5 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:gap-24 lg:px-14">
        <div>
          <p class="section-kicker">Complex service route</p>
          <h2 class="section-title">When Routine Cleaning Is Not Enough</h2>
          {paragraphs('When Routine Cleaning Is Not Enough').map((paragraph) => <p class="mt-7 text-lg leading-8 text-slate">{paragraph}</p>)}
          {ctaLabels('When Routine Cleaning Is Not Enough').map((label) => <a href={controlledCtaHref(label)} class="mt-7 inline-flex font-bold text-midnight no-underline hover:text-copper-ink">{label} <span class="ml-2 text-copper-ink" aria-hidden="true">→</span></a>)}
        </div>
        <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Complex service process">
          {['Qualification', 'Assessment', 'Defined scope', 'Delivery plan', 'Controlled delivery', 'Handover'].map((step, index) => (
            <li class="rounded-2xl border border-midnight/10 bg-porcelain p-6">
              <span class="font-serif text-3xl text-copper-ink">0{index + 1}</span>
              <p class="mt-10 font-serif text-2xl leading-tight text-midnight">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <ClientEvidence id="proof-release-title" />

    <section class="section-shell">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_.85fr] lg:gap-20">
        <div class="grid auto-rows-[210px] grid-cols-2 gap-4 md:auto-rows-[260px]">
          {[libraryPhotos.bedroom, libraryPhotos.livingArea].map((photo) => (
            <figure class="relative row-span-2 overflow-hidden rounded-[2rem]">
              <img src={photo.src} alt={photo.alt} class="h-full w-full object-cover" loading="lazy" width="1536" height="2048" />
            </figure>
          ))}
        </div>
        <div class="flex flex-col justify-center">
          <p class="section-kicker">Evidence, not adjectives</p>
          <h2 class="section-title">The work should be visible.</h2>
          <p class="mt-7 text-lg leading-8 text-slate">Each quotation starts with the property, workplace or project in front of us. Relevant evidence is added only where it is approved for use and helps explain the required outcome.</p>
          <div class="mt-8 grid grid-cols-2 gap-4 border-y border-midnight/10 py-7">
            <div><strong class="font-serif text-5xl font-medium text-midnight">1</strong><span class="mt-1 block text-sm text-slate">clear route from requirement to review</span></div>
            <div><strong class="font-serif text-5xl font-medium text-midnight">3</strong><span class="mt-1 block text-sm text-slate">clear enquiry routes</span></div>
          </div>
          <a href="/reviews-case-studies/" class="mt-8 font-bold text-midnight no-underline">View project evidence <span class="text-copper-ink">→</span></a>
        </div>
      </div>
    </section>

    <section class="overflow-hidden bg-white">
      <div class="mx-auto grid max-w-[1440px] lg:grid-cols-2">
        <div class="flex items-center bg-mist px-5 py-12 sm:px-8">
          <FounderPortrait />
        </div>
        <div class="flex items-center px-5 py-20 sm:px-8 lg:px-20">
          <div>
            <p class="section-kicker">Founder-led</p>
            <h2 class="section-title">Pedro’s Vision for High Quality Clean</h2>
            {paragraphs('Pedro’s Vision for High Quality Clean').map((paragraph) => <p class="mt-7 text-lg leading-8 text-slate">{paragraph}</p>)}
            <p class="mt-7 font-bold text-midnight">Pedro Ndombasi <span class="ml-2 font-normal text-slate">Founder & Managing Director</span></p>
            {ctaLabels('Pedro’s Vision for High Quality Clean').map((label) => <a href={controlledCtaHref(label)} class="button button-dark mt-8">{label} <span aria-hidden="true">→</span></a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-copper py-20 text-midnight">
      <div class="absolute -right-20 -top-40 h-96 w-96 rounded-full border border-midnight/15"></div>
      <div class="relative mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-8 px-5 sm:px-8 md:flex-row md:items-center lg:px-14">
        <div>
          <h2 class="max-w-4xl font-serif text-4xl font-medium leading-tight md:text-6xl">Not Sure Which Cleaning Service You Need?</h2>
          {paragraphs('Not Sure Which Cleaning Service You Need?').map((paragraph) => <p class="mt-4 max-w-2xl text-lg leading-8 text-midnight">{paragraph}</p>)}
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <a href="#find-my-service" class="button button-dark">Find My Service <span aria-hidden="true">↓</span></a>
          <a href="/request-a-quote/" class="button border border-midnight/30 text-midnight hover:border-midnight">Request a Quote</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
