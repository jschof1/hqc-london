---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import OutcomePage from '../components/OutcomePage.astro';
import { outcomePages, type OutcomePage as OutcomePageData } from '../data/outcome-pages';

export const prerender = true;

export function getStaticPaths() {
  return outcomePages
    .filter((page) => !['request-a-quote', 'cleaning-faqs'].includes(page.slug))
    .map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

interface Props {
  page: OutcomePageData;
}

const { page } = Astro.props;
const title = `${page.title} | High Quality Clean`;
const baseUrl = 'https://highqualityclean.co.uk';
const servicePage = ![
  'about-high-quality-clean',
  'why-choose-hqc',
  'how-we-work',
  'cleaning-prices-london',
  'reviews-case-studies',
  'areas-we-cover'
].includes(page.slug);
const pageType: 'AboutPage' | 'CollectionPage' | 'WebPage' | ['CollectionPage', 'WebPage'] = page.slug === 'about-high-quality-clean'
  ? 'AboutPage'
  : page.slug === 'home-cleaning-london'
    ? ['CollectionPage', 'WebPage']
    : ['reviews-case-studies', 'areas-we-cover'].includes(page.slug)
    ? 'CollectionPage'
    : 'WebPage';
const schemaNodes = servicePage ? [{
  '@type': 'Service',
  '@id': `${baseUrl}/${page.slug}/#service`,
  name: page.title,
  description: page.description,
  url: `${baseUrl}/${page.slug}/`,
  serviceType: page.primaryKeyword ?? page.title,
  provider: { '@id': `${baseUrl}/#organization` },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'London'
  }
}] : [];
---

<Layout title={title} description={page.description} pageType={pageType} schemaNodes={schemaNodes}>
  <Header />
  <OutcomePage page={page} />
</Layout>
