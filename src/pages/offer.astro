---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout
  title="30% Off Your First Essential Clean™ | High Quality Clean"
  description="Eligible new clients can receive 30% off their first Essential Clean™ with a three-month weekly or fortnightly commitment."
>
  <Header />
  <main class="min-h-screen bg-mist pt-16">
    <section class="bg-navy px-4 py-20 text-white sm:px-6 md:py-28">
      <div class="mx-auto max-w-5xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-gold">Essential Clean™ introductory offer</p>
        <h1 class="mt-5 font-serif text-4xl md:text-7xl">30% off your first Essential Clean™</h1>
        <p class="mx-auto mt-7 max-w-3xl text-xl leading-relaxed text-white/80">Available to eligible new clients who begin a weekly or fortnightly Essential Clean™ with a three-month commitment.</p>
        <a href="/#find-my-service" class="mt-9 inline-flex min-h-12 items-center rounded-md bg-gold px-8 py-3 font-semibold text-navy no-underline hover:bg-white">Check Whether Your Home Is Suitable</a>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 md:py-24">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-gold/30 bg-white p-8">
          <h2 class="font-serif text-3xl text-navy">The offer applies when</h2>
          <ul class="mt-6 space-y-4 text-ink/75">
            <li>✓ You are a new Essential Clean™ client.</li>
            <li>✓ The home is suitable for routine maintenance cleaning.</li>
            <li>✓ You choose a weekly or fortnightly schedule.</li>
            <li>✓ You make a minimum three-month commitment.</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-gold/30 bg-white p-8">
          <h2 class="font-serif text-3xl text-navy">A manual quote is required when</h2>
          <ul class="mt-6 space-y-4 text-ink/75">
            <li>• The home has heavy build-up or needs restoration.</li>
            <li>• You need Deep Clean™, Move-In Reset™ or End of Tenancy™.</li>
            <li>• You are asking for monthly maintenance.</li>
            <li>• The property or access requirement is large or complex.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-gold px-4 py-14 sm:px-6">
      <div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div><p class="text-sm font-semibold uppercase tracking-wider text-navy/70">Start with suitability</p><h2 class="mt-2 font-serif text-3xl text-navy">Find the correct route in under a minute.</h2></div>
        <a href="/#find-my-service" class="rounded-md bg-navy px-7 py-3 font-semibold text-white no-underline">Find My Service</a>
      </div>
    </section>
  </main>
</Layout>
