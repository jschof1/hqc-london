---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import TransformationGallery from '../components/TransformationGallery.astro';

const featuredStories = [
  {
    title: 'Mr. Edwards, from disappointment to dependability',
    eyebrow: 'Existing client-success story',
    location: 'High-end residential',
    image: '/images/instock/IMG-20250812-WA0015.jpg',
    imageAlt: 'Calm London home interior used as local property imagery',
    challenge: 'Mr. Edwards had been let down by previous cleaners and wanted his home treated with respect, not rushed through as another appointment.',
    response: 'HQC started with a full top-to-bottom clean, protected surfaces properly, focused on detail in the kitchen and bathrooms, and dealt with an early hiccup openly rather than hiding it.',
    outcome: 'The relationship became regular and referral-led because the service rebuilt trust as well as cleanliness.',
    quote: "It wasn't just the clean. It was how you handled the whole situation that made me trust you."
  },
  {
    title: 'Mrs. Dean, a Chelsea home restored before works began',
    eyebrow: 'Existing client-success story',
    location: 'Chelsea renovation project',
    image: '/images/instock/IMG-20250813-WA0030.jpg',
    imageAlt: 'Clean empty property room prepared for handover or works',
    challenge: 'Mrs. Dean was away from London and needed a Chelsea flat cleaned before builders arrived. The first inspection showed the condition was worse than expected.',
    response: 'HQC recorded a video walkthrough, cleaned top to bottom, removed rubbish, restored order and sent a follow-up video so the remote client could see the transformation.',
    outcome: 'That first project led to post-build cleaning, regular maintenance, window cleaning, laundry coordination and trusted on-the-ground property support.',
    quote: 'Please do what you can.'
  },
  {
    title: 'Chelsea property management support',
    eyebrow: 'Supplied story framework, approval-gated',
    location: 'Chelsea flat and remote-client support',
    image: '/images/instock/IMG-20250813-WA0007.jpg',
    imageAlt: 'London property exterior used as local property management imagery',
    challenge: 'The supplied planning copy describes a remote client, a property in poor condition and a need for restoration plus ongoing advice.',
    response: 'The proof-safe version should describe comprehensive restoration, maintenance planning and consultancy support without naming a company or implying an endorsement.',
    outcome: 'This story is useful for showing the property-care direction, but exact wording, photos and permissions should be confirmed before publishing more detail.',
    quote: 'Supplied story copy, publish exact details only when approved.'
  }
];

const conciergeCare = [
  {
    title: 'Archie and pet-care support',
    text: 'Supplied copy describes a Wandsworth client who needed dog care, feeding, attention and a simple security check while travelling. This should be positioned as concierge support arranged by agreement.'
  },
  {
    title: 'Belgravia repair coordination',
    text: 'Supplied copy describes window-repair support after a maintenance issue, including inspection coordination, contractor liaison, security and reporting. Keep exact client details permission-gated.'
  },
  {
    title: 'Wellness-centre technical advice',
    text: 'The LowLu consultation story is referenced in the planning copy. Until permission is confirmed, the safe public wording is technical support for a wellness-space operator rather than a named endorsement.'
  }
];
---

<Layout
  title="Cleaning Case Studies | High Quality Clean London"
  description="Founder-led High Quality Clean case studies and proof-safe client stories for London homes, Chelsea property support, turnovers and concierge care."
>
  <Header />

  <main class="page-transition pt-16">
    <HeroSection
      title="Case studies with real proof, carefully told"
      subtitle="Named client stories are used where they already exist in HQC copy. Approval-gated examples are framed cautiously, without invented badges, client logos or unsupported claims."
      imageSrc="/images/instock/IMG-20250812-WA0018.jpg"
      imageAlt="Premium London apartment interior prepared for calm property care"
      primaryCta={{
        text: 'Read Featured Stories',
        href: '#featured-stories'
      }}
      secondaryCta={{
        text: 'Request Your Personalised Quote',
        href: '/quote/',
        icon: 'fas fa-paper-plane'
      }}
      trustBadges={[
        { icon: 'fas fa-book-open', text: 'Existing stories first' },
        { icon: 'fas fa-camera', text: 'Local proof imagery' },
        { icon: 'fas fa-shield-alt', text: 'Approval-gated claims' }
      ]}
      backgroundClass="bg-night"
    />

    <section id="featured-stories" class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Featured proof</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
            Client stories that show the HQC standard
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-ink/74">
            These stories focus on the practical pattern: listen carefully, scope properly, communicate clearly and leave the client with more trust than they had at the start.
          </p>
        </div>

        <div class="mt-14 space-y-10">
          {featuredStories.map((story, index) => (
            <article class="grid overflow-hidden rounded-[2rem] border border-stone bg-porcelain shadow-soft lg:grid-cols-2">
              <div class={index % 2 === 1 ? 'lg:order-2' : ''}>
                <img
                  src={story.image}
                  alt={story.imageAlt}
                  class="h-full min-h-[22rem] w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-6 md:p-10">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{story.eyebrow}</p>
                <h3 class="mt-3 font-serif text-3xl font-semibold text-night">{story.title}</h3>
                <p class="mt-2 text-sm font-semibold text-ink/58">{story.location}</p>
                <div class="mt-6 grid gap-5 text-ink/74">
                  <div>
                    <h4 class="font-semibold text-night">Challenge</h4>
                    <p class="mt-2 leading-relaxed">{story.challenge}</p>
                  </div>
                  <div>
                    <h4 class="font-semibold text-night">HQC response</h4>
                    <p class="mt-2 leading-relaxed">{story.response}</p>
                  </div>
                  <div>
                    <h4 class="font-semibold text-night">Outcome</h4>
                    <p class="mt-2 leading-relaxed">{story.outcome}</p>
                  </div>
                </div>
                <blockquote class="mt-6 rounded-2xl border-l-4 border-brass bg-white p-5 font-serif text-xl text-night">
                  “{story.quote}”
                </blockquote>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <TransformationGallery
      title="Local proof images, not borrowed stock"
      subtitle="Before-after details, local property imagery and team-at-work photos are used as grounded proof points. Any illustrative image should remain labelled as context, not a completed client claim."
      ctaText="Read more client success stories"
      ctaLink="/client-success-stories/"
    />

    <section class="bg-porcelain py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Beyond cleaning</p>
            <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
              Concierge care examples ready for approval
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-ink/74">
              These examples are useful because they show how HQC can step in around the home, not just clean it. They should remain proof-safe until photos, permissions and exact wording are signed off.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-3">
            {conciergeCare.map((item) => (
              <article class="rounded-[1.5rem] border border-stone bg-white p-6 shadow-soft-sm">
                <h3 class="font-serif text-2xl font-semibold text-night">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink/72">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-night py-20 text-white md:py-24">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Start with your scope</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold md:text-5xl">
          Tell us what calm needs to look like in your property.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-white/78">
          Share the property type, location, access notes and what matters most. We will recommend the right route rather than forcing every home into the same package.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/quote/" class="inline-flex items-center justify-center rounded-md bg-brass px-6 py-3 text-sm font-semibold text-night transition-colors hover:bg-brass/90">
            Request Your Personalised Quote
          </a>
          <a href="/client-success-stories/" class="inline-flex items-center justify-center rounded-md border border-brass px-6 py-3 text-sm font-semibold text-brass transition-colors hover:bg-white/10">
            Browse success stories
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
