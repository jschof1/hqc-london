<script>
// Case studies functionality is now handled by the main.js script
// which automatically initializes when navigating to this page
document.addEventListener('DOMContentLoaded', function() {
  // Update copyright year
  const yearElement = document.getElementById("current-year");
  if (yearElement) {
    yearElement.textContent = String(new Date().getFullYear());
  }
  
  // Prevent conflicts with old modal implementations
  // Remove any conflicting modal elements that might exist
  const oldModal = document.getElementById('imageModal');
  if (oldModal) {
    oldModal.remove();
    console.log('🧹 Removed conflicting old modal');
  }
  
  // Ensure only our gallery modal functionality is active
  const existingModalHandlers = document.querySelectorAll('.masonry-item[data-old-handler]');
  existingModalHandlers.forEach(item => {
    // Remove old event listeners by cloning and replacing the element
    const newItem = item.cloneNode(true);
    const parent = item.parentNode;
    if (parent) {
      parent.replaceChild(newItem, item);
    }
  });
});
</script>
