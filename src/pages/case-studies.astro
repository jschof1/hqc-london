---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import IntroRateBanner from '../components/IntroRateBanner.astro';
---

<Layout 
  title="Cleaning Case Studies & Gallery | High Quality Clean London"
  description="Cleaning examples and service gallery for London homes, tenancy resets, property preparation and commercial spaces. See the types of work HQC can scope."
>
  <Header />

  <main class="page-transition pt-16 relative">
    <!-- Hero Section -->
     <HeroSection 
       title="Case Studies & Gallery"
       subtitle="Browse practical examples of the spaces HQC can clean, from homes and kitchens to bathrooms, move-out resets and managed-property preparation."
       imageSrc="/images/luxury-home/luxury-home-1.jpg"
       imageAlt="Clean home interior showcase"
       primaryCta={{
         text: "View Featured Work",
         href: "#featured-case"
       }}
       secondaryCta={{
         text: "Browse Gallery",
         href: "#gallery",
         icon: "fas fa-th"
       }}
       trustBadges={[]}
     />
    <IntroRateBanner />

    <!-- Featured Case Study -->
    <section id="featured-case" class="py-20 sm:py-24 bg-white fade-in">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-navy mb-4">Example Cleaning Scope</h2>
          <p class="text-lg max-w-3xl mx-auto" style="color: rgba(14, 14, 16, 0.7);">
            An example of how a larger home clean can be scoped before a deadline
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
          <!-- Before/After Comparison -->
          <div>
            <div class="ba-container" style="aspect-ratio: 4/3;">
              <img
                class="ba-svg"
                src="/images/before-after/transformation-mayfair-improved.png"
                alt="Kitchen before deep cleaning - showing daily wear and accumulated grime"
                loading="lazy"
              />
              <div class="ba-after-wrap" style="width: 50%">
                <img
                  class="ba-svg"
                  src="/images/before-after/transformation-mayfair.png"
                  alt="Kitchen after comprehensive cleaning - gleaming surfaces and pristine finish"
                  loading="lazy"
                />
              </div>
              <div class="ba-handle" style="left: 50%">
                <div class="ba-dot"></div>
              </div>
            </div>
            <div class="mt-4 flex justify-between text-sm" style="color: rgba(14, 14, 16, 0.6);">
              <span>← Before</span>
              <span>After →</span>
            </div>
          </div>

          <!-- Case Study Details -->
          <div>
            <div class="mb-6">
              <h3 class="font-serif text-2xl text-navy mb-2">Larger Home Deep Clean</h3>
              <p class="text-gold font-medium mb-4">Deep clean • Multi-room property • Deadline-led preparation</p>
            </div>

            <div class="space-y-4 mb-8">
              <div>
                <h4 class="font-semibold text-navy mb-2">The Challenge</h4>
                <p style="color: rgba(14, 14, 16, 0.7);">
                  A lived-in property needed a clear cleaning plan before guests arrived. The priority was to agree rooms, surfaces, access and timing before work started.
                </p>
              </div>

              <div>
                <h4 class="font-semibold text-navy mb-2">Our Solution</h4>
                <p style="color: rgba(14, 14, 16, 0.7);">
                  The scope focused on kitchens, bathrooms, high-touch areas, visible dust, floors and final presentation, with any delicate surfaces flagged before cleaning.
                </p>
              </div>

              <div>
                <h4 class="font-semibold text-navy mb-2">Results</h4>
                <p style="color: rgba(14, 14, 16, 0.7);">
                  The property was prepared against the agreed checklist, with practical attention to the rooms and surfaces that mattered most for the deadline.
                </p>
              </div>
            </div>

            <!-- Scope Note -->
            <div class="testimonial-card rounded-xl p-6">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-[60px] h-[60px] rounded-full border-2 border-gold bg-gold/10 flex items-center justify-center">
                  <i class="fas fa-clipboard-check text-gold text-xl" aria-hidden="true"></i>
                </div>
                <div>
                  <h5 class="font-semibold text-navy">Proof note</h5>
                  <p class="text-sm" style="color: rgba(14, 14, 16, 0.6);">Example scope, not a named client claim</p>
                </div>
              </div>
              <blockquote class="text-navy italic">
                This page uses general cleaning examples while named client case studies, review counts and regulated proof claims remain subject to evidence and approval.
              </blockquote>
            </div>
          </div>
        </div>

        <!-- Additional Images Grid -->
        <div class="grid md:grid-cols-3 gap-6">
          <figure class="gallery-item">
            <img
              src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=400&h=300&fit=crop&crop=center&q=80"
              alt="Pristine kitchen with gleaming marble countertops"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Kitchen Restoration</h3>
                <p>Carrara marble deep-cleaned and sealed</p>
              </div>
            </div>
          </figure>

          <figure class="gallery-item">
            <img
              src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=400&h=300&fit=crop&crop=center&q=80"
              alt="Elegant living room with restored period features"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Drawing Room</h3>
                <p>Period furniture and antiques carefully restored</p>
              </div>
            </div>
          </figure>

          <figure class="gallery-item">
            <img
              src="https://images.unsplash.com/photo-1620626011761-996317b8d101?w=400&h=300&fit=crop&crop=center&q=80"
              alt="Luxurious bathroom with gleaming fixtures"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Master Bathroom</h3>
                <p>Victorian fixtures polished to perfection</p>
              </div>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <!-- Client Portfolio Gallery -->
    <section id="gallery" class="py-20 sm:py-24 bg-mist fade-in">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-navy mb-4">Client Portfolio</h2>
          <p class="text-lg max-w-3xl mx-auto mb-8" style="color: rgba(14, 14, 16, 0.7);">
            A curated selection of our finest work across London's most prestigious addresses
          </p>
          
          <!-- Filter Buttons -->
          <div class="flex flex-wrap justify-center gap-4 mb-12">
            <button class="filter-btn active px-6 py-2 rounded-full border border-gold bg-gold text-navy font-medium transition-all" data-filter="all">
              All Projects
            </button>
            <button class="filter-btn px-6 py-2 rounded-full border border-gold text-gold bg-white font-medium transition-all hover:bg-gold hover:text-navy" data-filter="kitchen">
              Kitchens
            </button>
            <button class="filter-btn px-6 py-2 rounded-full border border-gold text-gold bg-white font-medium transition-all hover:bg-gold hover:text-navy" data-filter="bathroom">
              Bathrooms
            </button>
            <button class="filter-btn px-6 py-2 rounded-full border border-gold text-gold bg-white font-medium transition-all hover:bg-gold hover:text-navy" data-filter="living">
              Living Areas
            </button>
            <button class="filter-btn px-6 py-2 rounded-full border border-gold text-gold bg-white font-medium transition-all hover:bg-gold hover:text-navy" data-filter="exterior">
              Exteriors
            </button>
          </div>
        </div>

        <!-- Masonry Gallery -->
        <div class="masonry" id="gallery-container">
          <!-- Kitchen Items -->
          <article class="masonry-item gallery-item" data-category="kitchen" data-index="0">
            <img
              src="/images/luxury-home/Mayfair_penthouse_kitchen_with_beautiful_marble.png"
              alt="Clean kitchen with polished surfaces and appliances"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Mayfair Penthouse Kitchen</h3>
                <p>Signature Clean™ • Marble restoration • 6 hours</p>
                <div class="project-details">
                  <span class="badge">Kitchen</span>
                  <span class="location">Mayfair, London</span>
                </div>
              </div>
            </div>
          </article>

          <article class="masonry-item gallery-item" data-category="kitchen" data-index="1">
            <img
              src="/images/luxury-home/Chelsea_Mews_house_in_London_with_spotless_wind.png"
              alt="Modern kitchen island with gleaming quartz countertops"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Chelsea Townhouse</h3>
                <p>Deep clean • Kitchen surfaces • Scope by enquiry</p>
                <div class="project-details">
                  <span class="badge">Kitchen</span>
                  <span class="location">Chelsea, London</span>
                </div>
              </div>
            </div>
          </article>

          <!-- Bathroom Items -->
          <article class="masonry-item gallery-item" data-category="bathroom" data-index="2">
            <img
              src="/images/luxury-home/Belgravia_bathroom_with_beautiful_stone.png"
              alt="Spa-like bathroom with immaculate fixtures and surfaces"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Belgravia Master Bath</h3>
                <p>Signature Clean™ • Tile restoration • 4 hours</p>
                <div class="project-details">
                  <span class="badge">Bathroom</span>
                  <span class="location">Belgravia, London</span>
                </div>
              </div>
            </div>
          </article>

          <article class="masonry-item gallery-item" data-category="bathroom" data-index="3">
            <img
              src="/images/luxury-home/luxurious-kensington-ensuite.png"
              alt="Clean bathroom vanity with spotless mirror and fixtures"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Kensington Ensuite</h3>
                <p>Essentials Clean™ • Weekly service • 2 hours</p>
                <div class="project-details">
                  <span class="badge">Bathroom</span>
                  <span class="location">Kensington, London</span>
                </div>
              </div>
            </div>
          </article>

          <!-- Living Areas -->
          <article class="masonry-item gallery-item" data-category="living" data-index="4">
            <img
              src="/images/luxury-home/richmond-living-room.png"
              alt="Elegant living room with pristine upholstery and polished surfaces"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Knightsbridge Drawing Room</h3>
                <p>Living area clean • Dust and surface care • Scope by enquiry</p>
                <div class="project-details">
                  <span class="badge">Living Area</span>
                  <span class="location">Knightsbridge, London</span>
                </div>
              </div>
            </div>
          </article>

          <article class="masonry-item gallery-item" data-category="living" data-index="5">
            <img
              src="/images/luxury-home/mayfair-home-hallway.png"
              alt="Modern living space with immaculate glass surfaces and furniture"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Mayfair Apartment</h3>
                <p>Signature Clean™ • Glass specialist • 3 hours</p>
                <div class="project-details">
                  <span class="badge">Living Area</span>
                  <span class="location">Mayfair, London</span>
                </div>
              </div>
            </div>
          </article>

          <!-- Exterior Items -->
          <article class="masonry-item gallery-item" data-category="exterior" data-index="6">
            <img
              src="/images/luxury-home/belgravia-stonework.png"
              alt="Pristine Georgian townhouse exterior with cleaned stonework"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Belgravia Townhouse</h3>
                <p>Exterior restoration • Stone cleaning • 12 hours</p>
                <div class="project-details">
                  <span class="badge">Exterior</span>
                  <span class="location">Belgravia, London</span>
                </div>
              </div>
            </div>
          </article>

          <article class="masonry-item gallery-item" data-category="exterior" data-index="7">
            <img
              src="/images/luxury-home/Chelsea_Mews_house_in_London_with_spotless_wind.png"
              alt="Chelsea mews house with spotless exterior details"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Chelsea Mews</h3>
                <p>Pressure washing • Window cleaning • 6 hours</p>
                <div class="project-details">
                  <span class="badge">Exterior</span>
                  <span class="location">Chelsea, London</span>
                </div>
              </div>
            </div>
          </article>

          <!-- Additional Items -->
          <article class="masonry-item gallery-item" data-category="kitchen" data-index="8">
            <img
              src="/images/luxury-home/Mayfair_penthouse_kitchen_with_beautiful_marble.png"
              alt="Contemporary kitchen with pristine stainless steel appliances"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Hyde Park Apartment</h3>
                <p>Kitchen clean • Appliance detail • Scope by enquiry</p>
                <div class="project-details">
                  <span class="badge">Kitchen</span>
                  <span class="location">Hyde Park, London</span>
                </div>
              </div>
            </div>
          </article>

          <article class="masonry-item gallery-item" data-category="living" data-index="9">
            <img
              src="https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?w=400&h=380&fit=crop&crop=center&q=80"
              alt="Clean bedroom with tidy linens and surfaces"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <div class="gallery-overlay-content">
                <h3>Mayfair Master Suite</h3>
                <p>Signature Clean™ • Textile care • 3 hours</p>
                <div class="project-details">
                  <span class="badge">Living Area</span>
                  <span class="location">Mayfair, London</span>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Cleaning Routes -->
    <section class="py-20 sm:py-24 bg-navy text-white fade-in">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-gold mb-4">Common Cleaning Routes</h2>
          <p class="text-lg max-w-3xl mx-auto" style="color: rgba(255, 255, 255, 0.8);">
            Use these examples to choose the closest route before requesting a quote.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <article class="testimonial-card rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-[60px] h-[60px] rounded-full border-2 border-gold bg-gold/10 flex items-center justify-center">
                <i class="fas fa-home text-gold text-xl" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gold">Home Cleaning</h3>
                <p class="text-sm" style="color: rgba(255, 255, 255, 0.7);">Regular or one-off domestic scopes</p>
              </div>
            </div>
            <blockquote class="text-white mb-4">
              Kitchens, bathrooms, bedrooms, living areas, floors and high-touch points can be scoped around the household routine.
            </blockquote>
          </article>

          <article class="testimonial-card rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-[60px] h-[60px] rounded-full border-2 border-gold bg-gold/10 flex items-center justify-center">
                <i class="fas fa-key text-gold text-xl" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gold">Tenancy & Move-Out</h3>
                <p class="text-sm" style="color: rgba(255, 255, 255, 0.7);">Checkout, re-let and handover support</p>
              </div>
            </div>
            <blockquote class="text-white mb-4">
              Scope can include kitchens, appliances, bathrooms, internal surfaces, floors and final presentation before review.
            </blockquote>
          </article>

          <article class="testimonial-card rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-[60px] h-[60px] rounded-full border-2 border-gold bg-gold/10 flex items-center justify-center">
                <i class="fas fa-building text-gold text-xl" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gold">Commercial Spaces</h3>
                <p class="text-sm" style="color: rgba(255, 255, 255, 0.7);">Offices, shared areas and client-facing rooms</p>
              </div>
            </div>
            <blockquote class="text-white mb-4">
              Routines can be planned around opening hours, access notes, washrooms, kitchens, bins, meeting rooms and reception areas.
            </blockquote>
          </article>
        </div>
      </div>
    </section>

    <!-- Service Showcase -->
    <section class="py-20 sm:py-24 bg-white fade-in">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-navy mb-4">How Scopes Are Planned</h2>
          <p class="text-lg max-w-3xl mx-auto" style="color: rgba(14, 14, 16, 0.7);">
            A useful cleaning quote starts with the property type, access, deadline and the rooms or shared areas that matter most.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Service Feature 1 -->
          <div class="text-center">
            <div class="w-20 h-20 bg-gold rounded-2xl flex items-center justify-center shadow-lg mx-auto mb-6">
              <i class="fas fa-leaf text-white text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="font-semibold text-navy text-xl mb-3">Surface Notes</h3>
            <p style="color: rgba(14, 14, 16, 0.7);">
              Flag delicate materials, appliances, limescale, heavy dust, pets or any products that should not be used.
            </p>
          </div>

          <!-- Service Feature 2 -->
          <div class="text-center">
            <div class="w-20 h-20 bg-navy rounded-2xl flex items-center justify-center shadow-lg mx-auto mb-6">
              <i class="fas fa-users text-white text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="font-semibold text-navy text-xl mb-3">Access Details</h3>
            <p style="color: rgba(14, 14, 16, 0.7);">
              Share parking, keys, building contact, alarm and timing notes before the clean is booked.
            </p>
          </div>

          <!-- Service Feature 3 -->
          <div class="text-center">
            <div class="w-20 h-20 bg-gold rounded-2xl flex items-center justify-center shadow-lg mx-auto mb-6">
              <i class="fas fa-shield text-white text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="font-semibold text-navy text-xl mb-3">Priority Areas</h3>
            <p style="color: rgba(14, 14, 16, 0.7);">
              Agree the must-finish areas first, especially for move-outs, viewings, commercial openings and deadline-led work.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof-Gated Stories Section -->
    <section class="py-20 sm:py-24 bg-navy text-white fade-in">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-gold mb-4">Case Study Approval</h2>
          <p class="text-lg max-w-3xl mx-auto" style="color: rgba(255, 255, 255, 0.8);">
            Named client stories, testimonials, review counts and regulated proof claims should only be published once evidence and permission are confirmed.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          <div class="testimonial-card rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-gold rounded-full flex items-center justify-center">
                <i class="fas fa-user text-navy text-lg" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gold">Home Examples</h3>
                <p class="text-sm" style="color: rgba(255, 255, 255, 0.7);">Publish only with approval</p>
              </div>
            </div>
            <blockquote class="text-white mb-4">
              Home examples can be added once photos, consent and wording have been checked.
            </blockquote>
          </div>

          <div class="testimonial-card rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-gold rounded-full flex items-center justify-center">
                <i class="fas fa-home text-navy text-lg" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gold">Property Examples</h3>
                <p class="text-sm" style="color: rgba(255, 255, 255, 0.7);">Keep claims evidence-backed</p>
              </div>
            </div>
            <blockquote class="text-white mb-4">
              Agent, landlord and property-manager examples should avoid named clients unless permission is explicit.
            </blockquote>
          </div>

          <div class="testimonial-card rounded-xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 bg-gold rounded-full flex items-center justify-center">
                <i class="fas fa-cogs text-navy text-lg" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gold">Commercial Examples</h3>
                <p class="text-sm" style="color: rgba(255, 255, 255, 0.7);">Confirm before naming businesses</p>
              </div>
            </div>
            <blockquote class="text-white mb-4">
              Office and business examples can describe the cleaning route without implying certification or client endorsement.
            </blockquote>
          </div>
        </div>

        <div class="text-center">
          <a
            href="/contact/"
            class="inline-flex items-center px-8 py-4 bg-gold text-navy font-semibold rounded-lg border border-gold btn-hover focus-visible"
          >
            <i class="fas fa-book-open mr-2" aria-hidden="true"></i>
            Discuss a Cleaning Scope
          </a>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20 md:py-24 bg-mist fade-in">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-serif text-3xl md:text-4xl text-navy mb-4">
          Ready to Scope Your Clean?
        </h2>
        <p class="text-lg max-w-3xl mx-auto mb-8" style="color: rgba(14, 14, 16, 0.7);">
          Tell us the property type, postcode, access details and deadline so the enquiry can be routed to the right service.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/#quote"
            class="inline-flex items-center px-8 py-4 bg-gold text-navy font-semibold rounded-lg border border-gold btn-hover focus-visible"
          >
            <i class="fas fa-calendar-check mr-2" aria-hidden="true"></i>
            Request a Cleaning Quote
          </a>
          <a
            href="/process/"
            class="inline-flex items-center px-8 py-4 border-2 border-gold text-gold font-semibold rounded-lg btn-hover focus-visible bg-white"
          >
            <i class="fas fa-info-circle mr-2" aria-hidden="true"></i>
            Learn About Our Process
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Gallery Carousel Modal -->
  <div id="galleryModal" class="modal">
    <div class="modal-header">
      <button class="modal-close" aria-label="Close gallery">&times;</button>
