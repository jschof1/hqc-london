---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import IntroRateBanner from '../components/IntroRateBanner.astro';

// Import area data from JSON file
import areaData from '../data/area-data.json';

// Convert area data to array with slugs for easier rendering
const areas = Object.entries(areaData).map(([slug, data]) => ({
  name: data.name,
  slug: slug,
  image: data.heroImage,
  region: data.region,
  postcodes: data.postcodes,
  description: data.aboutArea.content[0].substring(0, 150) + '...'
}));
---

<Layout
  title="Cleaning Areas Across London & Surrey | High Quality Clean"
  description="Home, tenancy, office, property and facilities cleaning across London and selected Surrey areas. Check coverage and request a practical quote."
>
  <Header />

  <main class="page-transition pt-16">
    <!-- Page Header -->
    <HeroSection
      title="Cleaning Coverage Across London and Surrey"
      subtitle="Find the right route for home cleaning, tenancy resets, office cleaning, property management and facilities support."
      imageSrc="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1600&q=80"
      imageAlt="London skyline and neighbourhood coverage for cleaning services"
      primaryCta={{
        text: "Explore Our Coverage",
        href: "#coverage"
      }}
      secondaryCta={{
        text: "Request a Quote",
        href: "/quote/",
        icon: "fas fa-calendar-alt"
      }}
      trustBadges={[
        { icon: "fas fa-map-marked-alt", text: "London & Surrey areas" },
        { icon: "fas fa-home", text: "Home and property routes" },
        { icon: "fas fa-building", text: "Commercial enquiries" }
      ]}
      backgroundClass="bg-navy relative"
    />
    <IntroRateBanner />

    <!-- Coverage Overview -->
    <section id="coverage" class="py-16 md:py-20 bg-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl md:text-3xl text-navy">Our London Coverage</h2>
          <p class="mt-3 text-ink/70 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
            Coverage for homes, flats, offices, managed properties and move-out cleans across Central, West, North and South London.
          </p>
        </div>

        <!-- Coverage Map Visual -->
        <div class="coverage-map rounded-2xl p-8 mb-12">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="space-y-2">
              <div class="w-16 h-16 mx-auto bg-gold/20 rounded-full flex items-center justify-center">
                <i class="fas fa-crown text-gold text-2xl"></i>
              </div>
              <h3 class="font-semibold text-navy">Central London</h3>
              <p class="text-xs text-ink/70">Mayfair, Belgravia, Knightsbridge</p>
            </div>
            <div class="space-y-2">
              <div class="w-16 h-16 mx-auto bg-gold/20 rounded-full flex items-center justify-center">
                <i class="fas fa-landmark text-gold text-2xl"></i>
              </div>
              <h3 class="font-semibold text-navy">West London</h3>
              <p class="text-xs text-ink/70">Kensington, Chelsea, Notting Hill</p>
            </div>
            <div class="space-y-2">
              <div class="w-16 h-16 mx-auto bg-gold/20 rounded-full flex items-center justify-center">
                <i class="fas fa-tree text-gold text-2xl"></i>
              </div>
              <h3 class="font-semibold text-navy">North London</h3>
              <p class="text-xs text-ink/70">Hampstead, Highgate, Primrose Hill</p>
            </div>
            <div class="space-y-2">
              <div class="w-16 h-16 mx-auto bg-gold/20 rounded-full flex items-center justify-center">
                <i class="fas fa-water text-gold text-2xl"></i>
              </div>
              <h3 class="font-semibold text-navy">South London</h3>
              <p class="text-xs text-ink/70">Clapham, Battersea, Wandsworth</p>
            </div>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center p-4 bg-mist rounded-xl border border-gold/30">
            <div class="text-2xl font-bold text-gold">15+</div>
            <div class="text-sm text-navy">Listed Areas</div>
          </div>
          <div class="text-center p-4 bg-mist rounded-xl border border-gold/30">
