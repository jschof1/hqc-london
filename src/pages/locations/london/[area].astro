---
import { isIllustrativeImage, illustrativeAlt } from '../../../data/card-imagery';
import Layout from '../../../layouts/Layout.astro';
import areaData from '../../../data/area-data.json';
import Header from '../../../components/Header.astro';
import MotionKit from '../../../components/MotionKit.astro';
import '../../../styles/utility-pages.css';

export const prerender = true;

export async function getStaticPaths() {
  const typedAreaData = areaData as Record<string, any>;

  return Object.entries(typedAreaData)
    .filter(([, info]) => info.region !== 'Surrey')
    .map(([areaKey, areaInfo]) => ({
      params: { area: areaKey.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase() },
      props: { areaInfo }
    }));
}

const { area } = Astro.params;
const { areaInfo } = Astro.props;
const typedAreaData = areaData as Record<string, any>;
const pageTitle = `Cleaning Services ${areaInfo.name} | High Quality Clean`;
const metaDescription = `Professional cleaning for suitable homes, workplaces and managed properties in ${areaInfo.name}. Find the right HQC service and check local availability.`;
const quoteHref = `/request-a-quote/?area=${encodeURIComponent(areaInfo.name)}`;

const nearbyAreaSlugs: Record<string, string[]> = {
  mayfair: ['belgravia', 'knightsbridge', 'chelsea', 'kensington'],
  belgravia: ['mayfair', 'knightsbridge', 'chelsea', 'kensington'],
  knightsbridge: ['belgravia', 'mayfair', 'chelsea', 'kensington'],
  kensington: ['chelsea', 'knightsbridge', 'holland-park', 'notting-hill'],
  chelsea: ['kensington', 'belgravia', 'knightsbridge', 'battersea'],
  'notting-hill': ['holland-park', 'kensington', 'st-johns-wood', 'mayfair'],
  'holland-park': ['notting-hill', 'kensington', 'chelsea', 'mayfair'],
  hampstead: ['highgate', 'primrose-hill', 'st-johns-wood', 'notting-hill'],
  highgate: ['hampstead', 'primrose-hill', 'st-johns-wood', 'notting-hill'],
  'primrose-hill': ['st-johns-wood', 'hampstead', 'highgate', 'notting-hill'],
  'st-johns-wood': ['primrose-hill', 'hampstead', 'notting-hill', 'mayfair'],
  clapham: ['battersea', 'wandsworth', 'chelsea', 'belgravia'],
  battersea: ['clapham', 'wandsworth', 'chelsea', 'belgravia'],
  wandsworth: ['battersea', 'clapham', 'chelsea', 'kensington']
};

const nearbyAreas = (nearbyAreaSlugs[area ?? ''] ?? []).map((slug) => {
  const entry = Object.entries(typedAreaData).find(([key]) => key.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase() === slug);
  return { name: entry?.[1]?.name ?? slug, slug, image: entry?.[1]?.heroImage };
});

const schema = {
  '@type': 'Service',
  name: `Professional cleaning services in ${areaInfo.name}`,
  serviceType: 'Professional cleaning enquiry review',
  image: areaInfo.heroImage,
  '@id': `https://highqualityclean.co.uk/locations/london/${area}/#service`,
  url: `https://highqualityclean.co.uk/locations/london/${area}/`,
  provider: { '@id': 'https://highqualityclean.co.uk/#organization' },
  areaServed: {
    '@type': 'Place',
    name: [areaInfo.name, ...areaInfo.postcodes]
  }
};
---

<Layout title={pageTitle} description={metaDescription} schemaNodes={[schema]}>
  <Header />
  <MotionKit />

  <main class="hm-page utility-page utility-location page-transition pt-20">
    <section class="utility-location-hero hm-dark relative bg-midnight text-white">
      <div class="utility-location-photo">
        <img src={areaInfo.heroImage} alt={illustrativeAlt(areaInfo.heroImage, `Homes and properties in ${areaInfo.name)}`} class="h-full w-full object-cover" />{isIllustrativeImage(areaInfo.heroImage) && <span class="image-disclosure">Illustrative</span>}

      </div>

      <div class="utility-shell utility-location-hero-grid relative">
        <div>
          <p class="section-kicker hm-kicker-line mb-6 text-gold">
            <i class="fas fa-map-marker-alt mr-2"></i>{areaInfo.name} · {areaInfo.postcodes.join(', ')}
          </p>
          <h1 class="mb-6 font-serif text-4xl leading-tight text-white sm:text-5xl lg:text-6xl">Professional Cleaning Services in {areaInfo.name}</h1>
          <p class="max-w-2xl text-xl leading-relaxed text-white/85">HQC supports suitable homes, workplaces and managed properties in {areaInfo.name}, subject to service requirements, scheduling and team availability.</p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href={quoteHref} class="hm-cta-link">Check Availability in {areaInfo.name} <span class="hm-cta-chip" aria-hidden="true"></span></a>
            <a href="/#find-my-service" class="hm-cta-link hm-cta-secondary">Find My Service <span class="hm-cta-chip" aria-hidden="true"></span></a>
          </div>
        </div>


      </div>
    </section>

    <section class="utility-shell py-16" aria-label="Find your cleaning service">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Homes', '/home-cleaning-london/'],
          ['Property & Facilities', '/property-facilities-cleaning-london/'],
          ['Workplaces', '/commercial-cleaning-london/'],
          ['Complex requirements', '/complex-property-cleaning-london/']
        ].map(([label, href]) => <a href={href} class="hm-cta-link">{label}<span class="hm-cta-chip" aria-hidden="true">→</span></a>)}
      </div>
    </section>

    <section class="utility-steps-band hm-dark bg-midnight text-white">
        <aside class="utility-review-steps utility-shell grid gap-4" aria-label="Quote review steps">
          <div class="utility-review-step flex gap-4 p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-navy"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="3" width="8" height="4" rx="1"/><path d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 12h8M8 16h5"/></svg></span>
            <div><h2 class="font-serif text-xl text-white">Explain the outcome</h2><p class="mt-1 text-sm leading-6 text-white/70">Choose the service route and describe the result you need.</p></div>
          </div>
          <div class="utility-review-step flex gap-4 p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-navy"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg></span>
            <div><h2 class="font-serif text-xl text-white">Share property context</h2><p class="mt-1 text-sm leading-6 text-white/70">Include the address, approximate size, condition, access and parking details.</p></div>
          </div>
          <div class="utility-review-step flex gap-4 p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-navy"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11a7 7 0 0 1-7 7H7l-4 3V5a2 2 0 0 1 2-2h9a7 7 0 0 1 7 8ZM7 8h10M7 12h7"/></svg></span>
            <div><h2 class="font-serif text-xl text-white">Receive a considered response</h2><p class="mt-1 text-sm leading-6 text-white/70">The enquiry is reviewed against the work requested before a quotation is discussed.</p></div>
          </div>
        </aside>
    </section>

    <section id="what-to-share" class="utility-location-details bg-white">
      <div class="utility-shell utility-location-details-grid grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
        <div class="utility-location-plan">
          <p class="section-kicker" data-reveal="fade">Plan the enquiry</p>
          <h2 class="section-title mt-4 max-w-3xl font-serif text-navy" data-reveal="title">Useful detail for a {areaInfo.name} home-cleaning review</h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate" data-reveal>The quickest route to a considered response is a clear picture of the property and what needs to be ready. Postcodes help us understand the location; the scope and condition help us assess the work.</p>
          <div class="utility-property-notes mt-9 grid gap-4 sm:grid-cols-2" data-stagger="70">
            <div class="utility-property-note" data-reveal="quick"><h3 class="font-serif text-2xl text-navy">Property and access</h3><p class="mt-3 leading-7 text-ink/70">Share the full address, property type, approximate size, access notes and parking information.</p></div>
            <div class="utility-property-note" data-reveal="quick"><h3 class="font-serif text-2xl text-navy">Condition and timing</h3><p class="mt-3 leading-7 text-ink/70">Describe the current condition, desired date and any areas or requirements that need particular attention.</p></div>
          </div>
        </div>

        <aside class="utility-coverage bg-porcelain" data-reveal="fade">
          <figure class="utility-coverage-photo hm-parallax"><img src="/images/phase8-nov10/r-front-door-keys.webp" alt={illustrativeAlt("/images/phase8-nov10/r-front-door-keys.webp", "")} aria-hidden={isIllustrativeImage("/images/phase8-nov10/r-front-door-keys.webp") ? undefined : "true"} width="800" height="600" loading="lazy" decoding="async" />{isIllustrativeImage("/images/phase8-nov10/r-front-door-keys.webp") && <span class="image-disclosure">Illustrative</span>}</figure>
          <div class="utility-coverage-copy">
          <h2 class="section-title font-serif text-navy">{areaInfo.name} coverage</h2>
          <dl class="mt-6 space-y-5">
            <div><dt class="text-sm font-semibold uppercase tracking-[.14em] text-ink/55">Postcodes</dt><dd class="mt-1 text-lg text-navy">{areaInfo.postcodes.join(', ')}</dd></div>
            <div><dt class="text-sm font-semibold uppercase tracking-[.14em] text-ink/55">Enquiry route</dt><dd class="mt-1 leading-7 text-ink/70">Requirements are reviewed with property, access and condition context before a quotation is discussed.</dd></div>
          </dl>
          <a href={quoteHref} class="hm-cta-link mt-8">Request a {areaInfo.name} quote <span class="hm-cta-chip" aria-hidden="true"></span></a>
          </div>
        </aside>
      </div>
    </section>

    <section class="utility-nearby bg-porcelain">
      <div class="utility-shell utility-nearby-copy">
        <div>
          <p class="section-kicker" data-reveal="fade">Nearby areas</p>
          <h2 class="section-title mt-4 font-serif text-navy" data-reveal="title">Explore nearby London locations</h2>
          <p class="mt-5 max-w-xl leading-7 text-ink/70">If the property is closer to another area, use the page that best reflects its postcode and location context.</p>
        </div>
        <ul class="utility-nearby-list mt-7" data-stagger="70">
          {nearbyAreas.map((nearby) => <li data-reveal="quick"><a href={`/locations/london/${nearby.slug}/`} class="utility-area-link"><img src={nearby.image} alt={illustrativeAlt(nearby.image, "")} aria-hidden={isIllustrativeImage(nearby.image) ? undefined : "true"} width="640" height="480" loading="lazy" decoding="async" />{isIllustrativeImage(nearby.image) && <span class="image-disclosure">Illustrative</span>}<span><span class="utility-area-name">{nearby.name}</span><span class="hm-cta-chip" aria-hidden="true"></span></span></a></li>)}
        </ul>
      </div>

    </section>

    <section class="utility-closing utility-location-closing hm-dark bg-midnight text-white">
      <div class="utility-location-closing-photo hm-parallax"><img src="/images/phase8-nov10/r-viewing-ready.webp" alt={illustrativeAlt("/images/phase8-nov10/r-viewing-ready.webp", "")} aria-hidden={isIllustrativeImage("/images/phase8-nov10/r-viewing-ready.webp") ? undefined : "true"} width="800" height="600" loading="lazy" decoding="async" /></div>
      {isIllustrativeImage("/images/phase8-nov10/r-viewing-ready.webp") && <span class="image-disclosure">Illustrative</span>}
      <div class="utility-shell utility-closing-copy text-center" data-reveal="fade">
        <p class="section-kicker">Start with the right details</p>
        <h2 class="section-title mt-4 font-serif text-white">Request a cleaning review for {areaInfo.name}</h2>
        <p class="mt-5 text-lg leading-8 text-white/75">Use the enquiry route to share the property details and outcome you need.</p>
        <a href={quoteHref} class="hm-cta-link mt-8">Request a quote <span class="hm-cta-chip" aria-hidden="true"></span></a>
      </div>
    </section>
  </main>
</Layout>
