---
import Layout from '../../../layouts/Layout.astro';
import areaData from '../../../data/area-data.json';
import Header from '../../../components/Header.astro';

export const prerender = true;

export async function getStaticPaths() {
  const typedAreaData = areaData as Record<string, any>;

  return Object.entries(typedAreaData)
    .filter(([, info]) => info.region === 'Surrey')
    .map(([areaKey, areaInfo]) => ({
      params: { area: areaKey.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase() },
      props: { areaInfo }
    }));
}

const { area } = Astro.params;
const { areaInfo } = Astro.props;
const typedAreaData = areaData as Record<string, any>;
const pageTitle = `Home Cleaning Enquiries in ${areaInfo.name} | High Quality Clean`;
const metaDescription = `Request a considered home-cleaning quote for ${areaInfo.name}. Tell High Quality Clean about the property, condition, access and the outcome you need.`;
const quoteHref = `/request-a-quote/?route=residential&area=${encodeURIComponent(areaInfo.name)}`;

const nearbyAreas = Object.entries(typedAreaData)
  .filter(([, info]) => info.name !== areaInfo.name && info.region === 'Surrey')
  .slice(0, 4)
  .map(([key, info]) => ({
    name: info.name,
    slug: key.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()
  }));

const schema = {
  '@type': 'Service',
  name: `Home cleaning enquiries in ${areaInfo.name}`,
  serviceType: 'Home cleaning enquiry review',
  image: areaInfo.heroImage,
  '@id': `https://highqualityclean.co.uk/locations/surrey/${area}/#service`,
  url: `https://highqualityclean.co.uk/locations/surrey/${area}/`,
  provider: { '@id': 'https://highqualityclean.co.uk/#organization' },
  areaServed: {
    '@type': 'Place',
    name: [areaInfo.name, ...areaInfo.postcodes]
  }
};
---

<Layout title={pageTitle} description={metaDescription} schemaNodes={[schema]}>
  <Header />

  <main class="page-transition overflow-x-hidden pt-16">
    <section class="relative bg-navy py-20 lg:py-28">
      <div class="absolute inset-0 overflow-hidden">
        <img src={areaInfo.heroImage} alt={`Homes and properties in ${areaInfo.name}`} class="h-full w-full object-cover opacity-20" />
        <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/90 to-navy/70"></div>
      </div>

      <div class="relative mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
        <div>
          <p class="mb-6 inline-block rounded-full border border-gold/40 bg-gold/20 px-3 py-1 text-sm font-medium text-gold">
            <i class="fas fa-map-marker-alt mr-2"></i>{areaInfo.name} · {areaInfo.postcodes.join(', ')}
          </p>
          <h1 class="mb-6 font-serif text-4xl leading-tight text-white sm:text-5xl lg:text-6xl">Home cleaning enquiries for {areaInfo.name}</h1>
          <p class="max-w-2xl text-xl leading-relaxed text-white/85">Tell us what needs attention at your {areaInfo.name} property. We will review the condition, access and required outcome before preparing the appropriate next step.</p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href={quoteHref} class="inline-flex items-center justify-center rounded-full bg-gold px-8 py-4 text-base font-bold text-navy shadow-lg shadow-gold/20 transition-colors hover:bg-white">Request a quote <i class="fas fa-arrow-right ml-2"></i></a>
            <a href="#what-to-share" class="inline-flex items-center justify-center rounded-full border border-white/30 px-8 py-4 text-base font-medium text-white transition-colors hover:bg-white/10">What to share</a>
          </div>
        </div>

        <aside class="grid gap-4" aria-label="Quote review steps">
          <div class="flex gap-4 rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-md">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-navy"><i class="fas fa-clipboard-list"></i></span>
            <div><h2 class="font-serif text-xl text-white">Explain the outcome</h2><p class="mt-1 text-sm leading-6 text-white/70">Choose the service route and describe the result you need.</p></div>
          </div>
          <div class="flex gap-4 rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-md">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-navy"><i class="fas fa-house"></i></span>
            <div><h2 class="font-serif text-xl text-white">Share property context</h2><p class="mt-1 text-sm leading-6 text-white/70">Include the address, approximate size, condition, access and parking details.</p></div>
          </div>
          <div class="flex gap-4 rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-md">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold text-navy"><i class="fas fa-comments"></i></span>
            <div><h2 class="font-serif text-xl text-white">Receive a considered response</h2><p class="mt-1 text-sm leading-6 text-white/70">The enquiry is reviewed against the work requested before a quotation is discussed.</p></div>
          </div>
        </aside>
      </div>
    </section>

    <section id="what-to-share" class="bg-white py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-gold">Plan the enquiry</p>
          <h2 class="mt-4 max-w-3xl font-serif text-4xl text-navy">Useful detail for a {areaInfo.name} home-cleaning review</h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-ink/70">The quickest route to a considered response is a clear picture of the property and what needs to be ready. Postcodes help us understand the location; the scope and condition help us assess the work.</p>
          <div class="mt-9 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-gold/20 bg-mist p-6"><h3 class="font-serif text-2xl text-navy">Property and access</h3><p class="mt-3 leading-7 text-ink/70">Share the full address, property type, approximate size, access notes and parking information.</p></div>
            <div class="rounded-2xl border border-gold/20 bg-mist p-6"><h3 class="font-serif text-2xl text-navy">Condition and timing</h3><p class="mt-3 leading-7 text-ink/70">Describe the current condition, desired date and any areas or requirements that need particular attention.</p></div>
          </div>
        </div>

        <aside class="rounded-2xl border border-gold/30 bg-mist p-7 shadow-soft">
          <h2 class="font-serif text-3xl text-navy">{areaInfo.name} coverage</h2>
          <dl class="mt-6 space-y-5">
            <div><dt class="text-sm font-semibold uppercase tracking-[.14em] text-ink/55">Postcodes</dt><dd class="mt-1 text-lg text-navy">{areaInfo.postcodes.join(', ')}</dd></div>
            <div><dt class="text-sm font-semibold uppercase tracking-[.14em] text-ink/55">Enquiry route</dt><dd class="mt-1 leading-7 text-ink/70">Residential requirements are reviewed with property, access and condition context before a quotation is discussed.</dd></div>
          </dl>
          <a href={quoteHref} class="mt-8 inline-flex min-h-12 w-full items-center justify-center rounded-md bg-navy px-6 py-3 text-center font-semibold text-white transition hover:bg-navy/90">Request a {areaInfo.name} quote</a>
        </aside>
      </div>
    </section>

    <section class="bg-mist py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-gold">Nearby areas</p>
          <h2 class="mt-4 font-serif text-4xl text-navy">Explore nearby Surrey locations</h2>
          <p class="mt-5 max-w-xl leading-7 text-ink/70">If the property is closer to another area, use the page that best reflects its postcode and location context.</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {nearbyAreas.map((nearby) => <li><a href={`/locations/surrey/${nearby.slug}/`} class="flex min-h-16 items-center rounded-xl border border-gold/20 bg-white px-5 font-medium text-navy transition hover:border-gold hover:text-gold"><i class="fas fa-map-marker-alt mr-3 text-gold"></i>{nearby.name}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="bg-navy py-20">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-[.2em] text-gold">Start with the right details</p>
        <h2 class="mt-4 font-serif text-4xl text-white">Request a home-cleaning review for {areaInfo.name}</h2>
        <p class="mt-5 text-lg leading-8 text-white/75">Use the residential enquiry route to share the property details and outcome you need.</p>
        <a href={quoteHref} class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-gold px-8 py-4 text-lg font-bold text-navy transition hover:bg-white">Request a quote <i class="fas fa-arrow-right ml-2"></i></a>
      </div>
    </section>
  </main>
</Layout>
