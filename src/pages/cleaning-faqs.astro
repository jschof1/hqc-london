---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const topFaqs = [
  {
    question: 'How do I make a booking?',
    answer: 'Eligible Essential Clean™ clients can continue to online booking after the suitability check. All other services require a quotation or assessment before the booking is scheduled.'
  },
  {
    question: 'Are your prices fixed?',
    answer: 'Prices are based on the information provided. If the scope or condition differs, pricing may be adjusted by agreement.'
  },
  {
    question: 'Do I need to be home for my booking?',
    answer: 'No, as long as we have safe access and clear instructions. If we cannot proceed on arrival, the visit may be limited or treated as an aborted visit.'
  },
  {
    question: 'How do I cancel or reschedule?',
    answer: 'Please contact us directly. We require at least 48 hours’ notice. Late changes may be charged in line with our Terms and Conditions.'
  },
  {
    question: 'Do you have insurance?',
    answer: 'Yes. We hold appropriate public and employer’s liability insurance.'
  }
];

const faqGroups = [
  {
    title: 'General',
    items: [
      { question: 'When will my card be charged?', answer: 'Residential services are paid on completion, or in advance where required. Commercial clients are invoiced in line with agreed terms.' }
    ]
  },
  {
    title: 'Cleaning Services',
    items: [
      { question: 'What supplies do you provide?', answer: 'For Essential residential cleans, clients provide basic supplies. For deep or detailed cleans, we bring everything needed. Commercial supplies are provided as agreed in the service scope.' },
      { question: 'What is a deep clean?', answer: 'A deep clean is a more detailed, intensive service, ideal for first-time customers or properties that have not been professionally cleaned for some time.' },
      { question: 'Do you offer carpet cleaning and end of tenancy cleaning?', answer: 'Yes. These are separate services or specialist add-ons. Scope and availability are confirmed when you speak with us.' },
      { question: 'What’s included in a standard clean?', answer: 'An Essential Clean™ covers routine cleaning tasks. The exact scope is confirmed when your service is agreed.' },
      { question: 'Are appliances, inside cupboards, or interior windows included?', answer: 'No, unless specifically agreed in advance.' }
    ]
  },
  {
    title: 'Pricing & Payments',
    items: [
      { question: 'Do you offer discounts for regular customers?', answer: 'Eligible new weekly or fortnightly Essential Clean™ clients may receive 30% off the first clean with a three-month commitment. Other pricing is confirmed with the service scope.' }
    ]
  },
  {
    title: 'Quality & Trust',
    items: [
      { question: 'What is the guarantee?', answer: 'We commit to a professional standard of service. Any issue must be reported within 72 hours so it can be reviewed in line with our Terms and Conditions.' },
      { question: 'What happens if I can’t provide access on the day?', answer: 'If we cannot access the property or proceed as agreed, the visit may be limited or treated as an aborted visit.' },
      { question: 'Will a professional clean remove all stains or marks?', answer: 'Professional cleaning improves appearance but cannot guarantee the removal of permanent stains or damage.' }
    ]
  }
];
---

<Layout title="Cleaning FAQs | High Quality Clean" description="Clear answers about HQC booking, pricing, cleaning scope, access, payments and service standards.">
  <Header />
  <main class="bg-white pt-16">
    <section class="bg-navy px-4 py-16 text-white sm:px-6 md:py-20">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-gold">Cleaning FAQs</p>
        <h1 class="mt-4 font-serif text-4xl md:text-6xl">Clear answers before you contact us</h1>
        <p class="mt-5 max-w-3xl text-lg text-white/75">Where clarity meets confidence — answers to help you understand how the service works before we speak.</p>
      </div>
    </section>

    <section class="px-4 py-12 sm:px-6 md:py-16">
      <div class="mx-auto max-w-5xl">
        <h2 class="font-serif text-3xl text-navy">The five questions most clients ask first</h2>
        <div class="mt-7 grid gap-4 md:grid-cols-2">
          {topFaqs.map((faq) => (
            <article class="rounded-xl border border-gold/30 bg-mist p-6">
              <h3 class="font-semibold text-navy">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{faq.answer}</p>
            </article>
          ))}
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/request-a-quote/" class="rounded-md bg-gold px-6 py-3 text-center font-semibold text-navy no-underline">Request a Quote</a>
          <a href="/#find-my-service" class="rounded-md border border-navy px-6 py-3 text-center font-semibold text-navy no-underline">Find My Service</a>
        </div>
      </div>
    </section>

    <section class="bg-mist px-4 py-16 sm:px-6 md:py-20">
      <div class="mx-auto max-w-5xl space-y-12">
        {faqGroups.map((group) => (
          <section>
            <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-gold">{group.title}</h2>
            <div class="mt-5 divide-y divide-gold/20 rounded-xl border border-gold/30 bg-white">
              {group.items.map((faq) => (
                <details class="group p-6">
                  <summary class="cursor-pointer list-none pr-8 font-semibold text-navy marker:hidden">{faq.question}<span class="float-right text-gold group-open:rotate-45" aria-hidden="true">+</span></summary>
                  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink/75">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        ))}
        <p class="text-sm text-ink/65">FAQs explain how the service works. The <a href="/terms-and-conditions/">Terms and Conditions</a> define what applies.</p>
      </div>
    </section>
  </main>
</Layout>
