---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import faqGroups from '../data/phase8-faq.json';

const faqEntities = faqGroups.flatMap((group) => group.items.map((faq) => ({
  '@type': 'Question',
  name: faq.question,
  acceptedAnswer: { '@type': 'Answer', text: faq.answer }
})));
---

<Layout title="Cleaning FAQs | High Quality Clean" description="Clear answers about HQC services, booking requests, quotations, scope and delivery." pageType="FAQPage" mainEntity={faqEntities}>
  <Header />
  <main class="bg-white pt-20">
    <section class="bg-midnight px-5 py-20 text-white sm:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="section-kicker">Cleaning FAQs</p>
        <h1 class="mt-4 font-serif text-4xl md:text-6xl">Frequently Asked Questions About HQC Cleaning Services</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-white/75">Different properties need different cleaning routes. These answers explain how HQC approaches service selection, quotations, booking, access, scope and delivery.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button button-primary" href="/#find-my-service">Find My Service</a>
          <a class="button button-ghost" href="/contact/">Contact HQC</a>
        </div>
      </div>
    </section>
    <div class="mx-auto max-w-5xl space-y-14 px-5 py-16 sm:px-8">
      {faqGroups.map((group) => (
        <section>
          <h2 class="font-serif text-3xl text-midnight md:text-4xl">{group.title}</h2>
          <div class="mt-6 divide-y divide-midnight/10 rounded-xl border border-midnight/10">
            {group.items.map((faq) => (
              <details class="group p-5 sm:p-6">
                <summary class="cursor-pointer pr-8 font-semibold text-midnight focus-visible:outline-2 focus-visible:outline-copper">{faq.question}</summary>
                <p class="mt-4 leading-7 text-slate">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
      <p class="text-sm text-slate">These answers explain the service. The <a class="underline" href="/terms-and-conditions/">Terms and Conditions</a> set out the applicable rules.</p>
    </div>
  </main>
</Layout>
