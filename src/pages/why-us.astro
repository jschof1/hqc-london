---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import FounderStory from '../components/FounderStory.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import FAQ from '../components/FAQ.astro';

const standardCards = [
  {
    icon: 'fas fa-clipboard-check',
    title: 'Scoped before work starts',
    text: 'We ask about property type, access, materials, priorities and the finish you want before recommending a clean.'
  },
  {
    icon: 'fas fa-flask',
    title: 'Technical product thinking',
    text: 'Pedro\'s technical background shapes careful product choice, surface awareness and practical routines for homes and wellness spaces.'
  },
  {
    icon: 'fas fa-key',
    title: 'Access-aware service',
    text: 'Keys, building contacts, alarms, pets and timings are treated as part of the service, not afterthoughts.'
  },
  {
    icon: 'fas fa-camera',
    title: 'Clear handover',
    text: 'For suitable scopes, we can share practical handover notes or photos so remote owners and busy clients know what has been completed.'
  }
];

const conciergeExamples = [
  {
    title: 'Archie and home care while travelling',
    label: 'Pet care support, supplied story copy',
    text: 'A Wandsworth client needed more than a clean while away. The supplied story describes feeding, attention for Archie and a simple home-security check, framed as concierge support rather than a standard cleaning promise.'
  },
  {
    title: 'Belgravia repair coordination',
    label: 'Property support, supplied story copy',
    text: 'When a maintenance issue affected a window, the supplied story describes inspection coordination, contractor liaison, security awareness and reporting. Publish exact details only with client approval.'
  },
  {
    title: 'Wellness-space consultation',
    label: 'Technical advisory, approval-gated',
    text: 'HQC can discuss wellness-space operational issues where Pedro\'s technical background is relevant. The specific LowLu consultation story should stay approval-gated before being presented as a named client claim.'
  }
];
---

<Layout
  title="Why Choose High Quality Clean | Founder-Led London Cleaning"
  description="Founder-led London cleaning shaped by Pedro's technical background, careful scoping, concierge care and proof-safe client stories."
>
  <Header />

  <main class="page-transition pt-16">
    <HeroSection
      title="Why HQC feels different"
      subtitle="We do not just clean. We restore calm, confidence and control through founder-led standards, careful scoping and a service style built around trust."
      imageSrc="/images/instock/IMG-20250812-WA0018.jpg"
      imageAlt="Premium London apartment interior prepared for calm living"
      primaryCta={{
        text: 'Request Your Personalised Quote',
        href: '/quote/'
      }}
      secondaryCta={{
        text: 'View Case Studies',
        href: '/case-studies/',
        icon: 'fas fa-book-open'
      }}
      trustBadges={[
        { icon: 'fas fa-list-check', text: 'Scope-led cleaning' },
        { icon: 'fas fa-user-tie', text: 'Founder-led standards' },
        { icon: 'fas fa-heart', text: 'Peace, dignity, trust' }
      ]}
      backgroundClass="bg-night"
    />

    <FounderStory />

    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">The HQC Standard</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
            Practical care that still feels personal
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-ink/74">
            The point is not to publish the loudest claims. It is to make the service feel calm, reliable and obvious from the first enquiry to the final handover.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {standardCards.map((card) => (
            <article class="rounded-[1.5rem] border border-stone bg-porcelain p-6 shadow-soft-sm">
              <i class={`${card.icon} text-2xl text-brass`} aria-hidden="true"></i>
              <h3 class="mt-5 font-serif text-2xl font-semibold text-night">{card.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <TransformationGallery
      title="Proof that stays grounded"
      subtitle="Real local images and before-after details are used carefully, without implying every illustrative property image is a completed HQC case study."
      ctaText="See case studies"
      ctaLink="/case-studies/"
    />

    <section class="bg-porcelain py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Beyond cleaning</p>
            <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
              Concierge care, prepared proof-safely
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-ink/74">
              Some HQC stories go beyond cleaning. These examples are based on supplied copy and should stay carefully worded until client permission and exact evidence are confirmed.
            </p>
          </div>
          <div class="grid gap-5">
            {conciergeExamples.map((example) => (
              <article class="rounded-[1.5rem] border border-stone bg-white p-6 shadow-soft-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{example.label}</p>
                <h3 class="mt-2 font-serif text-2xl font-semibold text-night">{example.title}</h3>
                <p class="mt-3 leading-relaxed text-ink/72">{example.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-night py-20 text-white md:py-24">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Proof-safe trust</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold md:text-5xl">
          No unsupported badges. No borrowed prestige.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-white/78">
          Public insurance amounts, background-check wording, exact regulated certificates, client logos and named case-study claims should only be shown when the evidence and permission are confirmed. Until then, HQC explains its standards plainly.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/quote/" class="inline-flex items-center justify-center rounded-md bg-brass px-6 py-3 text-sm font-semibold text-night transition-colors hover:bg-brass/90">
            Request Your Personalised Quote
          </a>
          <a href="/contact/" class="inline-flex items-center justify-center rounded-md border border-brass px-6 py-3 text-sm font-semibold text-brass transition-colors hover:bg-white/10">
            Ask about requirements
          </a>
        </div>
      </div>
    </section>

    <FAQ />
  </main>
</Layout>
