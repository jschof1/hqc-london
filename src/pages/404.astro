---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MotionKit from '../components/MotionKit.astro';
import '../styles/utility-pages.css';
Astro.response.status = 404;
const routes = [
  ['Home Cleaning', '/home-cleaning-london/'],
  ['Property & Facilities', '/property-facilities-cleaning-london/'],
  ['Workplaces & Commercial', '/commercial-cleaning-london/'],
  ['Areas We Cover', '/areas-we-cover/'],
  ['Contact', '/contact/']
];
---
<Layout title="Page Not Found | High Quality Clean" description="The page may have moved, been replaced or the address may have been entered incorrectly.">
  <Header />
  <MotionKit />
  <main class="hm-page utility-page utility-not-found hm-dark pt-20 min-h-screen bg-midnight text-white">
    <div class="utility-shell utility-not-found-body text-center">
      <section class="utility-error-intro">
        <p class="font-serif text-7xl text-gold" aria-hidden="true">404</p>
        <h1 class="section-title mt-8 font-serif text-white">That Page Is Not Available</h1>
        <p class="mt-6 mx-auto max-w-2xl text-lg leading-8 text-white/80">The page may have moved, been replaced or the address may have been entered incorrectly.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/#find-my-service" class="hm-cta-link">Find My Service <span class="hm-cta-chip" aria-hidden="true">→</span></a>
          <a href="/request-a-quote/" class="hm-cta-link hm-cta-secondary">Request a Quote <span class="hm-cta-chip" aria-hidden="true">→</span></a>
        </div>
      </section>
      <nav class="utility-error-areas mt-12" aria-label="Useful routes">
        <ul class="flex flex-wrap justify-center gap-6 text-white/80">
          {routes.map(([label, href]) => <li><a href={href} class="underline hover:text-gold">{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </main>
</Layout>
