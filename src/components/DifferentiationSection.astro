---
export interface DifferentiationFeature {
  mainIcon: string;
  smallIcon: string;
  title: string;
  description: string;
}

export interface CustomerStory {
  title: string;
  subtitle: string;
  content: string[];
  quote: string;
  footer: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  features?: DifferentiationFeature[];
  story?: CustomerStory;
  showStory?: boolean;
  className?: string;
  sectionId?: string;
  ctaText?: string;
  ctaLink?: string;
  imageSrc?: string;
  imageAlt?: string;
}
import CtaButton from './CtaButton.astro';

const {
  title = "Founder-led quality, with concierge judgement",
  subtitle = "HQC is built around calm communication, careful scope and the willingness to think beyond a basic clean when the property needs it.",
  features = [
    {
      mainIcon: "quality",
      smallIcon: "detail",
      title: "Quality system mindset",
      description: "Pedro brings a technical, detail-led approach to cleaning decisions, from product choice to handover notes and recurring standards."
    },
    {
      mainIcon: "concierge",
      smallIcon: "access",
      title: "Concierge-style support",
      description: "For suitable clients, HQC can coordinate discreet access, practical updates and property-care details that keep things moving."
    }
  ],
  story = {
    title: "Concierge signal",
    subtitle: "Caring for Archie in Wandsworth",
    content: [
      "When a Wandsworth client realised they would not make it home in time to feed their dog, Archie, they asked HQC for help. The team was already nearby and checked in without drama.",
      "Archie was fed, watered and given attention, and the home was left calm and secure for the client's return. It is a small example of the care HQC aims to bring to ongoing relationships."
    ],
    quote: "It's the kind of thing you can't put a price on knowing someone's there, not just to clean, but to care.",
    footer: "Additional concierge support is agreed case by case and always scoped before action."
  },
  showStory = true,
  className = "",
  sectionId = "differentiation",
  ctaText = "Read more about HQC",
  ctaLink = "/why-us/",
  imageSrc = "/images/pedro.jpg",
  imageAlt = "Pedro, founder of High Quality Clean"
} = Astro.props;
---

<section id={sectionId} class={`bg-night py-20 text-white sm:py-24 ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="relative">
        <div class="absolute -left-4 -top-4 h-full w-full rounded-[2rem] border border-brass/25" aria-hidden="true"></div>
        <img
          src={imageSrc}
          alt={imageAlt}
          class="relative h-[420px] w-full rounded-[2rem] object-cover object-top shadow-panel"
          loading="lazy"
        />
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Why the standard feels different</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-white md:text-5xl">
          {title}
        </h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-white/74 md:text-lg">
          {subtitle}
        </p>

        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {features.map((feature) => (
            <article class="rounded-[1.5rem] border border-white/10 bg-white/[0.06] p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{feature.mainIcon}</p>
              <h3 class="mt-3 font-serif text-2xl font-semibold text-white">{feature.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/70">
                {feature.description}
              </p>
            </article>
          ))}
        </div>

        {showStory && story && (
          <article class="mt-8 rounded-[1.5rem] border border-brass/25 bg-white p-6 text-night shadow-soft">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass">{story.title}</p>
            <h3 class="mt-2 font-serif text-2xl font-semibold text-night">{story.subtitle}</h3>
            <div class="mt-4 space-y-3 text-sm leading-relaxed text-ink/74">
              {story.content.map((paragraph) => (
                <p set:html={paragraph}></p>
              ))}
            </div>
            <blockquote class="mt-5 border-l-2 border-brass pl-4 text-sm italic leading-relaxed text-ink/75">
              “{story.quote}”
            </blockquote>
            <p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-ink/55">
              {story.footer}
            </p>
          </article>
        )}

        {ctaText && ctaLink && (
          <div class="mt-8">
            <CtaButton href={ctaLink} className="bg-brass text-night hover:bg-brass/90">
              {ctaText}
            </CtaButton>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
