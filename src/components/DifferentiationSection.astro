---
export interface DifferentiationFeature {
  mainIcon: string;
  smallIcon: string;
  title: string;
  description: string;
}

export interface CustomerStory {
  title: string;
  subtitle: string;
  content: string[];
  quote: string;
  footer: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  features?: DifferentiationFeature[];
  story?: CustomerStory;
  showStory?: boolean;
  className?: string;
  sectionId?: string;
  ctaText?: string;
  ctaLink?: string;
}
import CtaButton from './CtaButton.astro';  
const {
  title = "Premium cleaning, made easier to manage",
  subtitle = "HQC keeps the premium signal where it matters: standards, careful handling, presentation and a clear scope before work begins.",
  features = [
    {
      mainIcon: "fas fa-clipboard-check",
      smallIcon: "fas fa-list-check",
      title: "Clear scopes",
      description: "Each enquiry is shaped around the property, timing, access, condition and the outcome the space needs next."
    },
    {
      mainIcon: "fas fa-hand-sparkles",
      smallIcon: "fas fa-shield-heart",
      title: "Careful presentation",
      description: "The focus is on details people notice: high-touch points, surfaces, finishes, rooms in use and handover readiness."
    }
  ],
  story = {
    title: "Attention to detail in practice",
    subtitle: "Readiness, presentation and less chasing",
    content: [
      "The strongest HQC work is often practical rather than theatrical: a property ready for viewing, a home reset before maintenance cleaning, or a client-facing space prepared before opening.",
      "That means agreeing what matters first, cleaning around the actual use of the space, and keeping the next step clear for the client or property team."
    ],
    quote: "Most cleaning companies clean what is obvious. HQC focuses on what matters to the way the space is used.",
    footer: "This is premium cleaning expressed through standards, care and readiness."
  },
  showStory = true,
  className = "",
  sectionId = "differentiation",
  ctaText = "Request a Cleaning Quote",
  ctaLink = "/quote/"
} = Astro.props;
---

<section id={sectionId} class={`py-20 sm:py-24 bg-navy ${className}`}>
  <div class="mx-auto max-w-7xl px-6 sm:px-6 lg:px-8">
    <h2 class="font-serif text-2xl md:text-3xl text-gold">
      {title}
    </h2>
    <p class="mt-4 text-white/70 max-w-3xl text-sm md:text-base">
      {subtitle}
    </p>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {features.map((feature) => (
        <div
          class="rounded-xl bg-gray-100 p-5 border-2 border-gold flex items-center gap-6 shadow-2xl shadow-gold/20"
        >
          <div class="flex items-center justify-center bg-navy rounded-md w-20 h-20 border-2 border-gold">
            <i class={`${feature.mainIcon} text-gold text-4xl`} aria-hidden="true"></i>
          </div>
          <div class="flex-1">
            <h3 class="font-medium text-navy border-b border-gold pb-1">{feature.title}</h3>
            <p class="mt-3 text-sm text-navy/70">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Customer Story -->
    {showStory && story && (
      <div class="mt-16 bg-navy rounded-2xl lg:md:p-8 text-white">
          <div class="flex items-center gap-3 mb-6">
            <i class="fas fa-star text-gold text-2xl"></i>
            <h3 class="font-serif text-2xl text-gold">{story.title}</h3>
          </div>
          
          <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-gold/30">
            <h4 class="font-semibold text-gold mb-3">{story.subtitle}</h4>
            {story.content.map((paragraph, index) => (
              <p class="text-white/90 mb-4" set:html={paragraph}></p>
            ))}
            <div class="border-l-4 border-gold pl-4 italic text-gold/80">
              "{story.quote}"
            </div>
            <p class="text-white/80 text-sm mt-4 font-medium">
              {story.footer}
            </p>
          </div>
        </div>
    )}
    {ctaText && ctaLink && (
      <div class="text-center mt-8">
        <CtaButton href={ctaLink}>
          {ctaText}
        </CtaButton>  
      </div>
    )}
  </div>
  
</section>
