---
// Pedro's six selected public reviews, 12 November 2026. The component path stays
// compatible with the homepage; the requested proof cards replace the carousel.
import reviewsData from '../data/google-reviews.json';
const selected = [
  ['Kara O.', 'Home cleaning'], ['Lucy M.', 'Deep clean'],
  ['Yori Z.', 'End of tenancy'], ['Fabio K.', 'End of tenancy'],
  ['Chris M.', 'Commercial'], ['Liv M.', 'Post-renovation']
];
const reviews = selected.map(([name, service]) => {
  const review = reviewsData.reviews.find((review) => review.name === name);
  if (!review) throw new Error(`Missing selected review: ${name}`);
  return { ...review, service };
});
---
<section id="google-reviews" class="hm-reviews scroll-mt-20 bg-porcelain py-16 md:py-20" aria-labelledby="google-reviews-title">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="google-reviews-title" class="font-serif text-3xl font-medium text-midnight md:text-4xl">What clients say on Google</h2>
        <p class="mt-3 text-sm text-slate">{reviewsData.rating} on Google from {reviewsData.reviewCount} reviews</p>
      </div>
      <a href={reviewsData.profileUrl} class="hm-cta-link" target="_blank" rel="noopener">Read all reviews on Google <span class="hm-cta-chip" aria-hidden="true">↗</span></a>
    </div>
    <ul class="hm-review-cards mt-10">
      {reviews.map((review) => (
        <li class="hm-review">
          <span class="hm-stars" role="img" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
          <blockquote class="hm-review-text"><p>{review.text}</p></blockquote>
          <p class="hm-review-by"><strong>{review.name}</strong><span>{review.service}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>
