---
import { serviceTiers } from '../data/serviceTiers';

interface Props {
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  sectionId?: string;
  showComparison?: boolean;
  backgroundClass?: string;
}

const {
  title = 'Choose the level of clean that fits your home',
  subtitle = 'Essentials, Signature and WellClean™ Premium are designed to make the quote conversation clearer without turning a premium service into a one-size-fits-all package.',
  eyebrow = 'Home cleaning tiers',
  sectionId = 'service-tiers',
  showComparison = true,
  backgroundClass = 'bg-white',
} = Astro.props;
---

<section id={sectionId} class={`${backgroundClass} py-16 md:py-20`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold">{eyebrow}</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-navy md:text-5xl">{title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/75">{subtitle}</p>
      <p class="mt-4 text-base font-semibold text-navy">
        HQC is a strong fit for clients who value calm, precision and consistency. It is not positioned as the cheapest cleaner.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {serviceTiers.map((tier) => (
        <article class="flex min-h-full flex-col rounded-3xl border border-navy/10 bg-cream p-6 shadow-soft-sm md:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">{tier.emotionalOutcome}</p>
              <h3 class="mt-3 font-serif text-3xl font-semibold text-navy">{tier.name}</h3>
            </div>
            {tier.id === 'signature' && (
              <span class="rounded-full bg-navy px-3 py-1 text-xs font-semibold text-white">Most requested</span>
            )}
            {tier.id === 'wellclean-premium' && (
              <span class="rounded-full bg-gold px-3 py-1 text-xs font-semibold text-navy">Premium</span>
            )}
          </div>

          <p class="mt-4 text-base font-semibold text-ink">{tier.tagline}</p>
          <dl class="mt-6 space-y-4 text-sm leading-relaxed">
            <div>
              <dt class="font-semibold text-navy">Target client</dt>
              <dd class="mt-1 text-ink/72">{tier.targetClient}</dd>
            </div>
            <div>
              <dt class="font-semibold text-navy">Indicative range</dt>
              <dd class="mt-1 text-ink/72">{tier.indicativeRange}</dd>
            </div>
          </dl>

          <div class="mt-6 flex-1">
            <h4 class="text-sm font-semibold uppercase tracking-[0.14em] text-navy">Key inclusions</h4>
            <ul class="mt-3 space-y-2 text-sm text-ink/75">
              {tier.inclusions.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-gold"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 rounded-2xl border border-navy/10 bg-white p-4">
            <h4 class="text-sm font-semibold text-navy">Exclusions or add-ons</h4>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">
              {tier.exclusionsOrAddOns.join(', ')}.
            </p>
          </div>

          <p class="mt-5 text-sm leading-relaxed text-ink/68">{tier.quoteLanguage}</p>
          <a
            href={`/quote/?tier=${tier.id}`}
            class="mt-6 inline-flex items-center justify-center rounded-md bg-gold px-5 py-3 font-semibold text-navy transition duration-300 hover:bg-gold/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2"
          >
            {tier.ctaText}
          </a>
        </article>
      ))}
    </div>

    {showComparison && (
      <div class="mt-14 overflow-hidden rounded-3xl border border-navy/10 bg-white shadow-soft-sm">
        <div class="border-b border-navy/10 bg-navy px-6 py-5 text-white">
          <h3 class="font-serif text-2xl font-semibold">Tier comparison at a glance</h3>
          <p class="mt-2 text-sm text-white/75">Use this as a guide. The confirmed quote always follows the actual property, condition, access and desired finish.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left text-sm">
            <thead class="bg-cream text-navy">
              <tr>
                <th class="px-5 py-4 font-semibold">Tier</th>
                <th class="px-5 py-4 font-semibold">Target client</th>
                <th class="px-5 py-4 font-semibold">Emotional outcome</th>
                <th class="px-5 py-4 font-semibold">Indicative range</th>
                <th class="px-5 py-4 font-semibold">Boundaries</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy/10 text-ink/74">
              {serviceTiers.map((tier) => (
                <tr>
                  <th class="px-5 py-5 align-top font-semibold text-navy">{tier.name}</th>
                  <td class="px-5 py-5 align-top">{tier.targetClient}</td>
                  <td class="px-5 py-5 align-top">{tier.emotionalOutcome}</td>
                  <td class="px-5 py-5 align-top">{tier.indicativeRange}</td>
                  <td class="px-5 py-5 align-top">{tier.exclusionsOrAddOns.join(', ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</section>
