---
export interface GalleryImage {
  src: string;
  alt: string;
  caption: string;
  note?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  images?: GalleryImage[];
  className?: string;
  ctaText?: string;
  ctaLink?: string;
}

import CtaButton from './CtaButton.astro';

const {
  title = "Proof of care, not stock promises",
  subtitle = "A small selection of local before-after, property and action images used as grounded proof points. Full case stories should always be confirmed before named publication.",
  images = [
    {
      src: "/images/before-after/before-after-1.jpg",
      alt: "Real kitchen surface before and after cleaning detail",
      caption: "Kitchen detail reset",
      note: "Before-after proof"
    },
    {
      src: "/images/before-after/after.jpg",
      alt: "Room after a detailed cleaning reset",
      caption: "Room reset finish",
      note: "After-clean presentation"
    },
    {
      src: "/images/before-after/after-3.jpg",
      alt: "Cleaned floor or exterior surface after transformation",
      caption: "Surface recovery",
      note: "Transformation detail"
    },
    {
      src: "/images/instock/IMG-20250812-WA0018.jpg",
      alt: "Premium London apartment interior after careful property preparation",
      caption: "Calm home presentation",
      note: "Local property imagery"
    },
    {
      src: "/images/instock/IMG-20250813-WA0062.jpg",
      alt: "Team member carrying out window cleaning work",
      caption: "Team at work",
      note: "Local action image"
    },
    {
      src: "/images/instock/IMG-20250813-WA0049.jpg",
      alt: "Wellness space suitable for specialist cleaning or advisory discussion",
      caption: "Wellness space care",
      note: "Illustrative local context"
    }
  ],
  className = "",
  ctaText = "View case studies",
  ctaLink = "/case-studies/"
} = Astro.props;
---

<section class={`bg-white py-20 md:py-24 ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Proof and case studies</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
        {title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/74">
        {subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {images.map((image) => (
        <figure class="overflow-hidden rounded-[1.5rem] border border-stone bg-porcelain shadow-soft-sm">
          <img
            src={image.src}
            alt={image.alt}
            class="h-64 w-full object-cover"
            loading="lazy"
          />
          <figcaption class="p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{image.note}</p>
            <h3 class="mt-2 font-serif text-2xl font-semibold text-night">{image.caption}</h3>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-10 text-center">
      <CtaButton href={ctaLink}>
        {ctaText}
      </CtaButton>
    </div>
  </div>
</section>
