---
import legal from '../data/phase8-legal.json';
import '../styles/utility-pages.css';

interface Props { kind: 'privacy' | 'terms'; }
const { kind } = Astro.props;
const blocks = legal[kind];
const isPreview = process.env.CF_PAGES === '1' && process.env.CF_PAGES_BRANCH !== 'main' || !['highqualityclean.co.uk', 'www.highqualityclean.co.uk'].includes(Astro.url.hostname);
// Keep the original headings once, as sticky chapter markers beside their clauses.
const chapters: { heading: string; blocks: (typeof blocks)[number][] }[] = [{ heading: '', blocks: [] }];
for (const block of blocks) {
  if (block.kind === 'h2' && typeof block.text === 'string') chapters.push({ heading: block.text, blocks: [] });
  else chapters[chapters.length - 1]?.blocks.push(block);
}
---

<main class="hm-page utility-page utility-legal min-h-screen bg-porcelain pt-20 text-midnight">
  <article>
    <header class="utility-hero utility-legal-hero hm-dark bg-midnight text-white"><div class="utility-reading">
    <p class="section-kicker hm-kicker-line">High Quality Clean Ltd</p>
    <h1 class="mt-4 font-serif text-4xl md:text-6xl">{kind === 'privacy' ? 'Privacy Policy' : 'Terms and Conditions of Service'}</h1>
    </div></header>
    <div class="utility-shell utility-legal-body">
    {isPreview && <p class="mt-5 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">Staging draft: company details, legal review date and production behavior must be verified before release.</p>}
    <div class="mt-10 utility-legal-chapters text-base leading-7 text-slate">
      {chapters.map((chapter, index) => <section class:list={["utility-legal-chapter", { "utility-legal-preamble": !chapter.heading }]} id={`legal-clause-${index + 1}`}>
        {chapter.heading && <div class="utility-legal-marker"><h2 class="section-title font-serif text-midnight"><span class="utility-clause-number">{chapter.heading.split(' ')[0]}</span>{' '}{chapter.heading.split(' ').slice(1).join(' ')}</h2></div>}
        <div class="utility-legal-content space-y-5">
      {chapter.blocks.map((block) => (
        block.kind === 'h3' ? <h3 class="pt-4 text-xl font-semibold text-midnight" data-reveal="quick">{block.text}</h3> :
        block.kind === 'ul' ? <ul class="utility-legal-list">{block.items.map((item) => <li><span>{item}</span></li>)}</ul> :
        block.kind === 'table' && block.stack ? (
          <div data-legal-table="stacked">
            <table class="hidden w-full border-collapse text-left text-sm md:table">
              <thead><tr>{block.rows[0].map((cell) => <th scope="col" class="border border-midnight/20 bg-porcelain p-3 align-bottom text-midnight">{cell}</th>)}</tr></thead>
              <tbody>{block.rows.slice(1).map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row" class="border border-midnight/20 p-3 align-top font-semibold text-midnight">{cell}</th> : <td class="border border-midnight/20 p-3 align-top">{cell}</td>)}</tr>)}</tbody>
            </table>
            <ul class="space-y-3 md:hidden">
              {block.rows.slice(1).map((row) => (
                <li class="rounded-xl border border-midnight/15 bg-porcelain p-4 text-sm">
                  <p class="font-semibold text-midnight">{row[0]}</p>
                  <dl class="mt-2 space-y-2">
                    {row.slice(1).map((cell, index) => <div><dt class="text-xs font-bold uppercase tracking-[.12em] text-copper-ink">{block.rows[0][index + 1]}</dt><dd class="mt-0.5">{cell}</dd></div>)}
                  </dl>
                </li>
              ))}
            </ul>
          </div>
        ) :
        block.kind === 'callout' ? <p class="rounded-lg border border-midnight/15 bg-porcelain p-4 font-medium text-midnight">{block.text}</p> :
        block.kind === 'table' ? <div class="overflow-x-auto"><table class="min-w-[720px] border-collapse text-left text-sm"><thead><tr>{block.rows[0].map((cell) => <th class="border border-midnight/20 bg-porcelain p-3">{cell}</th>)}</tr></thead><tbody>{block.rows.slice(1).map((row) => <tr>{row.map((cell) => <td class="border border-midnight/20 p-3 align-top">{cell}</td>)}</tr>)}</tbody></table></div> :
        block.text === 'Link: Privacy Policy' ? <p><a class="underline" href="/privacy-policy/">Privacy Policy</a></p> :
        block.text === 'Link: Manage Cookie Preferences' ? <p><a class="underline" href="#hqc-cookie-preferences" data-open-cookie-preferences>Manage Cookie Preferences</a></p> :
        <p>{block.text}</p>
      ))}
        </div>
      </section>)}
    </div>
    </div>
  </article>
</main>
