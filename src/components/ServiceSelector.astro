---
import { cardLibrary } from '../data/card-imagery';
const photo = cardLibrary['r-routine-visit'];
---

<section id="find-my-service" class="hm-selector relative isolate scroll-mt-20 bg-copper py-20 md:py-28">
  <div class="mx-auto grid max-w-[1440px] gap-10 px-5 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:gap-16 lg:px-14">
    <div class="hm-chapter-head"><div class="hm-sticky">
      <p class="hm-kicker-line text-xs font-bold uppercase tracking-[0.22em] text-midnight" data-reveal="fade">Find my service</p>
      <h2 class="mt-4 max-w-2xl font-serif text-4xl font-medium leading-[1.02] text-midnight md:text-6xl" data-reveal="title">What Do You Need Help With?</h2>
      <p class="mt-5 max-w-xl text-lg leading-8 text-midnight" data-reveal style="--d: 120ms">Choose the situation that best describes what you need.</p>
      <figure class="hm-selector-photo mt-8 hidden overflow-hidden rounded-[1.25rem] lg:block" data-reveal="clip" style="--hm-cover: var(--color-copper)">
        <img src={photo.src} alt={photo.alt} class="aspect-[5/4] w-full object-cover" loading="lazy" decoding="async" width="1200" height="900" />
      </figure>
    </div></div>

    <div>
    <div class="hm-choices grid gap-2.5 sm:grid-cols-2 lg:grid-cols-1" data-stagger="25" data-stagger-type="quick">
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="maintain" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">01</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Keep my home consistently clean</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">02</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Restore a home that needs more attention</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">03</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Prepare a property before moving in</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">04</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Prepare a property for handover</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">05</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Remove dust and residue after building work</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="professional" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">06</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Arrange cleaning for a workplace</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="professional" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">07</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Arrange cleaning across properties or a portfolio</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="professional" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">08</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">Discuss a large or complex property</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
      <button type="button" class="service-choice hm-choice group relative flex items-center gap-4 rounded-2xl border border-midnight/10 bg-porcelain px-5 py-4 pr-16 text-left md:gap-6 md:px-6" data-result="unsure" aria-pressed="false" aria-controls="selector-result">
        <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">09</span>
        <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.6rem]">I am not sure</strong>
        <span class="hm-choice-mark" aria-hidden="true"></span>
      </button>
    </div>

    <div id="selector-result" class="hm-result relative mt-5 hidden overflow-hidden rounded-2xl bg-white p-7 text-midnight shadow-2xl md:p-10" aria-live="polite">
      <span class="hm-result-bar" aria-hidden="true"></span>
      <p id="selector-label" class="text-xs font-bold uppercase tracking-[0.2em] text-copper-ink"></p>
      <h3 id="selector-heading" class="mt-4 max-w-4xl font-serif text-3xl font-medium md:text-4xl">Your recommended route</h3>
      <p id="selector-copy" class="mt-5 max-w-3xl leading-7 text-slate"></p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a id="selector-primary" class="button button-dark hm-result-primary" href="/request-a-quote/">Continue to your enquiry</a>
        <a id="selector-secondary" class="button border border-midnight/20 text-midnight hover:border-copper" href="/home-cleaning-london/">Compare home services</a>
      </div>
    </div>
    </div>
  </div>
</section>

<script>
  const results = {
    maintain: {
      label: 'Essential Clean™ suitability',
      heading: 'First, check whether the home is maintenance-ready',
      copy: 'Weekly and fortnightly Essential Clean™ enquiries are checked for suitability. Heavy build-up, monthly requests and restoration work are routed to manual review.',
      href: '/essential-clean-london/',
      cta: 'Explore Essential Clean™',
      secondaryHref: '/deep-cleaning-london/',
      secondary: 'The home needs restoration'
    },
    restore: {
      label: 'Tailored residential quotation',
      heading: 'Tell us the condition and the outcome you need',
      copy: 'Deep Clean™, Move-In Reset™, End of Tenancy™ and Post-Construction™ are quoted manually so scope, access, parking and condition can be reviewed.',
      href: '/request-a-quote/?route=residential',
      cta: 'Request a tailored quote',
      secondaryHref: '/home-cleaning-london/',
      secondary: 'Compare home services'
    },
    professional: {
      label: 'Professional or complex enquiry',
      heading: 'Route the site or portfolio to the right assessment',
      copy: 'Workplaces, managed properties and complex projects use the tailored quotation or assessment route. They are not publicly bookable services.',
      href: '/request-a-quote/?route=commercial',
      cta: 'Start a professional enquiry',
      secondaryHref: '/complex-property-cleaning-london/',
      secondary: 'Complex service assessment'
    },
    unsure: {
      label: 'Find my service',
      heading: 'Not Sure Which Cleaning Service You Need?',
      copy: 'Tell us what you are trying to achieve and we will help you find the right route.',
      href: '/request-a-quote/',
      cta: 'Request a Quote',
      secondaryHref: '/contact/',
      secondary: 'Contact HQC'
    }
  };

  const resultPanel = document.getElementById('selector-result');
  const label = document.getElementById('selector-label');
  const heading = document.getElementById('selector-heading');
  const copy = document.getElementById('selector-copy');
  const primary = document.getElementById('selector-primary');
  const secondary = document.getElementById('selector-secondary');

  document.querySelectorAll<HTMLButtonElement>('.service-choice').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.result as keyof typeof results;
      const result = results[key];
      if (!result || !resultPanel || !label || !heading || !copy || !primary || !secondary) return;
      label.textContent = result.label;
      heading.textContent = result.heading;
      copy.textContent = result.copy;
      primary.textContent = result.cta;
      primary.setAttribute('href', result.href);
      secondary.textContent = result.secondary;
      secondary.setAttribute('href', result.secondaryHref);
      document.querySelectorAll<HTMLButtonElement>('.service-choice').forEach((choice) => {
        choice.setAttribute('aria-pressed', String(choice === button));
      });
      resultPanel.classList.remove('hidden');
      // Presentation only: replay the panel entrance and mark the grid as having a choice.
      resultPanel.classList.remove('is-swap');
      void resultPanel.offsetWidth;
      resultPanel.classList.add('is-swap');
      button.closest('.hm-choices')?.setAttribute('data-has-choice', '');
      resultPanel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'nearest' });
      window.dispatchEvent(new CustomEvent('hqc:conversion', { detail: { event: 'service_selector_result', result: key } }));
    });
  });
</script>
