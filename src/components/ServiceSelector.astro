---
import { isIllustrativeImage, illustrativeAlt, cardLibrary } from '../data/card-imagery';
const photo = cardLibrary['r-routine-visit'];
// Presentation only (Jack, 11 Nov 2026): photograph as the section background, heading on top, and the
// nine situations in a split grid (homes on one side, workplaces and property on the other). Choice
// labels, order, routing and results are unchanged.
const choices = [
  { number: '01', result: 'maintain', label: 'Keep my home consistently clean' },
  { number: '02', result: 'restore', label: 'Restore a home that needs more attention' },
  { number: '03', result: 'restore', label: 'Prepare a property before moving in' },
  { number: '04', result: 'restore', label: 'Prepare a property for handover' },
  { number: '05', result: 'restore', label: 'Remove dust and residue after building work' },
  { number: '06', result: 'professional', label: 'Arrange cleaning for a workplace' },
  { number: '07', result: 'professional', label: 'Arrange cleaning across properties or a portfolio' },
  { number: '08', result: 'complex', label: 'Discuss a large or complex property' },
  { number: '09', result: 'unsure', label: 'I am not sure' }
];
const groups = [
  { label: 'Homes', items: choices.slice(0, 5) },
  { label: 'Workplaces and property', items: choices.slice(5) }
];
---

<section id="find-my-service" class="hm-selector relative isolate scroll-mt-20 overflow-hidden py-20 text-white md:py-28">
  <img class="hm-selector-bg" src={photo.src} alt={illustrativeAlt(photo.src, photo.alt)} loading="lazy" decoding="async" width="1200" height="900" />{isIllustrativeImage(photo.src) && <span class="image-disclosure">Illustrative</span>}
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-copper" data-reveal="fade">Find my service</p>
      <h2 class="mx-auto mt-4 max-w-2xl font-serif text-4xl font-medium leading-[1.02] text-white md:text-6xl" data-reveal="title">What Do You Need Help With?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-8 text-white/85" data-reveal style="--d: 120ms">Choose the situation that best describes what you need.</p>
    </div>

    <div class="hm-choices mt-8 grid gap-6 lg:grid-cols-2 lg:gap-8">
      {groups.map((group) => (
        <div class="hm-choice-group">
          <p class="hm-choice-group-label">{group.label}</p>
          <div class="grid gap-2.5" data-stagger="30" data-stagger-type="quick">
            {group.items.map((choice) => (
              <button type="button" class:list={['service-choice hm-choice group relative flex items-center gap-4 rounded-2xl px-5 py-4 pr-16 text-left md:gap-5', choice.result === 'unsure' && 'hm-choice-unsure']} data-result={choice.result} aria-pressed="false" aria-controls="selector-result">
                <span class="w-8 shrink-0 font-serif text-2xl text-copper-ink">{choice.number}</span>
                <strong class="block font-serif text-xl font-medium leading-tight text-midnight md:text-[1.45rem]">{choice.label}</strong>
                <span class="hm-choice-mark" aria-hidden="true"></span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="selector-result" class="hm-result relative mt-6 hidden scroll-mt-28 overflow-hidden rounded-2xl bg-white p-7 text-midnight shadow-2xl md:p-10" aria-live="polite">
      <span class="hm-result-bar" aria-hidden="true"></span>
      <p id="selector-label" class="text-xs font-bold uppercase tracking-[0.2em] text-copper-ink"></p>
      <h3 id="selector-heading" class="mt-4 max-w-4xl font-serif text-3xl font-medium md:text-4xl">Your recommended route</h3>
      <p id="selector-copy" class="mt-5 max-w-3xl leading-7 text-slate"></p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a id="selector-primary" class="button button-dark hm-result-primary" href="/request-a-quote/">Continue to your enquiry</a>
        <a id="selector-secondary" class="button border border-midnight/20 text-midnight hover:border-copper" href="/home-cleaning-london/">Compare home services</a>
      </div>
    </div>
  </div>
</section>

<script>
  const results = {
    maintain: {
      label: 'Essential Clean™ suitability',
      heading: 'First, check whether the home is maintenance-ready',
      copy: 'Weekly and fortnightly Essential Clean™ enquiries are checked for suitability. Heavy build-up, monthly requests and restoration work are routed to manual review.',
      href: '/essential-clean-london/?next=booking',
      cta: 'Explore Essential Clean™',
      secondaryHref: '/deep-cleaning-london/',
      secondary: 'The home needs restoration'
    },
    restore: {
      label: 'Tailored residential quotation',
      heading: 'Tell us the condition and the outcome you need',
      copy: 'Deep Clean™, Move-In Reset™, End of Tenancy™ and Post-Construction™ are quoted manually so scope, access, parking and condition can be reviewed.',
      href: '/request-a-quote/?route=residential',
      cta: 'Request a tailored quote',
      secondaryHref: '/home-cleaning-london/',
      secondary: 'Compare home services'
    },
    professional: {
      label: 'Professional or complex enquiry',
      heading: 'Route the site or portfolio to the right assessment',
      copy: 'Workplaces, managed properties and complex projects use the tailored quotation or assessment route. They are not publicly bookable services.',
      href: '/request-a-quote/?route=commercial',
      cta: 'Start a professional enquiry',
      secondaryHref: '/complex-property-cleaning-london/',
      secondary: 'Complex service assessment'
    },
    complex: {
      label: 'Professional or complex enquiry',
      heading: 'Route the site or portfolio to the right assessment',
      copy: 'Workplaces, managed properties and complex projects use the tailored quotation or assessment route. They are not publicly bookable services.',
      href: '/request-a-quote/?route=complex',
      cta: 'Start a professional enquiry',
      secondaryHref: '/complex-property-cleaning-london/',
      secondary: 'Complex service assessment'
    },
    unsure: {
      label: 'Find my service',
      heading: 'Not Sure Which Cleaning Service You Need?',
      copy: 'Tell us what you are trying to achieve and we will help you find the right route.',
      href: '/request-a-quote/',
      cta: 'Request a Quote',
      secondaryHref: '/contact/',
      secondary: 'Contact HQC'
    }
  };

  const resultPanel = document.getElementById('selector-result');
  const label = document.getElementById('selector-label');
  const heading = document.getElementById('selector-heading');
  const copy = document.getElementById('selector-copy');
  const primary = document.getElementById('selector-primary');
  const secondary = document.getElementById('selector-secondary');

  document.querySelectorAll<HTMLButtonElement>('.service-choice').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.result as keyof typeof results;
      const result = results[key];
      if (!result || !resultPanel || !label || !heading || !copy || !primary || !secondary) return;
      label.textContent = result.label;
      heading.textContent = result.heading;
      copy.textContent = result.copy;
      primary.textContent = result.cta;
      primary.setAttribute('href', result.href);
      secondary.textContent = result.secondary;
      secondary.setAttribute('href', result.secondaryHref);
      document.querySelectorAll<HTMLButtonElement>('.service-choice').forEach((choice) => {
        choice.setAttribute('aria-pressed', String(choice === button));
      });
      resultPanel.classList.remove('hidden');
      // Presentation only: replay the panel entrance and mark the grid as having a choice.
      resultPanel.classList.remove('is-swap');
      void resultPanel.offsetWidth;
      resultPanel.classList.add('is-swap');
      button.closest('.hm-choices')?.setAttribute('data-has-choice', '');
      resultPanel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'nearest' });
      window.dispatchEvent(new CustomEvent('hqc:conversion', { detail: { event: 'service_selector_result', result: key } }));
    });
  });
</script>
