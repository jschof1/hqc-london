<section id="find-my-service" class="scroll-mt-20 bg-copper py-20 md:py-28">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
    <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-midnight">Find my service</p>
        <h2 class="mt-4 max-w-2xl font-serif text-4xl font-medium leading-[1.02] text-midnight md:text-6xl">What Do You Need Help With?</h2>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-midnight">Choose the situation that best describes what you need.</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="maintain" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">01</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Keep my home consistently clean</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">02</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Restore a home that needs more attention</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">03</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Prepare a property before moving in</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">04</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Prepare a property for handover</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="restore" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">05</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Remove dust and residue after building work</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="professional" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">06</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Arrange cleaning for a workplace</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="professional" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">07</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Arrange cleaning across properties or a portfolio</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="professional" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">08</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">Discuss a large or complex property</strong>
      </button>
      <button type="button" class="service-choice group flex min-h-28 items-start gap-4 rounded-2xl border border-midnight/15 bg-porcelain p-5 text-left transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-2xl md:p-6" data-result="unsure" aria-pressed="false" aria-controls="selector-result">
        <span class="font-serif text-3xl text-copper-ink">09</span>
        <strong class="block font-serif text-2xl font-medium leading-tight text-midnight">I am not sure</strong>
      </button>
    </div>

    <div id="selector-result" class="mt-5 hidden rounded-2xl bg-white p-7 text-midnight shadow-2xl md:p-10" aria-live="polite">
      <p id="selector-label" class="text-xs font-bold uppercase tracking-[0.2em] text-copper-ink"></p>
      <h3 id="selector-heading" class="mt-4 max-w-4xl font-serif text-3xl font-medium md:text-5xl">Your recommended route</h3>
      <p id="selector-copy" class="mt-5 max-w-3xl leading-7 text-slate"></p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a id="selector-primary" class="button button-dark" href="/request-a-quote/">Continue to your enquiry</a>
        <a id="selector-secondary" class="button border border-midnight/20 text-midnight hover:border-copper" href="/home-cleaning-london/">Compare home services</a>
      </div>
    </div>
  </div>
</section>

<script>
  const results = {
    maintain: {
      label: 'Essential Clean™ suitability',
      heading: 'First, check whether the home is maintenance-ready',
      copy: 'Weekly and fortnightly Essential Clean™ enquiries are checked for suitability. Heavy build-up, monthly requests and restoration work are routed to manual review.',
      href: '/essential-clean-london/',
      cta: 'Explore Essential Clean™',
      secondaryHref: '/deep-cleaning-london/',
      secondary: 'The home needs restoration'
    },
    restore: {
      label: 'Tailored residential quotation',
      heading: 'Tell us the condition and the outcome you need',
      copy: 'Deep Clean™, Move-In Reset™, End of Tenancy™ and Post-Construction™ are quoted manually so scope, access, parking and condition can be reviewed.',
      href: '/request-a-quote/?route=residential',
      cta: 'Request a tailored quote',
      secondaryHref: '/home-cleaning-london/',
      secondary: 'Compare home services'
    },
    professional: {
      label: 'Professional or complex enquiry',
      heading: 'Route the site or portfolio to the right assessment',
      copy: 'Workplaces, managed properties and complex projects use the tailored quotation or assessment route. They are not publicly bookable services.',
      href: '/request-a-quote/?route=commercial',
      cta: 'Start a professional enquiry',
      secondaryHref: '/complex-property-cleaning-london/',
      secondary: 'Complex service assessment'
    },
    unsure: {
      label: 'Find my service',
      heading: 'Not Sure Which Cleaning Service You Need?',
      copy: 'Tell us what you are trying to achieve and we will help you find the right route.',
      href: '/request-a-quote/',
      cta: 'Request a Quote',
      secondaryHref: '/contact/',
      secondary: 'Contact HQC'
    }
  };

  const resultPanel = document.getElementById('selector-result');
  const label = document.getElementById('selector-label');
  const heading = document.getElementById('selector-heading');
  const copy = document.getElementById('selector-copy');
  const primary = document.getElementById('selector-primary');
  const secondary = document.getElementById('selector-secondary');

  document.querySelectorAll<HTMLButtonElement>('.service-choice').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.result as keyof typeof results;
      const result = results[key];
      if (!result || !resultPanel || !label || !heading || !copy || !primary || !secondary) return;
      label.textContent = result.label;
      heading.textContent = result.heading;
      copy.textContent = result.copy;
      primary.textContent = result.cta;
      primary.setAttribute('href', result.href);
      secondary.textContent = result.secondary;
      secondary.setAttribute('href', result.secondaryHref);
      document.querySelectorAll<HTMLButtonElement>('.service-choice').forEach((choice) => {
        choice.setAttribute('aria-pressed', String(choice === button));
      });
      resultPanel.classList.remove('hidden');
      resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      window.dispatchEvent(new CustomEvent('hqc:conversion', { detail: { event: 'service_selector_result', result: key } }));
    });
  });
</script>
