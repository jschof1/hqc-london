---
import type { OutcomePage as OutcomePageData } from '../data/outcome-pages';
import { getPageVisual } from '../data/page-visuals';
import phase8Copy from '../data/phase8-copy.json';
import FounderPortrait from './FounderPortrait.astro';
import MotionKit from './MotionKit.astro';
import '../styles/outcome-page.css';
import { closingCtas, controlledCtaHref } from '../data/controlled-cta-links';
import { sectionImagery } from '../data/section-imagery';
import { outcomePages } from '../data/outcome-pages';
import { cardImage, destinationThumbnails, outcomeCardImagery, relatedRouteImagery, type CardImage } from '../data/card-imagery';

interface Props {
  page: OutcomePageData;
}

const { page } = Astro.props;
const master = phase8Copy[page.slug as keyof typeof phase8Copy];
// Pedro confirmed the 300+ evidence on 12 November. Keep the controlled count
// sections; the Reviews selection itself remains pending a separate decision.
const controlledSections = master?.sections ?? [];
const heroSupport = (master as { heroSupport?: string } | undefined)?.heroSupport;
const visual = getPageVisual(page.slug);
// Approved in-body CTAs are kept as `cta` blocks; consecutive ones share a row.
type CopyBlock = { kind: string; text?: string; items?: string[] };
const groupCtas = (blocks: CopyBlock[]) => blocks.reduce<(CopyBlock | { kind: 'ctas'; labels: string[] })[]>((groups, block) => {
  const last = groups[groups.length - 1];
  if (block.kind !== 'cta') return [...groups, block];
  if (last?.kind === 'ctas') {
    (last as { labels: string[] }).labels.push(block.text ?? '');
    return groups;
  }
  return [...groups, { kind: 'ctas', labels: [block.text ?? ''] }];
}, []);
const closing = closingCtas(page, (master as { closing?: { primary?: string; secondary?: string } } | undefined)?.closing);
// The 'HQC work' heading is used only when every gallery image is a verified HQC library photo.
const galleryIsHqcWork = visual.gallery.every((image) => image.hqc);
const imageryAfter = (heading: string) => (sectionImagery[page.slug] ?? []).find((entry) => entry.after === heading)?.images ?? [];
// Image-led round (10 Nov 2026): card and section images from the generated card library.
// reviews-case-studies has no entry, so its outcome, scope and section copy stays text-only.
const cardImagery = outcomeCardImagery[page.slug];
const outcomeImages = visual.outcomes.map((_, index) => cardImage(cardImagery?.outcomes[index]));
const scopeImages = [...visual.scope, 'confirmed'].map((_, index) => cardImage(cardImagery?.scope[index]));
// A section image is shown only where the section has no existing imagery.
const sectionImage = (heading: string) => imageryAfter(heading).length > 0 ? undefined : cardImage(cardImagery?.sections[heading]);
const imagedSections = controlledSections.map((section) => section.heading).filter((heading) => sectionImage(heading));
// Related routes show the destination's hero, unless that image is already on this page.
const imageKey = (src: string) => src.split('/').pop()!.replace(/-(800|1536|1600)\.webp$/, '').replace(/\.(webp|png|jpe?g)$/i, '');
const pageImageKeys = new Set([
  visual.hero,
  ...visual.gallery.map((image) => image.src),
  ...(sectionImagery[page.slug] ?? []).flatMap((entry) => entry.images.map((image) => image.src)),
  ...outcomeImages.map((image) => image?.src),
  ...scopeImages.map((image) => image?.src),
  ...controlledSections.map((section) => sectionImage(section.heading)?.src)
].filter((src): src is string => Boolean(src)).map(imageKey));
const renderedOutcomeSlugs = outcomePages.map((entry) => entry.slug).filter((slug) => !['request-a-quote', 'cleaning-faqs'].includes(slug));
const relatedImages: CardImage[] = page.related.map((link) => {
  const slug = link.href.replace(/^\/|\/$/g, '');
  const destination = renderedOutcomeSlugs.includes(slug) ? getPageVisual(slug) : undefined;
  // Review B3: only a light WebP hero is used as a thumbnail (its 800px variant when one exists).
  const hero = destination && destination.hero.endsWith('.webp')
    ? { src: destination.hero.replace(/-1600\.webp$/, '-800.webp'), alt: destination.heroAlt }
    : undefined;
  const fallbacks = [
    cardImagery?.related?.[link.href],
    ...(destinationThumbnails[slug] ?? []),
    relatedRouteImagery[link.href]
  ].map((id) => cardImage(id)).filter((image): image is CardImage => Boolean(image));
  const chosen = hero && !pageImageKeys.has(imageKey(hero.src))
    ? hero
    : fallbacks.find((image) => !pageImageKeys.has(imageKey(image.src))) ?? fallbacks[0];
  if (!chosen) throw new Error(`No related-route image for ${link.href} on ${page.slug}`);
  if (pageImageKeys.has(imageKey(chosen.src))) throw new Error(`Related-route image ${chosen.src} repeats on ${page.slug}`);
  pageImageKeys.add(imageKey(chosen.src));
  return chosen;
});
const enquiryType = page.assessment
  ? 'Assessment before quotation'
  : page.slug === 'essential-clean-london'
    ? 'Booking request, followed by HQC review'
    : 'Tailored quotation';

// ---------------------------------------------------------------------------------------------
// Presentation (Jack, 11 Nov 2026): every section picks a composition from its content, the way the
// homepage does, and no two neighbours share one. Copy, order and links are unchanged.
// List items drop trailing semicolons and full stops, as on the homepage (C8).
const listItem = (item: string) => item.replace(/\s*[;.]\s*$/, '');
const numbered = (heading: string) => {
  const match = heading.match(/^(\d+\.)\s+(.*)$/);
  return match ? { num: match[1], rest: match[2] } : null;
};
type Plan = { layout: 'split' | 'stage' | 'icons' | 'columns' | 'cards' | 'statement' | 'text'; image?: CardImage; extra: { src: string; srcset?: string; alt: string }[]; side: 'left' | 'right'; ground: 'white' | 'porcelain' | 'midnight' };
const wordCount = (text = '') => text.trim().split(/\s+/).length;
const isShortLabel = (text = '') => wordCount(text) < 9;
let lastLayout = '';
let splitCount = 0;
let lightIndex = 0;
const plans: Plan[] = controlledSections.map((section, index) => {
  const blocks = section.blocks as CopyBlock[];
  const kinds = blocks.map((block) => block.kind);
  const lists = blocks.filter((block) => block.kind === 'ul');
  const items = lists.flatMap((block) => block.items ?? []);
  const h3s = kinds.filter((kind) => kind === 'h3').length;
  const paragraphs = blocks.filter((block) => block.kind === 'p');
  const after = imageryAfter(section.heading);
  const image = sectionImage(section.heading) ?? (after.length === 1 ? { src: after[0].src, alt: after[0].alt } : undefined);
  const extra = after.length > 1 ? after : [];
  const shortList = lists.length === 1 && items.length <= 9 && items.every((item) => wordCount(item) <= 9);
  let layout: Plan['layout'];
  if (h3s >= 2) layout = 'cards';
  else if (image) layout = 'split';
  else if (lists.length === 0 && paragraphs.length <= 3 && paragraphs.every((block) => wordCount(block.text) <= 45)) layout = 'statement';
  else if (shortList) layout = 'icons';
  else if (lists.length >= 1) layout = 'columns';
  else layout = 'text';
  // Neighbours differ: swap between the two list treatments, and keep statements apart.
  if (layout === lastLayout && layout === 'icons') layout = 'columns';
  else if (layout === lastLayout && layout === 'columns' && shortList) layout = 'icons';
  else if (layout === lastLayout && layout === 'statement') layout = 'text';
  // Photographs alternate between a split and a full-bleed photograph with a floating panel.
  else if (layout === 'split' && lastLayout === 'split') layout = 'stage';
  lastLayout = layout;
  const side = layout === 'split' || layout === 'stage' ? (splitCount++ % 2 === 0 ? 'right' : 'left') : 'right';
  // The last section sits on a light ground so it does not run into the midnight scope band.
  const isLast = index === controlledSections.length - 1;
  const ground = layout === 'statement' && !isLast ? 'midnight' : (lightIndex++ % 2 === 0 ? 'white' : 'porcelain');
  return { layout, image, extra, side, ground };
});
// Photographs appear once per page: the outcome figure avoids the hero, the gallery skips both,
// and the closing band uses a library photograph not shown elsewhere on the page.
const heroKey = imageKey(visual.hero);
const outcomeFigure = visual.gallery.find((image) => imageKey(image.src) !== heroKey) ?? visual.gallery[0];
// The About page shows the founder portrait instead of the outcome figure, so its gallery keeps that photograph.
const outcomeFigureShown = page.slug !== 'about-high-quality-clean';
const shownGallery = page.slug === 'reviews-case-studies' ? [] : visual.gallery.filter((image) => imageKey(image.src) !== heroKey && !(outcomeFigureShown && image.src === outcomeFigure.src));
const closingPool = [...(destinationThumbnails[page.slug] ?? []), 'p-mansion-blocks', 'p-handover-keys', 'r-front-door-keys', 'g-walkthrough']
  .map((id) => cardImage(id as never)).filter((image): image is CardImage => Boolean(image));
const closingImage = closingPool.find((image) => !pageImageKeys.has(imageKey(image.src)) && imageKey(image.src) !== heroKey) ?? closingPool[0];
if (closingImage) pageImageKeys.add(imageKey(closingImage.src));
const evidencePool = closingPool.filter((image) => image !== closingImage);
const evidenceImage = evidencePool.find((image) => !pageImageKeys.has(imageKey(image.src)) && imageKey(image.src) !== heroKey);
if (evidenceImage) pageImageKeys.add(imageKey(evidenceImage.src));
const cols = (count: number) => (count >= 4 && count % 3 !== 0 ? (count === 4 ? 4 : 3) : Math.min(Math.max(count, 1), 3));
---

<MotionKit />
<main class="hm-page outcome-page bg-porcelain pt-20">
  {/* Hero: copy on midnight beside the page photograph. */}
  <section class="op-hero hm-dark bg-midnight text-white">
    <img src={visual.hero} alt={visual.heroAlt} class="op-hero-photo" width="1600" height="1100" fetchpriority="high" />
    <div class="op-hero-copy">
      <nav aria-label="Breadcrumb" class="op-breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>{page.cluster}</span>
      </nav>
      <p class="op-eyebrow">{page.eyebrow}</p>
      <h1 class="op-hero-title font-serif font-medium">{master?.title || page.title}</h1>
      <p class="op-hero-lead">{master?.lead[0] || page.message}</p>
      {master?.lead.slice(1).map((paragraph) => <p class="op-hero-more">{paragraph}</p>)}
      {master?.heroItems.length > 0 && <ul class="op-hero-items">{master.heroItems.map((item) => <li><span>{listItem(item)}</span></li>)}</ul>}
      <div class="op-actions">
        <a class="hm-cta-link" href={page.primaryHref} data-track="primary_cta" data-service={page.slug}>{page.primaryCta}<span class="hm-cta-chip" aria-hidden="true">↗</span></a>
        <a class="hm-cta-link hm-cta-secondary" href={page.secondaryHref} data-track="secondary_cta" data-service={page.slug}>{page.secondaryCta}</a>
      </div>
      {heroSupport && <p class="mt-6 max-w-3xl text-lg leading-8 text-white/85" data-controlled-hero-support>{heroSupport}</p>}
    </div>
  </section>

  <section class="op-facts">
    <div class="op-facts-row">
      <div><p class="meta-label">Service route</p><p class="op-fact">{page.cluster}</p></div>
      <div><p class="meta-label">Designed for</p><p class="op-fact op-fact-quiet">{page.audience}</p></div>
      <div><p class="meta-label">Next step</p><p class="op-fact">{enquiryType}</p></div>
    </div>
  </section>

  {/* Outcome: reasoning beside one photograph, then the three outcomes as photo cards. */}
  <section class="op-outcomes">
    <div class="op-wrap">
      <div class="op-outcome-split">
        <div class="op-col">
          <p class="section-kicker" data-reveal="fade">The outcome comes first</p>
          <h2 class="section-title" data-reveal="title">A service shaped around what has to be ready.</h2>
          <p class="hm-lead mt-6" data-reveal>{page.description}</p>
          <p class="mt-5 text-lg leading-8 text-slate" data-reveal>{visual.note}</p>
        </div>
        {page.slug === 'about-high-quality-clean' ? (
          <div class="op-founder" data-reveal="fade"><FounderPortrait /></div>
        ) : (
          <figure class="op-outcome-photo" data-reveal="clip" style="--hm-cover: var(--color-porcelain)">
            <img src={outcomeFigure.src} alt={outcomeFigure.alt} loading="lazy" decoding="async" width="1000" height="750" />
          </figure>
        )}
      </div>
      <div class="op-outcome-cards" data-stagger="80">
        {visual.outcomes.map((item, index) => (
          <article class="op-outcome-card">
            {outcomeImages[index] && <span class="op-card-media"><img src={outcomeImages[index].src} alt={outcomeImages[index].alt} loading="lazy" decoding="async" width="1200" height="900" /></span>}
            <div class="op-outcome-card-body">
              <span class="op-num" aria-hidden="true">0{index + 1}</span>
              <p>{item}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Controlled copy: each section composed from its content (see the frontmatter). */}
  {master && (
    <div class="op-controlled" data-controlled-copy={master.source}>
      {controlledSections.map((section, sectionIndex) => {
        const plan = plans[sectionIndex];
        const blocks = groupCtas(section.blocks);
        const num = numbered(section.heading);
        const heading = num ? <><span class="op-step-num">{num.num}</span> {num.rest}</> : section.heading;
        const renderBlock = (block: (typeof blocks)[number], index: number, all: typeof blocks, opts: { list?: 'checks' | 'icons' | 'columns'; dark?: boolean } = {}) => {
          if (block.kind === 'h3') return <h3 class="op-h3">{block.text}</h3>;
          if (block.kind === 'ul') {
            const listItems = (block as CopyBlock).items ?? [];
            if (opts.list === 'icons') return (
              <ul class="op-icon-cards" data-stagger="50" data-stagger-type="fade">
                {listItems.map((item) => <li><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5" /><path d="m8 12.4 2.7 2.7L16.2 9.4" /></svg><span>{listItem(item)}</span></li>)}
              </ul>
            );
            return <ul class:list={['hm-checks', opts.list === 'columns' ? 'op-checks-columns' : 'op-checks']} data-stagger="40" data-stagger-type="fade">{listItems.map((item) => <li><span>{listItem(item)}</span></li>)}</ul>;
          }
          if (block.kind === 'ctas') return (
            <p class="op-ctas" data-controlled-cta>
              {(block as { labels: string[] }).labels.map((label, labelIndex) => <a class:list={['hm-cta-link', labelIndex > 0 && 'hm-cta-secondary']} href={controlledCtaHref(label, page)}>{label} <span class="hm-cta-chip" aria-hidden="true">→</span></a>)}
            </p>
          );
          if (block.kind === 'support') return <p class="hm-support">{(block as CopyBlock).text}</p>;
          const next = all[index + 1];
          const first = all.findIndex((entry) => entry.kind === 'p') === index;
          if (next?.kind === 'ul' && isShortLabel((block as CopyBlock).text)) return <p class="op-label">{(block as CopyBlock).text}</p>;
          if (next?.kind === 'ul') return <p class="op-p op-p-strong">{(block as CopyBlock).text}</p>;
          return <p class:list={[first && !opts.dark ? 'hm-lead' : 'op-p']}>{(block as CopyBlock).text}</p>;
        };
        // Split blocks into an introduction (before the first list/h3) and the rest.
        const firstStructured = blocks.findIndex((block, index) => block.kind === 'h3' || block.kind === 'ul' || (block.kind === 'p' && blocks[index + 1]?.kind === 'ul'));
        const intro = firstStructured === -1 ? blocks : blocks.slice(0, firstStructured);
        const rest = firstStructured === -1 ? [] : blocks.slice(firstStructured);
        const groups: { heading: (typeof blocks)[number]; body: typeof blocks }[] = [];
        const outro: typeof blocks = [];
        for (const block of rest) {
          if (block.kind === 'h3') groups.push({ heading: block, body: [] });
          else if (groups.length) groups[groups.length - 1].body.push(block);
          else outro.push(block);
        }
        // Trailing calls to action leave the last card and close the section.
        const lastGroup = groups[groups.length - 1];
        const tail: typeof blocks = [];
        while (lastGroup && lastGroup.body.length && ['ctas', 'support'].includes(lastGroup.body[lastGroup.body.length - 1].kind) && groups.length > 1 && groups.slice(0, -1).every((g) => !g.body.some((b) => b.kind === 'ctas'))) tail.unshift(lastGroup.body.pop()!);
        const extra = plan.extra.length > 0 && (
          <div class="op-strip" data-section-imagery data-stagger="90">
            {plan.extra.map((image) => <figure><img src={image.src} srcset={image.srcset} sizes="(min-width: 640px) 30vw, 100vw" alt={image.alt} loading="lazy" decoding="async" width="1600" height="900" /></figure>)}
          </div>
        );
        const sectionClass = ['op-chapter', `op-l-${plan.layout}`, `op-ground-${plan.ground}`, plan.ground === 'midnight' && 'hm-dark'];

        if (plan.layout === 'split') return (
          <section class:list={[...sectionClass, 'hm-split', plan.side === 'left' ? 'hm-split-media-left' : 'hm-split-media-right']}>
            <div class="hm-split-copy op-col">
              <h2 class="section-title" data-reveal="title">{heading}</h2>
              <div class="op-flow">{blocks.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all, { list: 'checks' })}</div>)}</div>
              {extra}
            </div>
            <figure class="hm-split-media" data-card-imagery="section" data-reveal="clip" style={`--hm-cover: var(--color-${plan.ground === 'white' ? 'white' : 'porcelain'})`}>
              <img src={plan.image!.src} alt={plan.image!.alt} loading="lazy" decoding="async" width="1200" height="900" />
            </figure>
          </section>
        );

        if (plan.layout === 'stage') return (
          <section class:list={[...sectionClass, 'hm-stage', plan.side === 'left' && 'op-stage-left']}>
            <div class="hm-stage-media hm-parallax">
              <img src={plan.image!.src} alt={plan.image!.alt} data-card-imagery="section" loading="lazy" decoding="async" width="1200" height="900" />
            </div>
            <div class="hm-stage-panel op-col" data-reveal={plan.side === 'left' ? 'fade' : 'right'}>
              <h2 class="section-title">{heading}</h2>
              <div class="op-flow">{blocks.map((block, index, all) => renderBlock(block, index, all, { list: 'checks' }))}</div>
              {extra}
            </div>
          </section>
        );

        if (plan.layout === 'icons') return (
          <section class:list={sectionClass}>
            <div class="op-wrap op-icons-grid">
              <div class="op-col">
                <h2 class="section-title" data-reveal="title">{heading}</h2>
                <div class="op-flow">{intro.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all)}</div>)}</div>
              </div>
              <div class="op-flow">
                {rest.map((block, index, all) => block.kind === 'ul' ? renderBlock(block, index, all, { list: 'icons' }) : <div data-reveal>{renderBlock(block, index, all)}</div>)}
              </div>
            </div>
            {extra && <div class="op-wrap">{extra}</div>}
          </section>
        );

        if (plan.layout === 'columns') return (
          <section class:list={sectionClass}>
            <div class="op-wrap">
              <div class="op-head-centre op-col">
                <h2 class="section-title" data-reveal="title">{heading}</h2>
                <div class="op-flow">{intro.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all)}</div>)}</div>
              </div>
              <div class="op-flow op-columns-body">{rest.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all, { list: 'columns' })}</div>)}</div>
              {extra}
            </div>
          </section>
        );

        if (plan.layout === 'cards') {
          const count = groups.length;
          return (
            <section class:list={sectionClass}>
              <div class="op-wrap">
                <div class="op-head-centre op-col">
                  <h2 class="section-title" data-reveal="title">{heading}</h2>
                  <div class="op-flow">{intro.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all)}</div>)}</div>
                </div>
                <div class:list={[plan.image && 'op-cards-with-photo']}>
                {plan.image && <figure class="op-card-photo" data-card-imagery="section" data-reveal="clip" style={`--hm-cover: var(--color-${plan.ground === 'white' ? 'white' : 'porcelain'})`}><img src={plan.image.src} alt={plan.image.alt} loading="lazy" decoding="async" width="1200" height="900" /></figure>}
                <div class:list={['op-cards', plan.image ? 'op-cards-2' : `op-cards-${cols(count)}`]} data-stagger="70">
                  {groups.map((group) => (
                    <article class="op-card">
                      <h3 class="op-card-title">{(group.heading as CopyBlock).text}</h3>
                      {group.body.map((block, index, all) => renderBlock(block, index, all, { list: 'checks' }))}
                    </article>
                  ))}
                </div>
                </div>
                {(outro.length > 0 || tail.length > 0) && <div class="op-flow op-after-cards">{[...outro, ...tail].map((block, index, all) => <div data-reveal>{renderBlock(block, index, all)}</div>)}</div>}
                {extra}
              </div>
            </section>
          );
        }

        if (plan.layout === 'statement') return (
          <section class:list={sectionClass}>
            <div class="op-wrap op-statement-inner">
              <h2 class="section-title" data-reveal="title">{heading}</h2>
              <div class="op-flow">{blocks.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all, { dark: true })}</div>)}</div>
              {extra}
            </div>
          </section>
        );

        return (
          <section class:list={sectionClass}>
            <div class="op-wrap op-text-inner op-col">
              <h2 class="section-title" data-reveal="title">{heading}</h2>
              <div class="op-flow">{blocks.map((block, index, all) => <div data-reveal>{renderBlock(block, index, all, { list: 'checks' })}</div>)}</div>
              {extra}
            </div>
          </section>
        );
      })}
    </div>
  )}

  {!master && page.sections && (
    <section class="border-t border-midnight/10 bg-white py-20 md:py-28">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
        <div class="space-y-20 md:space-y-28">
          {page.sections.map((section, sectionIndex) => (
            <article class="op-fallback-section grid gap-8 lg:grid-cols-[minmax(0,.75fr)_minmax(0,1.25fr)] lg:gap-20">
              <div>
                <p class="section-kicker">{String(sectionIndex + 1).padStart(2, '0')} / {page.cluster}</p>
                <h2 class="section-title">{section.title}</h2>
              </div>
              <div>
                {section.copy?.map((paragraph) => <p class="max-w-3xl text-lg leading-8 text-slate [&+p]:mt-5">{paragraph}</p>)}
                {section.presentation === 'profile' && (
                  <div class="mt-8 overflow-hidden rounded-2xl border border-copper/35 bg-midnight p-6 text-white md:p-8">
                    <p class="text-xs font-bold uppercase tracking-[.2em] text-copper">Site Service Profile</p>
                    <div class="mt-6 grid gap-px overflow-hidden rounded-xl bg-white/15 sm:grid-cols-2 lg:grid-cols-3">
                      {['Areas and tasks', 'Frequencies', 'Access and equipment', 'Site requirements', 'Communication', 'Quality checks'].map((label, index) => (
                        <div class="bg-midnight p-5">
                          <span class="font-serif text-2xl text-copper">0{index + 1}</span>
                          <p class="mt-3 font-semibold text-white">{label}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {section.items && section.presentation === 'lifecycle' && (
                  <ol class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    {section.items.map((item, index) => (
                      <li class="relative rounded-2xl border border-midnight/10 bg-porcelain p-6">
                        <span class="text-xs font-bold uppercase tracking-[.2em] text-copper-ink">Outcome {String(index + 1).padStart(2, '0')}</span>
                        <h3 class="mt-5 font-serif text-2xl font-medium leading-tight text-midnight">{item.title}</h3>
                        <p class="mt-4 leading-7 text-slate">{item.copy}</p>
                        {item.href && <a class="hm-cta-link mt-5" href={item.href}>{item.cta ?? 'Find out more'} <span class="hm-cta-chip" aria-hidden="true">→</span></a>}
                      </li>
                    ))}
                  </ol>
                )}
                {section.items && section.presentation === 'process' && (
                  <ol class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                    {section.items.map((item, index) => (
                      <li class:list={['rounded-2xl border p-5', index === 1 ? 'border-copper bg-copper text-midnight' : 'border-midnight/10 bg-porcelain text-midnight']}>
                        <span class:list={['text-xs font-bold uppercase tracking-[.2em]', index === 1 ? 'text-midnight' : 'text-copper-ink']}>Stage {String(index + 1).padStart(2, '0')}</span>
                        <h3 class="mt-8 font-serif text-2xl font-medium leading-tight">{item.title}</h3>
                        <p class:list={['mt-4 text-sm leading-6', index === 1 ? 'text-midnight/75' : 'text-slate']}>{item.copy}</p>
                      </li>
                    ))}
                  </ol>
                )}
                {section.items && !['lifecycle', 'process'].includes(section.presentation ?? 'cards') && (
                  <div class:list={['grid gap-4', section.items.length > 3 ? 'sm:grid-cols-2' : 'sm:grid-cols-3']}>
                    {section.items.map((item) => (
                      <div class="rounded-2xl border border-midnight/10 bg-porcelain p-6">
                        <h3 class="font-serif text-2xl font-medium leading-tight text-midnight">{item.title}</h3>
                        <p class="mt-4 leading-7 text-slate">{item.copy}</p>
                        {item.href && <a class="hm-cta-link mt-5" href={item.href}>{item.cta ?? 'Find out more'} <span class="hm-cta-chip" aria-hidden="true">→</span></a>}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.slug === 'home-cleaning-london' && (
    <section class="op-chapter op-l-statement op-ground-midnight hm-dark">
      <div class="op-wrap op-statement-inner">
        <p class="section-kicker" data-reveal="fade">Private client work</p>
        <h2 class="section-title" data-reveal="title">Private clients across London</h2>
        <p class="op-p" data-reveal>HQC has worked with private clients across London, including clients who live abroad and rely on us to look after their London properties.</p>
      </div>
    </section>
  )}

  {/* Scope: centred statement over a row of dark photo cards. */}
  <section class="op-scope hm-dark bg-midnight text-white">
    <div class="op-wrap">
      <div class="op-head-centre op-col">
        <p class="section-kicker" data-reveal="fade">What we establish</p>
        <h2 class="section-title" data-reveal="title">Clear inputs. A realistic scope. No guesswork.</h2>
      </div>
      <div class="op-scope-grid" data-stagger="70">
        {visual.scope.map((item, index) => (
          <article class="hm-card hm-card-dark">
            {scopeImages[index] && <span class="hm-card-media"><img src={scopeImages[index].src} alt={scopeImages[index].alt} loading="lazy" decoding="async" width="1200" height="900" /></span>}
            <div class="hm-card-body">
              <span class="op-scope-label">Scope {index + 1}</span>
              <h3 class="op-scope-title">{item}</h3>
            </div>
          </article>
        ))}
        <article class="hm-card hm-card-dark hm-card-featured">
          {scopeImages[visual.scope.length] && <span class="hm-card-media"><img src={scopeImages[visual.scope.length]!.src} alt={scopeImages[visual.scope.length]!.alt} loading="lazy" decoding="async" width="1200" height="900" /></span>}
          <div class="hm-card-body">
            <span class="op-scope-label">Confirmed before work</span>
            <h3 class="op-scope-title">Inclusions, timing and the handover standard</h3>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* Gallery: only photographs not already shown on the page. */}
  {shownGallery.length > 0 && (
    <section class="op-gallery">
      <div class="op-wrap">
        <div class="op-gallery-head">
          <div class="op-col">
            {galleryIsHqcWork ? <p class="section-kicker" data-reveal="fade">HQC work</p> : <p class="section-kicker" data-reveal="fade">Gallery</p>}
            <h2 class="section-title" data-reveal="title">{galleryIsHqcWork ? 'Real spaces. Visible care.' : 'The kinds of spaces we clean'}</h2>
          </div>
          <p class="op-gallery-note" data-reveal>{galleryIsHqcWork ? 'Selected imagery from the HQC project library. ' : ''}The exact scope and finish varies by property, condition and agreed service.</p>
        </div>
        <div class:list={['op-gallery-grid', `op-cards-${cols(shownGallery.length)}`]} data-stagger="80">
          {shownGallery.map((image) => (
            <figure><img src={image.src} alt={image.alt} loading="lazy" decoding="async" width="1000" height="750" /></figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* What happens next: three steps on a copper track. */}
  <section class="op-next">
    <div class="op-wrap">
      <div class="op-head-centre op-col">
        <p class="section-kicker" data-reveal="fade">What happens next</p>
        <h2 class="section-title" data-reveal="title">A calm route from enquiry to result.</h2>
      </div>
      <ol class="op-steps" data-stagger="90">
        {[
          ['Tell us what has to be achieved', 'Share the property, condition, timing and any access or operational constraints.'],
          ['HQC confirms the right route', page.slug === 'essential-clean-london' ? 'Submit a booking request. HQC reviews suitability, availability, cleaner allocation and payment requirements before confirming.' : page.assessment ? 'We arrange the information or assessment needed to define a responsible scope.' : 'We review the details and prepare the appropriate tailored quotation.'],
          ['The scope is agreed', 'You receive a clear route forward with the relevant inclusions, assumptions and next steps.']
        ].map(([title, copy], index) => (
          <li>
            <span class="op-step-badge" aria-hidden="true">0{index + 1}</span>
            <h3 class="op-card-title">{title}</h3>
            <p class="op-p">{copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Related routes: photo cards, as many columns as there are routes. */}
  <section class="op-related">
    <div class="op-wrap">
      <p class="section-kicker" data-reveal="fade">Related routes</p>
      <div class:list={['op-related-grid', `op-cards-${cols(page.related.length)}`]} data-stagger="80">
        {page.related.map((link, index) => (
          <a class="hm-route group flex flex-col overflow-hidden rounded-[1.25rem] bg-white text-inherit no-underline" href={link.href}>
            <span class="hm-route-media block overflow-hidden"><img src={relatedImages[index].src} alt={relatedImages[index].alt} class="aspect-[16/10] w-full object-cover" loading="lazy" decoding="async" width="1200" height="675" /></span>
            <span class="op-related-body">
              <span class="meta-label" aria-hidden="true">0{index + 1}</span>
              <span class="op-related-title">{link.label}</span>
              <span class="hm-cta-chip op-related-chip" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Closing: a photograph not used elsewhere on the page, flat tint, centred actions. */}
  <section class="op-closing hm-dark hm-parallax">
    {closingImage && <img class="op-closing-photo" src={closingImage.src} alt="" aria-hidden="true" loading="lazy" decoding="async" width="1200" height="900" />}
    <div class="op-closing-content">
      <p class="section-kicker" data-reveal="fade">The next step is simple</p>
      <h2 class="section-title" data-reveal="title">{closing.primary.label}</h2>
      <div class="op-actions op-actions-centre" data-closing-cta data-reveal>
        <a class="hm-cta-link" href={closing.primary.href}>{closing.primary.label}<span class="hm-cta-chip" aria-hidden="true">↗</span></a>
        {closing.secondary && <a class="hm-cta-link hm-cta-secondary" href={closing.secondary.href}>{closing.secondary.label}</a>}
      </div>
    </div>
  </section>
</main>
