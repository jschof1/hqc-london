---
import type { OutcomePage as OutcomePageData } from '../data/outcome-pages';
import { getPageVisual } from '../data/page-visuals';
import phase8Copy from '../data/phase8-copy.json';
import FounderPortrait from './FounderPortrait.astro';
import ClientEvidence from './ClientEvidence.astro';
import { closingCtas, controlledCtaHref } from '../data/controlled-cta-links';
import { sectionImagery } from '../data/section-imagery';

interface Props {
  page: OutcomePageData;
}

const { page } = Astro.props;
const master = phase8Copy[page.slug as keyof typeof phase8Copy];
// The approved draft reserves a client-count proof position; publish it only
// after Pedro supplies the substantiation required by the Release Pack.
// On these two pages the approved count section also carries generic evidence wording
// (final reconciliation, 6 Nov 2026). Keep that wording under a neutral heading and drop
// only the client-count heading and sentence. Other count sections stay withheld.
const countClaim = /300\+?|three hundred/i;
const keepEvidenceLines = ['about-high-quality-clean', 'reviews-case-studies'];
const controlledSections = master?.sections
  .map((section) => !countClaim.test(section.heading) || !keepEvidenceLines.includes(page.slug) ? section : {
    ...section,
    heading: 'Client Evidence',
    blocks: section.blocks.filter((block) => block.kind !== 'p' || !countClaim.test(block.text ?? ''))
  })
  .filter((section) => !countClaim.test(section.heading))
  .map((section) => {
    const reviewFormat = section.blocks.findIndex((block) => block.kind === 'h3' && block.text === 'Review format');
    if (page.slug !== 'reviews-case-studies' || reviewFormat === -1) return section;
    return {
      ...section,
      blocks: [
        ...section.blocks.slice(0, reviewFormat),
        { kind: 'h3' as const, text: 'Residential review evidence' },
        { kind: 'p' as const, text: 'Verified review text, public attribution and client permission are required before publication.' }
      ]
    };
  }) ?? [];
const visual = getPageVisual(page.slug);
// Approved in-body CTAs are kept as `cta` blocks; consecutive ones share a row.
type CopyBlock = { kind: string; text?: string; items?: string[] };
const groupCtas = (blocks: CopyBlock[]) => blocks.reduce<(CopyBlock | { kind: 'ctas'; labels: string[] })[]>((groups, block) => {
  const last = groups[groups.length - 1];
  if (block.kind !== 'cta') return [...groups, block];
  if (last?.kind === 'ctas') {
    (last as { labels: string[] }).labels.push(block.text ?? '');
    return groups;
  }
  return [...groups, { kind: 'ctas', labels: [block.text ?? ''] }];
}, []);
const closing = closingCtas(page, (master as { closing?: { primary?: string; secondary?: string } } | undefined)?.closing);
// The 'HQC work' heading is used only when every gallery image is a verified HQC library photo.
const galleryIsHqcWork = visual.gallery.every((image) => image.hqc);
const imageryAfter = (heading: string) => (sectionImagery[page.slug] ?? []).find((entry) => entry.after === heading)?.images ?? [];
const enquiryType = page.assessment
  ? 'Assessment before quotation'
  : page.slug === 'essential-clean-london'
    ? 'Booking request, followed by HQC review'
    : 'Tailored quotation';
---

<main class="bg-porcelain pt-20">
  <section class="relative min-h-[700px] overflow-hidden bg-midnight text-white">
    <img
      src={visual.hero}
      alt={visual.heroAlt}
      class="absolute inset-0 h-full w-full object-cover"
      width="1600"
      height="1100"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(12,30,36,.96)_0%,rgba(12,30,36,.88)_44%,rgba(12,30,36,.22)_78%,rgba(12,30,36,.08)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-midnight/70 to-transparent"></div>

    <div class="relative mx-auto flex min-h-[700px] max-w-[1440px] flex-col justify-end px-5 pb-16 pt-28 sm:px-8 md:pb-24 lg:px-14">
      <nav aria-label="Breadcrumb" class="mb-auto flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/65">
        <a href="/" class="text-white/65 no-underline hover:text-copper">Home</a>
        <span aria-hidden="true">/</span>
        <span>{page.cluster}</span>
      </nav>

      <div class="max-w-4xl">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.25em] text-copper md:text-sm">{page.eyebrow}</p>
        <h1 class="font-serif text-[clamp(3rem,6.2vw,6.6rem)] font-medium leading-[.92] tracking-[-0.035em] text-white">{master?.title || page.title}</h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/82 md:text-2xl">{master?.lead[0] || page.message}</p>
        {master?.lead.slice(1).map((paragraph) => <p class="mt-3 max-w-2xl leading-7 text-white/80">{paragraph}</p>)}
        {master?.heroItems.length > 0 && <ul class="mt-4 list-disc space-y-1 pl-6 text-white/80">{master.heroItems.map((item) => <li>{item}</li>)}</ul>}
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="button button-primary" href={page.primaryHref} data-track="primary_cta" data-service={page.slug}>
            {page.primaryCta}<span aria-hidden="true">↗</span>
          </a>
          <a class="button button-ghost" href={page.secondaryHref} data-track="secondary_cta" data-service={page.slug}>
            {page.secondaryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-midnight/10 bg-white">
    <div class="mx-auto grid max-w-[1440px] divide-y divide-midnight/10 px-5 sm:px-8 md:grid-cols-3 md:divide-x md:divide-y-0 lg:px-14">
      <div class="py-6 md:pr-8">
        <p class="meta-label">Service route</p>
        <p class="mt-2 font-semibold text-midnight">{page.cluster}</p>
      </div>
      <div class="py-6 md:px-8">
        <p class="meta-label">Designed for</p>
        <p class="mt-2 text-sm leading-relaxed text-slate">{page.audience}</p>
      </div>
      <div class="py-6 md:pl-8">
        <p class="meta-label">Next step</p>
        <p class="mt-2 font-semibold text-midnight">{enquiryType}</p>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="grid items-start gap-14 lg:grid-cols-[.88fr_1.12fr] lg:gap-24">
      <div class="lg:sticky lg:top-28">
        <p class="section-kicker">The outcome comes first</p>
        <h2 class="section-title">A service shaped around what has to be ready.</h2>
        <p class="mt-7 text-lg leading-8 text-slate">{page.description}</p>
        <p class="mt-5 leading-7 text-slate">{visual.note}</p>
      </div>

      <div>
        {page.slug === 'about-high-quality-clean' ? <FounderPortrait /> : (
          <figure class="overflow-hidden rounded-[2rem] bg-white shadow-[0_24px_70px_rgba(14,36,42,.12)]">
            <img src={visual.gallery[0].src} alt={visual.gallery[0].alt} class="aspect-[4/3] w-full object-cover" loading="lazy" width="1000" height="750" />
            {!visual.gallery[0].hqc && <figcaption class="px-5 py-2 text-xs font-semibold uppercase tracking-[.14em] text-slate">Illustrative image</figcaption>}
          </figure>
        )}
        <div class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-midnight/10 bg-midnight/10 sm:grid-cols-3">
          {visual.outcomes.map((item, index) => (
            <div class="bg-white p-6">
              <span class="font-serif text-3xl text-copper-ink">0{index + 1}</span>
              <p class="mt-5 font-semibold leading-snug text-midnight">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {master && (
    <section class="border-t border-midnight/10 bg-white py-20 md:py-28" data-controlled-copy={master.source}>
      <div class="mx-auto max-w-5xl space-y-14 px-5 sm:px-8 lg:px-14">
        {controlledSections.map((section) => (
          <section class="border-b border-midnight/10 pb-12 last:border-b-0 last:pb-0">
            <h2 class="font-serif text-3xl font-medium text-midnight md:text-4xl">{section.heading}</h2>
            <div class="mt-5 space-y-4 text-lg leading-8 text-slate">
              {groupCtas(section.blocks).map((block) => (
                block.kind === 'h3' ? <h3 class="pt-4 font-serif text-2xl font-medium text-midnight">{block.text}</h3> :
                block.kind === 'ul' ? <ul class="list-disc space-y-2 pl-6">{block.items.map((item) => <li>{item}</li>)}</ul> :
                block.kind === 'ctas' ? (
                  <p class="flex flex-wrap gap-x-7 gap-y-2 text-base" data-controlled-cta>
                    {block.labels.map((label) => <a class="inline-flex font-bold text-midnight no-underline hover:text-copper-ink" href={controlledCtaHref(label, page)}>{label} <span class="ml-2 text-copper-ink" aria-hidden="true">→</span></a>)}
                  </p>
                ) :
                block.kind === 'support' ? <p class="font-semibold text-midnight">{block.text}</p> :
                <p>{block.text}</p>
              ))}
            </div>
            {imageryAfter(section.heading).length > 0 && (
              <div class:list={['mt-10 grid gap-4', imageryAfter(section.heading).length > 1 && 'sm:grid-cols-3']} data-section-imagery>
                {imageryAfter(section.heading).map((image) => (
                  <figure class="overflow-hidden rounded-2xl bg-midnight">
                    <img src={image.src} srcset={image.srcset} sizes={imageryAfter(section.heading).length > 1 ? '(min-width: 640px) 30vw, 100vw' : '(min-width: 1024px) 896px, 100vw'} alt={image.alt} class="aspect-[16/9] w-full object-cover" loading="lazy" width="1600" height="900" />
                    {image.illustrative && <figcaption class="bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[.14em] text-slate">Illustrative image</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    </section>
  )}

  {!master && page.sections && (
    <section class="border-t border-midnight/10 bg-white py-20 md:py-28">
      <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
        <div class="space-y-20 md:space-y-28">
          {page.sections.map((section, sectionIndex) => (
            <article class="grid gap-8 lg:grid-cols-[minmax(0,.75fr)_minmax(0,1.25fr)] lg:gap-20">
              <div>
                <p class="section-kicker">{String(sectionIndex + 1).padStart(2, '0')} / {page.cluster}</p>
                <h2 class="section-title">{section.title}</h2>
              </div>
              <div>
                {section.copy?.map((paragraph) => <p class="max-w-3xl text-lg leading-8 text-slate [&+p]:mt-5">{paragraph}</p>)}
                {section.presentation === 'profile' && (
                  <div class="mt-8 overflow-hidden rounded-2xl border border-copper/35 bg-midnight p-6 text-white md:p-8">
                    <p class="text-xs font-bold uppercase tracking-[.2em] text-copper">Site Service Profile</p>
                    <div class="mt-6 grid gap-px overflow-hidden rounded-xl bg-white/15 sm:grid-cols-2 lg:grid-cols-3">
                      {['Areas and tasks', 'Frequencies', 'Access and equipment', 'Site requirements', 'Communication', 'Quality checks'].map((label, index) => (
                        <div class="bg-midnight p-5">
                          <span class="font-serif text-2xl text-copper">0{index + 1}</span>
                          <p class="mt-3 font-semibold text-white">{label}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {section.items && section.presentation === 'lifecycle' && (
                  <ol class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    {section.items.map((item, index) => (
                      <li class="relative rounded-2xl border border-midnight/10 bg-porcelain p-6">
                        <span class="text-xs font-bold uppercase tracking-[.2em] text-copper-ink">Outcome {String(index + 1).padStart(2, '0')}</span>
                        <h3 class="mt-5 font-serif text-2xl font-medium leading-tight text-midnight">{item.title}</h3>
                        <p class="mt-4 leading-7 text-slate">{item.copy}</p>
                        {item.href && <a class="mt-5 inline-flex font-bold text-midnight no-underline hover:text-copper-ink" href={item.href}>{item.cta ?? 'Find out more'} <span aria-hidden="true">→</span></a>}
                      </li>
                    ))}
                  </ol>
                )}
                {section.items && section.presentation === 'process' && (
                  <ol class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                    {section.items.map((item, index) => (
                      <li class:list={['rounded-2xl border p-5', index === 1 ? 'border-copper bg-copper text-midnight' : 'border-midnight/10 bg-porcelain text-midnight']}>
                        <span class:list={['text-xs font-bold uppercase tracking-[.2em]', index === 1 ? 'text-midnight' : 'text-copper-ink']}>Stage {String(index + 1).padStart(2, '0')}</span>
                        <h3 class="mt-8 font-serif text-2xl font-medium leading-tight">{item.title}</h3>
                        <p class:list={['mt-4 text-sm leading-6', index === 1 ? 'text-midnight/75' : 'text-slate']}>{item.copy}</p>
                      </li>
                    ))}
                  </ol>
                )}
                {section.items && !['lifecycle', 'process'].includes(section.presentation ?? 'cards') && (
                  <div class:list={['grid gap-4', section.items.length > 3 ? 'sm:grid-cols-2' : 'sm:grid-cols-3']}>
                    {section.items.map((item) => (
                      <div class="rounded-2xl border border-midnight/10 bg-porcelain p-6">
                        <h3 class="font-serif text-2xl font-medium leading-tight text-midnight">{item.title}</h3>
                        <p class="mt-4 leading-7 text-slate">{item.copy}</p>
                        {item.href && <a class="mt-5 inline-flex font-bold text-midnight no-underline hover:text-copper-ink" href={item.href}>{item.cta ?? 'Find out more'} <span aria-hidden="true">→</span></a>}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.slug === 'home-cleaning-london' && (
    <section class="border-t border-midnight/10 bg-midnight py-20 text-white md:py-28">
      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:px-14">
        <div>
          <p class="section-kicker text-copper">Private client work</p>
          <h2 class="mt-4 font-serif text-4xl font-medium leading-tight md:text-6xl">Private clients across London</h2>
        </div>
        <div>
          <p class="max-w-3xl text-lg leading-8 text-white/75">HQC has worked with private clients across London, including clients who live abroad and rely on us to look after their London properties.</p>
        </div>
      </div>
    </section>
  )}

  {['home-cleaning-london', 'property-facilities-cleaning-london', 'office-cleaning-london', 'reviews-case-studies'].includes(page.slug) && (
    <ClientEvidence scope={page.slug === 'home-cleaning-london' ? 'residential' : page.slug === 'reviews-case-studies' ? 'all' : 'commercial'} />
  )}

  <section class="bg-midnight py-20 text-white md:py-28">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="section-kicker text-copper">What we establish</p>
          <h2 class="font-serif text-4xl font-medium leading-tight tracking-tight md:text-6xl">Clear inputs. A realistic scope. No guesswork.</h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {visual.scope.map((item, index) => (
            <article class:list={['rounded-2xl border p-6 md:p-8', index === 0 ? 'border-copper bg-copper text-midnight' : 'border-white/15 bg-white/[.04]']}>
              <span class:list={['text-xs font-bold uppercase tracking-[.2em]', index === 0 ? 'text-midnight' : 'text-copper']}>Scope {index + 1}</span>
              <h3 class="mt-8 font-serif text-2xl font-medium md:text-3xl">{item}</h3>
            </article>
          ))}
          <article class="rounded-2xl border border-white/15 bg-white/[.04] p-6 md:p-8">
            <span class="text-xs font-bold uppercase tracking-[.2em] text-copper">Confirmed before work</span>
            <h3 class="mt-8 font-serif text-2xl font-medium md:text-3xl">Inclusions, timing and the handover standard</h3>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      {galleryIsHqcWork ? (
        <div class="max-w-3xl">
          <p class="section-kicker">HQC work</p>
          <h2 class="section-title">Real spaces. Visible care.</h2>
        </div>
      ) : (
        <div class="max-w-3xl">
          <p class="section-kicker">Illustrative imagery</p>
          <h2 class="section-title">Illustrative images</h2>
        </div>
      )}
      <p class="max-w-md text-sm leading-6 text-slate">{galleryIsHqcWork ? 'Selected imagery from the HQC project library.' : 'These images are illustrative and are not presented as records of specific HQC jobs.'} The exact scope and finish varies by property, condition and agreed service.</p>
    </div>
    <div class="mt-12 grid auto-rows-[220px] gap-4 md:grid-cols-12 md:auto-rows-[250px]">
      {visual.gallery.map((image, index) => (
        <figure class:list={['group relative overflow-hidden rounded-2xl bg-midnight', index === 0 ? 'md:col-span-7 md:row-span-2' : 'md:col-span-5']}>
          <img src={image.src} alt={image.alt} class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" loading="lazy" width="1000" height="750" />
          <div class="absolute inset-0 bg-gradient-to-t from-midnight/50 via-transparent to-transparent opacity-70"></div>
          {!image.hqc && <figcaption class="absolute bottom-3 left-3 rounded-full bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[.12em] text-midnight">Illustrative image</figcaption>}
        </figure>
      ))}
    </div>
  </section>

  <section class="border-y border-midnight/10 bg-white py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="section-kicker">What happens next</p>
          <h2 class="section-title">A calm route from enquiry to result.</h2>
        </div>
        <ol class="divide-y divide-midnight/10 border-y border-midnight/10">
          {[
            ['Tell us what has to be achieved', 'Share the property, condition, timing and any access or operational constraints.'],
            ['HQC confirms the right route', page.slug === 'essential-clean-london' ? 'Submit a booking request. HQC reviews suitability, availability, cleaner allocation and payment requirements before confirming.' : page.assessment ? 'We arrange the information or assessment needed to define a responsible scope.' : 'We review the details and prepare the appropriate tailored quotation.'],
            ['The scope is agreed', 'You receive a clear route forward with the relevant inclusions, assumptions and next steps.']
          ].map(([title, copy], index) => (
            <li class="grid gap-4 py-7 sm:grid-cols-[4rem_1fr]">
              <span class="font-serif text-3xl text-copper-ink">0{index + 1}</span>
              <div><h3 class="font-serif text-2xl font-medium text-midnight">{title}</h3><p class="mt-2 leading-7 text-slate">{copy}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-porcelain py-20">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-14">
      <p class="section-kicker">Related routes</p>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {page.related.map((link, index) => (
          <a class="group flex min-h-40 flex-col justify-between rounded-2xl border border-midnight/10 bg-white p-6 text-midnight no-underline transition hover:-translate-y-1 hover:border-copper hover:shadow-xl" href={link.href}>
            <span class="meta-label">0{index + 1}</span>
            <span class="flex items-end justify-between gap-5 font-serif text-2xl font-medium">{link.label}<span class="text-copper-ink transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-copper py-16 text-midnight md:py-20">
    <div class="absolute -right-16 -top-32 h-80 w-80 rounded-full border border-midnight/15"></div>
    <div class="relative mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-8 px-5 sm:px-8 md:flex-row md:items-center lg:px-14">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.22em] text-midnight">The next step is simple</p>
        <h2 class="mt-3 max-w-3xl font-serif text-4xl font-medium leading-tight md:text-6xl">{closing.primary.label}</h2>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row" data-closing-cta>
        <a class="button button-dark" href={closing.primary.href}>{closing.primary.label}<span aria-hidden="true">↗</span></a>
        {closing.secondary && <a class="button border border-midnight/30 text-midnight hover:border-midnight" href={closing.secondary.href}>{closing.secondary.label}</a>}
      </div>
    </div>
  </section>
</main>
