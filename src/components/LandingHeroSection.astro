---
export interface ReviewBadge {
  icon: string;
  text: string;
}

export interface TrustLogo {
  type: 'svg' | 'image';
  content: string;
  alt: string;
  link: string;
}

export interface CtaButton {
  text: string;
  href: string;
  type: 'primary' | 'secondary';
  id?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  videoSrc?: string;
  fallbackImage?: string;
  fallbackImageAlt?: string;
  reviewBadge?: ReviewBadge | null;
  starRating?: number;
  ctaButtons?: CtaButton[];
  trustText?: string;
  trustLogos?: TrustLogo[];
  className?: string;
}

const {
  title = "Calm, high-standard cleaning for London homes and client-facing spaces",
  subtitle = "High Quality Clean restores calm, confidence and control with carefully scoped home, commercial and managed-property cleaning across London.",
  videoSrc = "/videos/hero.mp4",
  fallbackImage = "/images/instock/IMG-20250812-WA0018.jpg",
  fallbackImageAlt = "Calm London apartment interior prepared for premium cleaning",
  reviewBadge = null,
  starRating = 0,
  ctaButtons = [
    {
      text: "Request Your Personalised Quote",
      href: "/quote/",
      type: "primary",
      id: "hero-cta"
    },
    {
      text: "View Home Cleaning Tiers",
      href: "#service-tiers",
      type: "secondary"
    }
  ],
  trustText = "Personalised quote before work begins. Clear scope, careful access and the finish agreed in advance.",
  trustLogos = [],
  className = ""
} = Astro.props;
---

<section class={`relative overflow-hidden bg-porcelain ${className}`}>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(185,151,91,0.12),transparent_34%),linear-gradient(135deg,rgba(216,231,236,0.42),transparent_38%)]" aria-hidden="true"></div>

  <div class="relative mx-auto grid min-h-[calc(100vh-4rem)] max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brass">
        Premium London property care
      </p>

      {reviewBadge && (
        <div class="mt-5 inline-flex items-center rounded-full border border-brass/30 bg-white/80 px-4 py-2 text-sm font-semibold text-night shadow-soft-sm">
          <span set:html={reviewBadge.icon}></span>
          <span class="ml-2">{reviewBadge.text}</span>
        </div>
      )}

      {starRating > 0 && (
        <div class="mt-5 flex items-center gap-2 text-brass" aria-label={`${starRating} star rating`}>
          {Array.from({ length: starRating }).map(() => (
            <span class="text-lg" aria-hidden="true">★</span>
          ))}
        </div>
      )}

      <h1 class="mt-6 font-serif text-4xl font-semibold leading-[1.04] text-night sm:text-5xl md:text-6xl">
        {title}
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/74 md:text-xl">
        {subtitle}
      </p>

      {ctaButtons.length > 0 && (
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          {ctaButtons.map((button) => (
            <a
              id={button.id}
              href={button.href}
              class:list={[
                'inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-semibold no-underline transition duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2',
                button.type === 'primary'
                  ? 'bg-brass text-night shadow-brass hover:bg-brass/90 hover:-translate-y-0.5'
                  : 'border border-night/15 bg-white/70 text-night hover:border-brass hover:bg-white',
              ]}
            >
              <span>{button.text}</span>
              {button.type === 'primary' && (
                <svg class="ml-2 h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M4.79688 11.5117H18.2274M18.2274 11.5117L11.5121 4.79639M18.2274 11.5117L11.5121 18.2269" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          ))}
        </div>
      )}

      {trustText && (
        <p class="mt-7 max-w-xl text-sm leading-relaxed text-ink/62">
          {trustText}
        </p>
      )}

      {trustLogos.length > 0 && (
        <div class="mt-6 flex flex-wrap items-center gap-5">
          {trustLogos.map((logo) => (
            <a href={logo.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs text-ink/62 no-underline hover:text-brass">
              <span class="flex h-7 w-7 items-center justify-center rounded-full border border-stone bg-white">
                {logo.type === 'svg' ? (
                  <span set:html={logo.content}></span>
                ) : (
                  <img src={logo.content} alt={logo.alt} class="h-full w-full object-contain opacity-70" />
                )}
              </span>
              <span>{logo.alt}</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="relative">
      <div class="absolute -left-6 top-8 h-32 w-32 rounded-full bg-sage/70 blur-3xl" aria-hidden="true"></div>
      <div class="relative overflow-hidden rounded-[2rem] border border-white bg-white p-3 shadow-panel">
        <img
          src={fallbackImage}
          alt={fallbackImageAlt}
          class="h-[420px] w-full rounded-[1.45rem] object-cover md:h-[560px]"
          fetchpriority="high"
        />
        <div class="absolute inset-x-6 bottom-6 rounded-2xl border border-white/35 bg-night/78 p-5 text-white backdrop-blur-sm">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass">The HQC approach</p>
          <p class="mt-2 text-sm leading-relaxed text-white/86">
            A calmer service conversation: property type, access, surfaces, desired finish and recurring fit confirmed before the team starts.
          </p>
        </div>
      </div>

      {videoSrc && (
        <div class="absolute -bottom-8 right-2 hidden w-56 overflow-hidden rounded-2xl border border-white bg-white p-2 shadow-soft md:block">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={fallbackImage}
            class="h-32 w-full rounded-xl object-cover"
            aria-label="Temporary atmospheric cleaning video"
          >
            <source src={videoSrc} type="video/mp4" />
            <img src={fallbackImage} alt="Premium cleaning atmosphere still" class="h-32 w-full object-cover" />
          </video>
          <p class="px-1 pt-2 text-[11px] leading-snug text-ink/58">
            Temporary atmosphere only. Real proof appears below.
          </p>
        </div>
      )}
    </div>
  </div>
</section>
