---
export interface ReviewBadge {
  icon: string;
  text: string;
}

export interface TrustLogo {
  type: 'svg' | 'image';
  content: string;
  alt: string;
  link: string;
}

export interface CtaButton {
  text: string;
  href: string;
  type: 'primary' | 'secondary';
  id?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  videoSrc?: string;
  fallbackImage?: string;
  fallbackImageAlt?: string;
  reviewBadge?: ReviewBadge | null;
  starRating?: number;
  ctaButtons?: CtaButton[];
  trustText?: string;
  trustLogos?: TrustLogo[];
  className?: string;
}

const {
  title = "High-standard London cleaning for homes, property teams and premium spaces",
  subtitle = "Clear scopes, careful handling and dependable presentation for regular cleaning, turnovers, offices and post-works resets.",
  videoSrc = "/videos/hero.mp4",
  fallbackImage = "/images/areas/mayfair.webp",
  fallbackImageAlt = "Clean London home interior",
  reviewBadge = null,
  starRating = 0,
  ctaButtons = [
    {
      text: "Request a Cleaning Quote",
      href: "/quote/",
      type: "primary",
      id: "hero-cta"
    },
    {
      text: "View Cleaning Routes",
      href: "#buyer-routes",
      type: "secondary"
    }
  ],
  trustText = "Start with the route that fits your space, then request a scoped quote.",
  trustLogos = [],
  className = ""
} = Astro.props;
---
<section class="max-w-[100vw] overflow-hidden bg-white border-b border-gold/20 py-3 md:py-4">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="grid grid-cols-2 items-center justify-center gap-3 text-center text-[11px] text-ink/60 sm:text-xs md:flex md:flex-wrap md:gap-6 lg:gap-8">
    <div class="flex min-w-0 items-center justify-center gap-2">
    <svg class="w-4 h-4 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
    </svg>
    <span class="min-w-0 truncate">Clear Scopes</span>
    </div>
    <div class="flex min-w-0 items-center justify-center gap-2">
    <svg class="w-4 h-4 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
    </svg>
    <span class="min-w-0 truncate">Careful Handling</span>
    </div>
    <div class="flex min-w-0 items-center justify-center gap-2">
    <svg class="w-4 h-4 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
    </svg>
    <span class="min-w-0 truncate">Ready Spaces</span>
    </div>
    <div class="flex min-w-0 items-center justify-center gap-2">
    <svg class="w-4 h-4 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
    </svg>
    <span class="min-w-0 truncate">Quote Before Work Begins</span>
    </div>
  </div>
  </div>
</section>
<section class={`relative bg-navy min-h-[72dvh] w-full max-w-full flex items-center justify-center overflow-hidden ${className}`}>
  <div class="absolute inset-0 h-full w-full">
    <!-- Video background -->
    <video
      autoplay
      muted
      loop
      playsinline
      class="image-transition h-full w-full object-cover"
    >
      <source src={videoSrc} type="video/mp4">
      <!-- Fallback image if video fails to load -->
      <img
        src={fallbackImage}
        alt={fallbackImageAlt}
        class="image-transition h-full w-full object-cover"
      />
    </video>

    <!-- Enhanced overlay for better text visibility -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-navy/85 via-navy/60 to-navy/40"
    ></div>
  </div>
  
  <!-- Hero copy + CTAs - Centered within the hero section -->
  <div class="font-serif relative z-10 mx-auto flex min-w-0 flex-col items-center justify-center flex-1 w-[100dvw] max-w-[100dvw] px-5 sm:w-full sm:max-w-7xl md:px-16 lg:px-24 xl:px-32">
    <div class="text-transition mx-auto w-full max-w-5xl text-center">
          <!-- Star Rating with Lines -->

    {reviewBadge && (
      <div class="flex items-center justify-center pb-1">
        <span class="inline-flex items-center bg-navy/60 rounded-full px-2 py-1 bg-auto">
          <span set:html={reviewBadge.icon}></span>
          <span class="text-white font-semibold text-base ml-2">{reviewBadge.text}</span>
        </span>
      </div>
    )}
    {starRating > 0 && (
      <div class="flex items-center justify-center gap-2 mb-4">
        <div class="h-px w-8 bg-gold/60"></div>
        <div class="flex items-center gap-1">
          {Array.from({ length: starRating }).map((_, i) => (
            <span
              class="text-xl"
              style="
                background: linear-gradient(90deg, #C9A961 0%, #FFD700 50%, #FDE68A 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                text-fill-color: transparent;
                display: inline-block;
              "
              aria-hidden="true"
            >★</span>
          ))}
        </div>
        <div class="h-px w-8 bg-yellow-200/60"></div>
      </div>
    )}
    <h1 class="mx-auto w-full min-w-0 max-w-[16.5rem] text-center text-[1.85rem] font-medium leading-tight bg-gradient-to-r from-gold via-gold to-yellow-300 text-transparent bg-clip-text break-words sm:max-w-3xl sm:text-4xl lg:max-w-5xl lg:text-6xl">
      {title}
    </h1>
    
    <p class="w-full min-w-0 text-slate-100 md:text-lg text-center max-w-2xl mt-4 leading-relaxed lg:text-center mx-auto">
      {subtitle}
    </p>
    </div>

    {ctaButtons.length > 0 && (
      <div class="text-transition flex w-full items-center justify-center gap-3 mt-8 sm:flex-row flex-col">
        {ctaButtons.map((button) => (
          <a
            id={button.id}
            href={button.href}
            class={
              button.type === 'primary'
                ? "flex w-full max-w-sm min-w-0 items-center justify-center gap-2 px-6 py-3 text-center bg-gold hover:bg-gold/90 text-navy font-semibold transition rounded-full shadow-2xl hover:shadow-3xl hover:scale-105 duration-300 sm:w-auto sm:px-8"
                : "flex w-full max-w-sm min-w-0 items-center justify-center bg-white/10 border border-white/15 rounded-full px-6 py-3 text-center text-white hover:bg-white/20 transition duration-300 sm:w-auto sm:px-8"
            }
          >
            <span>{button.text}</span>
            {button.type === 'primary' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.79688 11.5117H18.2274M18.2274 11.5117L11.5121 4.79639M18.2274 11.5117L11.5121 18.2269"
                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
        ))}
      </div>
    )}

    {trustText && (
      <p class="w-full min-w-0 text-slate-300 mt-10 text-sm text-center">{trustText}</p>
    )}

    {trustLogos.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-8 mt-6">
        {trustLogos.map((logo) => (
            <a href={logo.link} target="_blank" rel="noopener noreferrer">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-full flex items-center justify-center">
              {logo.type === 'svg' ? (
                <div set:html={logo.content}></div>
              ) : (
                <img src={logo.content} alt={logo.alt} class="w-full h-full object-contain opacity-60"
                />  
             
              )}
            </div>
            <span class="text-xs text-slate-100">{logo.alt}</span>
          </div>
            </a>
        ))}
      </div>
    )}
  </div>
</section>
