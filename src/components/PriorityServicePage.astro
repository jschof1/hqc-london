---
import type { ServicePageEntry } from '../data/servicePages';

type LinkItem = {
  label: string;
  href: string;
};

type FaqItem = {
  question: string;
  answer: string;
};

export interface Props {
  page: ServicePageEntry;
  eyebrow?: string;
  intro: string;
  inclusions: string[];
  audiences: string[];
  process: string[];
  links: LinkItem[];
  faqs?: FaqItem[];
  coverageNote?: string;
}

const {
  page,
  eyebrow = 'Priority cleaning service',
  intro,
  inclusions,
  audiences,
  process,
  links,
  faqs = [],
  coverageNote,
} = Astro.props;
---

<main>
  <section class="bg-navy text-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-24 lg:px-8">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-gold">{eyebrow}</p>
        <h1 class="font-serif text-4xl font-semibold leading-tight text-white md:text-5xl">
          {page.h1}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
          {intro}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={page.primaryCtaUrl}
            class="inline-flex items-center justify-center rounded-md bg-gold px-6 py-3 font-semibold text-navy transition hover:bg-gold/90 focus-visible"
          >
            {page.primaryCtaText}
          </a>
          <a
            href="/#buyer-routes"
            class="inline-flex items-center justify-center rounded-md border border-white/30 px-6 py-3 font-semibold text-white transition hover:border-gold hover:text-gold focus-visible"
          >
            Compare cleaning routes
          </a>
        </div>
      </div>
      <div class="rounded-lg border border-gold/25 bg-white/8 p-6 shadow-soft">
        <h2 class="font-serif text-2xl font-semibold text-gold">Built around the next step</h2>
        <p class="mt-4 leading-relaxed text-white/80">{page.positioning}</p>
        <dl class="mt-6 space-y-4">
          <div>
            <dt class="text-sm font-semibold uppercase tracking-[0.14em] text-white/55">For</dt>
            <dd class="mt-1 text-white">{page.audience}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-[0.14em] text-white/55">Quote basis</dt>
            <dd class="mt-1 text-white">Property type, size, condition, access, timing and agreed add-ons.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Context</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-navy">What this clean is solving</h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-ink/75">
        <p>{page.problem}</p>
        <p>{intro}</p>
        {coverageNote && <p>{coverageNote}</p>}
      </div>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Scope</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-navy">What can be included</h2>
        <p class="mt-4 text-ink/70">
          Every quote is scoped to the property and the next step it needs to be ready for.
        </p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {inclusions.map((item) => (
          <div class="rounded-lg border border-gold/20 bg-white p-5 shadow-soft">
            <i class="fas fa-check text-gold"></i>
            <p class="mt-3 font-medium leading-relaxed text-navy">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Fit</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-navy">Who it is for</h2>
        <ul class="mt-6 space-y-3 text-ink/75">
          {audiences.map((item) => (
            <li class="flex gap-3">
              <i class="fas fa-user-check mt-1 text-gold"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg bg-navy p-6 text-white md:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Process</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-white">Clear scoping, then careful cleaning</h2>
        <ol class="mt-6 space-y-4">
          {process.map((item, index) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold text-sm font-semibold text-gold">
                {index + 1}
              </span>
              <span class="leading-relaxed text-white/82">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Related pages</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold text-navy">Plan the right cleaning route</h2>
          <p class="mt-4 text-ink/70">
            These pages connect the main service hubs and the related cleaning scopes that often sit around this request.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {links.map((link) => (
            <a
              href={link.href}
              class="rounded-lg border border-gold/20 bg-white p-5 font-semibold text-navy shadow-soft transition hover:border-gold hover:text-gold"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">FAQs</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-navy">Useful questions before quoting</h2>
        <div class="mt-8 divide-y divide-gold/20 rounded-lg border border-gold/20">
          {faqs.map((faq) => (
            <details class="group bg-white p-5">
              <summary class="cursor-pointer list-none font-semibold text-navy">
                {faq.question}
              </summary>
              <p class="mt-3 leading-relaxed text-ink/75">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-navy py-16 text-white md:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-gold">Quote</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-white md:text-4xl">Get a scoped cleaning quote</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/80">
        Share the property type, location, timing, condition and any add-ons needed. We will shape the quote around the cleaning outcome required.
      </p>
      <a
        href="/quote/"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-gold px-6 py-3 font-semibold text-navy transition hover:bg-gold/90 focus-visible"
      >
        Request a scoped quote
      </a>
    </div>
  </section>
</main>
