---
export interface ProcessStep {
  icon: string;
  stepNumber: number;
  title: string;
  description: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  steps?: ProcessStep[];
  className?: string;
  sectionId?: string;
  backgroundColor?: string;
  ctaText?: string;
  ctaLink?: string;
}
import CtaButton from './CtaButton.astro';

const {
  title = "The HQC Standard",
  subtitle = "A calm, repeatable way to protect the property, clarify the scope and hand back a finish that feels controlled.",
  steps = [
    {
      icon: "scope",
      stepNumber: 1,
      title: "Scope before quote",
      description: "We confirm property type, rooms, surfaces, priorities, access and frequency before recommending a tier or specialist route."
    },
    {
      icon: "surface-care",
      stepNumber: 2,
      title: "Surface-aware plan",
      description: "Products, tools and methods are matched to the finish, from everyday hygiene to more considered WellClean™ detail."
    },
    {
      icon: "secure-access",
      stepNumber: 3,
      title: "Secure, discreet access",
      description: "Arrival, keys, opening hours and sensitivities are agreed in advance so homes and client-facing spaces feel looked after."
    },
    {
      icon: "handover",
      stepNumber: 4,
      title: "Clear handover",
      description: "Notes, photos where appropriate, and next-step recommendations help recurring clients keep standards consistent."
    }
  ],
  className = "",
  sectionId = "process",
  backgroundColor = "bg-porcelain",
  ctaText = "Request Your Personalised Quote",
  ctaLink = "/quote/"
} = Astro.props;
---

<section id={sectionId} class={`py-20 sm:py-24 ${backgroundColor} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Process</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">{title}</h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-ink/72 md:text-lg">
          {subtitle}
        </p>
        {ctaText && ctaLink && (
          <div class="mt-8">
            <CtaButton href={ctaLink}>
              {ctaText}
            </CtaButton>
          </div>
        )}
      </div>

      <ol class="grid gap-4 md:grid-cols-2" role="list">
        {steps.map((step) => (
          <li class="rounded-[1.5rem] border border-stone bg-white p-6 shadow-soft-sm">
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-brass/35 bg-porcelain text-sm font-semibold text-brass">
                {String(step.stepNumber).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-serif text-2xl font-semibold text-night">{step.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink/72">{step.description}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
