---
export interface ProcessStep {
  icon: string;
  stepNumber: number;
  title: string;
  description: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  steps?: ProcessStep[];
  className?: string;
  sectionId?: string;
  backgroundColor?: string;
}
import CtaButton from './CtaButton.astro'; 
const {
  title = "How HQC scopes your clean",
  subtitle = "A practical route from enquiry to agreed scope, clean and next step.",
  steps = [
    {
      icon: "fas fa-message",
      stepNumber: 1,
      title: "Tell us",
      description: "Share the property type, location, deadline and what needs to be ready."
    },
    {
      icon: "fas fa-clipboard-list",
      stepNumber: 2,
      title: "Agree the scope",
      description: "HQC confirms priorities, access notes, add-ons and the quote basis before work begins."
    },
    {
      icon: "fas fa-broom",
      stepNumber: 3,
      title: "Clean to standard",
      description: "The clean is carried out around the agreed rooms, surfaces, timing and presentation needs."
    },
    {
      icon: "fas fa-clipboard-check",
      stepNumber: 4,
      title: "Confirm next steps",
      description: "We help you decide whether the space needs handover, maintenance, repeat support or a deeper reset."
    }
  ],
  className = "",
  sectionId = "process",
  backgroundColor = "bg-white",
  ctaText = "Request a Cleaning Quote",
  ctaLink = "/quote/"

} = Astro.props;
---

<section id={sectionId} class={`py-20 sm:py-24 ${backgroundColor} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-3xl md:text-6xl">{title}</h2>
    <p class="mt-4 text-ink/70 max-w-3xl text-sm md:text-base">
      {subtitle}
    </p>

    <ol
      class="mt-12 grid grid-cols-1 md:grid-cols-4 gap-8 text-center"
      role="list"
    >
      {steps.map((step) => (
        <li class="rounded-2xl p-6 border border-gold bg-white">
          <div class="mx-auto flex items-center justify-center rounded-full border-2 border-gold w-16 h-16 bg-navy/5">
            <i class={`${step.icon} text-gold text-3xl`}></i>
          </div>
          <div class="mt-4 font-medium text-navy">
            {step.stepNumber}. {step.title}
          </div>
          <p class="text-sm text-ink/70">
            {step.description}
          </p>
        </li>
      ))}
    </ol>
  </div>
  {ctaText && ctaLink && (
    <div class="text-center mt-8">
      <CtaButton href={ctaLink}>
        {ctaText}
      </CtaButton>  
    </div>
  )}
</section>
