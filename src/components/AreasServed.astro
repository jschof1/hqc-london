---
export interface AreaLocation {
  name: string;
  postcode: string;
  link?: string;
}

export interface AreaImage {
  src: string;
  alt: string;
  caption: string;
  link?: string;
}
import CtaButton from './CtaButton.astro';
export interface AreaLink {
  name: string;
  link: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  areasListText?: AreaLink[];
  mapImage?: string;
  mapImageAlt?: string;
  surreyTitle?: string;
  surreyLocations?: AreaLocation[];
  featuredAreas?: AreaImage[];
  mobileAreas?: AreaImage[];
  className?: string;
  sectionId?: string;
  backgroundColor?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title = "Areas served across London",
  subtitle = "HQC focuses on South West, Central and North West London, with select outer-London and Surrey support discussed by availability.",
  areasListText = [
    { name: "Wandsworth", link: "/locations/london/wandsworth/" },
    { name: "Chelsea", link: "/locations/london/chelsea/" },
    { name: "Kensington", link: "/locations/london/kensington/" },
    { name: "Belgravia", link: "/locations/london/belgravia/" },
    { name: "Mayfair", link: "/locations/london/mayfair/" },
    { name: "Hampstead", link: "/locations/london/hampstead/" }
  ],
  mapImage = "/images/london.jpg",
  mapImageAlt = "London skyline representing HQC coverage areas",
  surreyTitle = "Select Surrey support by arrangement",
  surreyLocations = [
    {
      name: "Weybridge",
      postcode: "KT13",
      link: "/locations/surrey/weybridge/"
    },
    {
      name: "Hersham",
      postcode: "KT12",
      link: "/locations/surrey/hersham/"
    },
    {
      name: "Walton-on-Thames",
      postcode: "KT12",
      link: "/locations/surrey/walton-on-thames/"
    }
  ],
  featuredAreas = [
    {
      src: "/images/areas/wandsworth-town.webp",
      alt: "Wandsworth residential streets and homes",
      caption: "South West London",
      link: "/locations/london/wandsworth/"
    },
    {
      src: "/images/areas/chelsea.webp",
      alt: "Chelsea townhouses and premium London property",
      caption: "Central London",
      link: "/locations/london/chelsea/"
    },
    {
      src: "/images/areas/hampstead.webp",
      alt: "Hampstead homes and streets",
      caption: "North West London",
      link: "/locations/london/hampstead/"
    }
  ],
  className = "",
  sectionId = "areas",
  backgroundColor = "bg-cream",
  ctaText = "Request availability with your quote",
  ctaLink = "/quote/"
} = Astro.props;

const coverageGroups = [
  {
    name: 'South West London',
    areas: 'Wandsworth, Clapham, Putney, Wimbledon, Balham and Battersea',
  },
  {
    name: 'Central London',
    areas: 'Chelsea, Knightsbridge, Kensington, Belgravia, Mayfair and Marylebone',
  },
  {
    name: 'North West London',
    areas: 'Hampstead, Highgate, Maida Vale and St John’s Wood',
  },
  {
    name: 'Available on request',
    areas: 'Richmond, Barnes, Notting Hill, Holland Park, Dulwich, Blackheath, City of London and select Surrey locations',
  },
];
---

<section id={sectionId} class={`py-20 sm:py-24 ${backgroundColor} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Coverage</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">{title}</h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-ink/72 md:text-lg">
          {subtitle}
        </p>
      </div>
      <div class="flex flex-wrap gap-3 text-sm text-ink/64">
        {areasListText.map((area) => (
          <a href={area.link} class="rounded-full border border-stone bg-white px-4 py-2 no-underline transition-colors hover:border-brass hover:text-brass">
            {area.name}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="overflow-hidden rounded-[1.5rem] border border-stone bg-white shadow-soft-sm">
        <img
          src={mapImage}
          alt={mapImageAlt}
          class="h-72 w-full object-cover"
          loading="lazy"
        />
        <div class="p-6">
          <h3 class="font-serif text-2xl font-semibold text-night">Priority coverage groups</h3>
          <div class="mt-5 grid gap-4">
            {coverageGroups.map((group) => (
              <div class="border-t border-stone pt-4 first:border-t-0 first:pt-0">
                <p class="text-sm font-semibold text-night">{group.name}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink/70">{group.areas}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-3 lg:grid-cols-1">
        {featuredAreas.map((area) => (
          <figure class="overflow-hidden rounded-[1.5rem] border border-stone bg-white shadow-soft-sm transition duration-300 hover:-translate-y-0.5 hover:border-brass/50">
            {area.link ? (
              <a href={area.link} class="block no-underline">
                <img
                  src={area.src}
                  alt={area.alt}
                  class="h-40 w-full object-cover"
                  loading="lazy"
                />
                <figcaption class="p-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{area.caption}</p>
                  <p class="mt-2 text-sm text-ink/70">View local coverage details</p>
                </figcaption>
              </a>
            ) : (
              <>
                <img src={area.src} alt={area.alt} class="h-40 w-full object-cover" loading="lazy" />
                <figcaption class="p-5 text-sm font-semibold text-night">{area.caption}</figcaption>
              </>
            )}
          </figure>
        ))}
      </div>
    </div>

    {surreyLocations.length > 0 && (
      <div class="mt-8 rounded-[1.5rem] border border-brass/20 bg-white p-6">
        <h3 class="font-serif text-2xl font-semibold text-night">{surreyTitle}</h3>
        <div class="mt-4 grid gap-4 text-sm text-ink/70 md:grid-cols-3">
          {surreyLocations.map((location) => (
            <div class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-brass"></span>
              <div>
                {location.link ? (
                  <a href={location.link} class="font-semibold text-night no-underline hover:text-brass">{location.name}</a>
                ) : (
                  <div class="font-semibold text-night">{location.name}</div>
                )}
                <div class="text-xs text-ink/58">{location.postcode}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  {ctaText && ctaLink && (
    <div class="mt-10 text-center">
      <CtaButton href={ctaLink}>
        {ctaText}
      </CtaButton>
    </div>
  )}
</section>
