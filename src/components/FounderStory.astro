---
export interface Qualification {
  title: string;
}

export interface Feature {
  icon: string;
  text: string;
}

export interface Props {
  name?: string;
  title?: string;
  biography?: string;
  image?: string;
  imageAlt?: string;
  qualifications?: Qualification[];
  qualificationsTitle?: string;
  features?: Feature[];
  ctaText?: string;
  ctaLink?: string;
  className?: string;
  backgroundColor?: string;
}

const defaultBiography =
  "I started High Quality Clean with just two things: a mop and a mindset. After years in technical engineering, I knew how to build systems. But during lockdown, I saw a bigger need, people did not just want clean homes. They wanted peace. Dignity. Trust. HQC became my way of delivering that and empowering others to do the same.";

const {
  name = "Pedro",
  title = "Meet Pedro, Founder of High Quality Clean",
  biography = defaultBiography,
  image = "/images/pedro.jpg",
  imageAlt = "Pedro, founder of High Quality Clean",
  qualifications = [
    { title: "Bachelor's Degree - Chemical Engineering" },
    { title: "Masters in Digital Technology Solutions" },
    { title: "Certified Quality Auditor (CQA)" },
    { title: "Chartered Chemical Engineering (ICHemE)" },
    { title: "Chartered Quality Professional (CQI)" },
    { title: "Prochem Certificate 2025/036 - Professional Cleaning & Upholstery" },
    { title: "Prochem Certificate 2025/132 - Carpets, Rugs & Soft Floor Coverings" }
  ],
  qualificationsTitle = "Credentials already used in HQC copy",
  features = [
    { icon: "fas fa-list-check", text: "Scope-led cleaning plans before work begins" },
    { icon: "fas fa-hand-holding-heart", text: "Peace, dignity and trust as part of the service standard" },
    { icon: "fas fa-vial", text: "Technical thinking applied to surfaces, products and routines" },
    { icon: "fas fa-camera", text: "Clear communication and practical handover notes" }
  ],
  ctaText = "Request Your Personalised Quote",
  ctaLink = "/quote/",
  className = "",
  backgroundColor = "bg-porcelain"
} = Astro.props;
---

<section class={`py-20 sm:py-24 ${backgroundColor} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <figure class="overflow-hidden rounded-[2rem] border border-stone bg-white shadow-soft">
        <img
          src={image}
          alt={imageAlt}
          class="h-auto w-full object-cover lg:h-[44rem]"
          loading="lazy"
        />
      </figure>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Founder credibility</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
          {title}
        </h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink/76">
          <p>{biography}</p>
          <p>
            {name}'s background gives HQC its blend of structure and care: cleaning is planned, products are considered, and communication stays calm before, during and after the visit.
          </p>
        </div>

        {qualifications.length > 0 && (
          <div class="mt-8 rounded-[1.5rem] border border-stone bg-white p-6 shadow-soft-sm">
            <h3 class="font-serif text-2xl font-semibold text-night">{qualificationsTitle}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/64">
              Exact public credentials are limited here to qualifications already present in current HQC site copy. Additional regulated claims should be confirmed before publishing.
            </p>
            <div class="mt-5 grid gap-3 text-sm text-ink/76 sm:grid-cols-2">
              {qualifications.map((qualification) => (
                <div class="flex items-start gap-3">
                  <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-brass"></span>
                  <span>{qualification.title}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {features.length > 0 && (
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {features.map((feature) => (
              <div class="rounded-2xl border border-stone bg-white p-5 shadow-soft-sm">
                <i class={`${feature.icon} text-brass`} aria-hidden="true"></i>
                <p class="mt-3 text-sm leading-relaxed text-ink/76">{feature.text}</p>
              </div>
            ))}
          </div>
        )}

        {ctaText && ctaLink && (
          <div class="mt-8">
            <a
              href={ctaLink}
              class="inline-flex items-center justify-center rounded-md bg-night px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-night/90"
            >
              {ctaText}
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
