---
import { buyerRoutes } from '../data/routes';

const propertyRoute = buyerRoutes.find((route) => route.key === 'propertyAndFacilities');
const primaryRoutes = buyerRoutes
  .filter((route) => route.key === 'homes' || route.key === 'commercialAndWellness')
  .sort((a, b) => a.priority - b.priority);
---

<section id="buyer-routes" class="bg-cream py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">
        Choose your route
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
        Start with Home Cleaning or Commercial Cleaning
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/74">
        Two clear entry points keep the conversation simple. HQC then scopes the property, access, finish and frequency before quoting.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {primaryRoutes.map((route) => (
        <article class="flex min-h-full flex-col rounded-[2rem] border border-stone bg-white p-7 shadow-soft-sm transition duration-300 hover:-translate-y-0.5 hover:border-brass/55 md:p-9">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brass">
            {route.key === 'homes' ? 'Residential route' : 'Commercial route'}
          </p>
          <h3 class="mt-4 font-serif text-3xl font-semibold text-night">
            {route.key === 'homes' ? 'Home Cleaning' : 'Commercial Cleaning'}
          </h3>
          <p class="mt-4 text-sm font-semibold uppercase tracking-[0.12em] text-ink/52">
            {route.audience}
          </p>
          <p class="mt-5 flex-1 text-base leading-relaxed text-ink/74">
            {route.buyerProblem}
          </p>
          <a
            href={route.ctaUrl}
            class="mt-8 inline-flex items-center justify-center rounded-full bg-night px-6 py-3 font-semibold text-white no-underline transition duration-300 hover:bg-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2"
          >
            {route.ctaText}
            <svg class="ml-2 h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </article>
      ))}
    </div>

    {propertyRoute && (
      <div class="mt-8 rounded-[1.5rem] border border-brass/25 bg-sage/45 p-6 md:flex md:items-center md:justify-between md:gap-8">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass">Property teams</p>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-night">Managed-property support sits under the commercial conversation</h3>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink/72">
            Agents, landlords, block managers and developers can still use HQC for viewing, handover, resident and next-occupant cleaning support.
          </p>
        </div>
        <a
          href={propertyRoute.ctaUrl}
          class="mt-5 inline-flex shrink-0 items-center justify-center rounded-full border border-night/15 bg-white px-5 py-3 text-sm font-semibold text-night no-underline transition duration-300 hover:border-brass hover:text-brass md:mt-0"
        >
          {propertyRoute.ctaText}
        </a>
      </div>
    )}
  </div>
</section>
