---
// Header component
const navLinks = [
  { href: '/home-cleaning/', label: 'Home Cleaning' },
  { href: '/commercial-and-wellness-cleaning/', label: 'Commercial Cleaning' },
  { href: '/areas/', label: 'Areas' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/contact/', label: 'Contact' },
];

const quoteCta = {
  href: '/quote/',
  label: 'Request Your Personalised Quote',
};
---

<header
  class="nav-transition fixed inset-x-0 top-0 z-40 border-b border-stone/70 bg-porcelain/95 text-ink shadow-soft-sm backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="group inline-flex items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain"
      aria-label="High Quality Clean home"
    >
      <span class="h-8 w-px bg-brass/70 transition-colors group-hover:bg-night"></span>
      <span class="font-heading text-xl font-semibold tracking-wide text-night">
        High Quality Clean
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden xl:flex items-center gap-4 text-sm" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-1.5 py-2 font-medium text-night/80 transition-colors hover:text-night focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain"
        >
          {link.label}
        </a>
      ))}
      <a
        href={quoteCta.href}
        class="ml-1 inline-flex items-center rounded-full border border-night bg-night px-5 py-2.5 text-sm font-semibold text-porcelain shadow-brass transition-colors hover:border-brass hover:bg-brass hover:text-night focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain"
      >
        {quoteCta.label}
      </a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-toggle"
      class="xl:hidden inline-flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-full border border-stone bg-cream text-night transition-colors hover:border-brass focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain"
      aria-label="Open mobile menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
    >
      <span class="hamburger-line h-0.5 w-5 bg-current transition-transform duration-300 ease-in-out"></span>
      <span class="hamburger-line h-0.5 w-5 bg-current transition-opacity duration-300 ease-in-out"></span>
      <span class="hamburger-line h-0.5 w-5 bg-current transition-transform duration-300 ease-in-out"></span>
    </button>
  </div>

  <!-- Mobile Full-Screen Navigation Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden min-h-screen translate-x-full overflow-y-auto bg-night text-porcelain transition-transform duration-300 ease-in-out xl:hidden"
    style="height: 100vh; height: 100dvh;"
    aria-hidden="true"
    inert
    hidden
  >
    <div class="flex min-h-full flex-col">
      <!-- Mobile Header with Close Button -->
      <div class="flex items-center justify-between border-b border-brass/25 p-4">
        <a
          href="/"
          class="inline-flex items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          aria-label="High Quality Clean home"
        >
          <span class="h-8 w-px bg-brass/80"></span>
          <span class="font-heading text-xl font-semibold tracking-wide text-porcelain">
            High Quality Clean
          </span>
        </a>
        <button
          id="mobile-menu-close"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-brass/35 text-porcelain transition-colors hover:border-brass hover:text-brass focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          aria-label="Close mobile menu"
          type="button"
        >
          <span class="sr-only">Close menu</span>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation Links -->
      <nav class="flex flex-1 flex-col justify-center px-8 py-10" aria-label="Mobile primary navigation">
        <div class="space-y-5">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link block rounded-md border-b border-stone/15 pb-3 text-2xl font-light text-porcelain transition-colors hover:border-brass hover:text-brass focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-night"
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Mobile CTA Button -->
        <div class="mt-8 border-t border-brass/20 pt-8">
          <a
            href={quoteCta.href}
            class="mobile-nav-link inline-flex w-full items-center justify-center rounded-full border border-brass bg-brass px-6 py-4 text-center text-base font-semibold text-night transition-colors hover:bg-porcelain hover:text-night focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          >
            {quoteCta.label}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle functionality
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const hamburgerLines = document.querySelectorAll('.hamburger-line');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const body = document.body;
    let scrollPosition = 0;
    let closeTimer;

    // Early return if required elements are not found
    if (!mobileMenuToggle || !mobileMenu || !mobileMenuClose) {
      return;
    }

    function setMenuClosedForAssistiveTech() {
      mobileMenu.setAttribute('aria-hidden', 'true');
      mobileMenu.setAttribute('inert', '');
      mobileMenu.setAttribute('hidden', '');
      mobileMenu.classList.add('hidden');
    }

    function setMenuOpenForAssistiveTech() {
      mobileMenu.removeAttribute('hidden');
      mobileMenu.classList.remove('hidden');
      mobileMenu.setAttribute('aria-hidden', 'false');
      mobileMenu.removeAttribute('inert');
    }

    function openMobileMenu() {
      window.clearTimeout(closeTimer);

      scrollPosition = window.pageYOffset || window.scrollY || 0;
      setMenuOpenForAssistiveTech();

      requestAnimationFrame(() => {
        mobileMenu.classList.remove('translate-x-full');
        mobileMenu.classList.add('translate-x-0');
      });

      mobileMenuToggle.setAttribute('aria-expanded', 'true');
      mobileMenuToggle.setAttribute('aria-label', 'Close mobile menu');
      body.classList.add('overflow-hidden');
      body.style.top = `-${scrollPosition}px`;
      body.dataset.scrollPosition = `${scrollPosition}`;
      mobileMenuClose.focus({ preventScroll: true });
      
      // Animate hamburger to X
      if (hamburgerLines.length >= 3) {
        hamburgerLines[0].classList.add('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.add('opacity-0');
        hamburgerLines[2].classList.add('-rotate-45', '-translate-y-2');
      }
    }

    function closeMobileMenu(options = {}) {
      const { restoreScroll = true } = options;
      
      mobileMenu.classList.remove('translate-x-0');
      mobileMenu.classList.add('translate-x-full');
      mobileMenuToggle.setAttribute('aria-expanded', 'false');
      mobileMenuToggle.setAttribute('aria-label', 'Open mobile menu');

      if (restoreScroll) {
        mobileMenuToggle.focus({ preventScroll: true });
      }

      mobileMenu.setAttribute('aria-hidden', 'true');
      mobileMenu.setAttribute('inert', '');

      const lastScrollPosition = scrollPosition || parseInt(body.dataset.scrollPosition || '0', 10) || 0;
      body.classList.remove('overflow-hidden');
      body.style.top = '';
      delete body.dataset.scrollPosition;

      closeTimer = window.setTimeout(setMenuClosedForAssistiveTech, 320);

      if (restoreScroll) {
        requestAnimationFrame(() => {
          window.scrollTo({ top: lastScrollPosition, behavior: 'auto' });
        });
      }
      
      // Reset hamburger animation
      if (hamburgerLines.length >= 3) {
        hamburgerLines[0].classList.remove('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.remove('opacity-0');
        hamburgerLines[2].classList.remove('-rotate-45', '-translate-y-2');
      }
    }

    // Toggle mobile menu
    mobileMenuToggle.addEventListener('click', function() {
      if (mobileMenu.hasAttribute('hidden')) {
        openMobileMenu();
      } else {
        closeMobileMenu({ restoreScroll: true });
      }
    });
    mobileMenuClose.addEventListener('click', () => closeMobileMenu({ restoreScroll: true }));

    // Close menu when clicking on navigation links
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu({ restoreScroll: false });
      });
    });

    // Close menu when pressing Escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && !mobileMenu.hasAttribute('hidden')) {
        closeMobileMenu({ restoreScroll: true });
      }
    });

    // Close menu when clicking outside (on overlay)
    mobileMenu.addEventListener('click', function(event) {
      if (event.target === mobileMenu) {
        closeMobileMenu({ restoreScroll: true });
      }
    });
  });
</script>

<style>
  .hamburger-line {
    transform-origin: center;
  }

  /* Prevent scrolling when mobile menu is open */
  :global(body.overflow-hidden) {
    overflow: hidden !important;
    position: fixed;
    width: 100%;
  }
</style>
