<script>
  const desktopGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  const closeDesktopMenu = (group: HTMLElement, returnFocus = false) => {
    const menuToggle = group.querySelector<HTMLButtonElement>('button[aria-controls]');
    group.classList.remove('is-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    if (returnFocus) menuToggle?.focus();
  };

  desktopGroups.forEach((group) => {
    const menuToggle = group.querySelector<HTMLButtonElement>('button[aria-controls]');
    if (!menuToggle) return;
    menuToggle.addEventListener('click', () => {
      const willOpen = menuToggle.getAttribute('aria-expanded') !== 'true';
      desktopGroups.forEach((otherGroup) => closeDesktopMenu(otherGroup));
      group.classList.toggle('is-open', willOpen);
      menuToggle.setAttribute('aria-expanded', String(willOpen));
    });
    group.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDesktopMenu(group, true);
      }
    });
    group.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!group.contains(document.activeElement)) closeDesktopMenu(group);
      });
    });
  });
  document.addEventListener('click', (event) => {
    if (!desktopGroups.some((group) => group.contains(event.target as Node))) {
      desktopGroups.forEach((group) => closeDesktopMenu(group));
    }
  });

  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const closeMobileMenu = (returnFocus = false) => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      if (returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => {
      const open = !menu.classList.contains('hidden');
      if (open) {
        closeMobileMenu(true);
      } else {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      closeMobileMenu();
    }));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMobileMenu(true);
    });
  }
</script>

