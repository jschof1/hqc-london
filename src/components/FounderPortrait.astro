---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['mx-auto w-full max-w-96', className]} data-founder-portrait>
  <img
    src="/images/pedro-founder-640.webp"
    srcset="/images/pedro-founder-320.webp 320w, /images/pedro-founder-640.webp 640w, /images/pedro-founder-960.webp 960w"
    sizes="(max-width: 424px) calc(100vw - 40px), 384px"
    alt="Pedro Ndombasi, founder of High Quality Clean"
    class="h-auto w-full rounded-2xl object-contain"
    loading="lazy"
    decoding="async"
    width="1152"
    height="2048"
  />
</figure>
