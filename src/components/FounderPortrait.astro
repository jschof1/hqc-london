---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['mx-auto w-full max-w-96', className]} data-founder-portrait>
  <img
    src="/images/pedro-founder-portrait-753.webp"
    srcset="/images/pedro-founder-portrait-400.webp 400w, /images/pedro-founder-portrait-753.webp 753w"
    sizes="(max-width: 424px) calc(100vw - 40px), 384px"
    alt="Pedro Ndombasi, founder of High Quality Clean"
    class="h-auto w-full rounded-2xl object-contain"
    loading="lazy"
    decoding="async"
    width="753"
    height="941"
  />
</figure>
