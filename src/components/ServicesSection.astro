---
import { serviceTiers } from '../data/serviceTiers';

export interface Props {
  title?: string;
  subtitle?: string;
  mainCtaText?: string;
  mainCtaLink?: string;
  className?: string;
  sectionId?: string;
  backgroundColor?: string;
}

const {
  title = 'Choose Your Home Cleaning Tier',
  subtitle = 'The same Essentials, Signature and WellClean™ Premium ladder can be used across the homepage, Home Cleaning page and Services page without duplicated copy.',
  mainCtaText = 'Request Your Personalised Quote',
  mainCtaLink = '/quote/',
  className = '',
  sectionId = 'services',
  backgroundColor = 'bg-white',
} = Astro.props;
---

<section id={sectionId} class={`py-20 sm:py-24 ${backgroundColor} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold">Service tiers</p>
      <h2 class="font-serif text-4xl font-semibold text-navy md:text-6xl">{title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/70">{subtitle}</p>
      <p class="mt-4 text-base font-semibold text-navy">
        For clients who value calm, precision and consistency, not the cheapest available clean.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {serviceTiers.map((tier) => (
        <article class="flex min-h-full flex-col rounded-3xl border border-gold/30 bg-white p-8 shadow-soft transition duration-300 hover:border-gold">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">{tier.emotionalOutcome}</p>
              <h3 class="mt-3 font-serif text-2xl font-semibold text-navy">{tier.name}</h3>
            </div>
            {tier.id === 'signature' && <span class="rounded-full bg-navy px-3 py-1 text-xs font-semibold text-white">Most requested</span>}
            {tier.id === 'wellclean-premium' && <span class="rounded-full bg-gold px-3 py-1 text-xs font-semibold text-navy">Premium</span>}
          </div>

          <p class="mt-4 font-medium text-ink/85">{tier.tagline}</p>
          <p class="mt-3 text-sm text-ink/65">Target: {tier.targetClient}</p>
          <p class="mt-2 text-sm font-semibold text-navy">{tier.indicativeRange}</p>

          <ul class="mt-6 flex-1 space-y-3 text-sm text-ink/72">
            {tier.inclusions.slice(0, 7).map((feature) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-gold"></span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="mt-6 rounded-2xl bg-cream p-4 text-sm text-ink/70">
            <span class="font-semibold text-navy">Boundaries:</span> {tier.exclusionsOrAddOns.join(', ')}.
          </div>

          <a
            href={`/quote/?tier=${tier.id}`}
            class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-gold px-6 py-3 font-semibold text-navy transition duration-300 hover:bg-gold/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2"
          >
            {tier.ctaText}
          </a>
        </article>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a href={mainCtaLink} class="inline-flex items-center rounded-md border border-gold bg-navy px-8 py-4 text-lg font-semibold text-white transition duration-300 hover:bg-navy/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2">
        {mainCtaText}
        <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
