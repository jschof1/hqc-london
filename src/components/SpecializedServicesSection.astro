---
export interface SpecializedService {
  name: string;
  description: string;
  tagline: string;
  icon: string;
  link: string;
  group?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  services?: SpecializedService[];
  ctaText?: string;
  ctaLink?: string;
  className?: string;
  sectionId?: string;
  backgroundColor?: string;
  textColor?: string;
}

import CtaButton from './CtaButton.astro';

const {
  title = "Specialised add-ons and support routes",
  subtitle = "Once the main route is clear, HQC can scope specialist resets, turnover support, wellness spaces, laundry and property-team needs as part of a quote conversation.",
  services = [
    {
      name: "Move In / Move Out Clean Reset™",
      description: "Detailed reset for check-out, handover, move-in or next-occupant readiness, with cupboards, drawers and heavier details scoped before quoting.",
      tagline: "Leave it spotless. Start fresh.",
      icon: "reset",
      link: "/services/end-of-tenancy-cleaning/",
      group: "Home + property"
    },
    {
      name: "Airbnb Turnover Clean™",
      description: "Guest-ready cleaning around rapid changeovers, presentation details and repeatable hosting standards.",
      tagline: "Five-star hosting, every time.",
      icon: "turnover",
      link: "/services/airbnb-cleaning/",
      group: "Home + hosting"
    },
    {
      name: "HQC Office Clean™",
      description: "Cleaning for boutique offices and client-facing spaces where hygiene, order and first impression matter.",
      tagline: "Confidence in your first impression.",
      icon: "office",
      link: "/commercial-and-wellness-cleaning/",
      group: "Commercial"
    },
    {
      name: "WellClean™ Studio Edition",
      description: "Considered cleaning for spas, saunas, cold plunges and wellness studios, with methods matched to the space and standard required.",
      tagline: "Trust at a wellness level.",
      icon: "wellness",
      link: "/commercial-and-wellness-cleaning/",
      group: "Commercial + wellness"
    },
    {
      name: "HQC Concierge Laundry",
      description: "Laundry and garment-care support can be discussed alongside recurring home, Airbnb or family requirements.",
      tagline: "Your home, your wardrobe, five-star clean.",
      icon: "laundry",
      link: "/services/ironing-and-laundry/",
      group: "Concierge"
    },
    {
      name: "Property Team Support",
      description: "Support for agents, landlords, block managers and developers preparing spaces for viewing, re-let, resident standards or handover.",
      tagline: "Fewer standards to chase between property stages.",
      icon: "property",
      link: "/property-and-facilities-cleaning/",
      group: "Commercial support"
    }
  ],
  ctaText = "Scope a specialist clean",
  ctaLink = "/quote/",
  className = "",
  sectionId = "specialized-services",
  backgroundColor = "bg-porcelain",
  textColor = "text-ink"
} = Astro.props;
---

<section id={sectionId} class={`py-16 md:py-20 ${backgroundColor} ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class={`mx-auto max-w-3xl text-center ${textColor}`}>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brass">Add-ons</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-night md:text-5xl">
        {title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/74">
        {subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <article class="flex min-h-full flex-col rounded-[1.5rem] border border-stone bg-white p-6 shadow-soft-sm transition duration-300 hover:-translate-y-0.5 hover:border-brass/50">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brass">{service.group || service.icon}</p>
          <h3 class="mt-3 font-serif text-2xl font-semibold text-night">{service.name}</h3>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-ink/72">{service.description}</p>
          <p class="mt-5 border-l-2 border-brass pl-3 text-sm font-semibold italic text-ink/76">“{service.tagline}”</p>
          <a href={service.link} class="mt-6 inline-flex items-center text-sm font-semibold text-night no-underline transition-colors hover:text-brass">
            Learn more
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>

    {ctaText && ctaLink && (
      <div class="mt-10 text-center">
        <CtaButton href={ctaLink}>
          {ctaText}
        </CtaButton>
      </div>
    )}
  </div>
</section>
