---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { DEVELOPMENT_ROBOTS, getRobotsContent, PRODUCTION_ROBOTS } from '../lib/env';

import { Schema } from 'astro-seo-schema';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "High Quality Clean provides practical premium cleaning for London homes, property teams and client-facing spaces.",
  robots = PRODUCTION_ROBOTS
} = Astro.props;
const isCloudflarePreviewHost = Astro.url?.hostname.endsWith('.pages.dev') ?? false;
const robotsContent = isCloudflarePreviewHost ? DEVELOPMENT_ROBOTS : getRobotsContent(robots);

const baseUrl = 'https://highqualityclean.co.uk';
const canonicalPath = Astro.url?.pathname
  ? Astro.url.pathname.toLowerCase().replace(/\/?$/, '/')
  : '/';
const canonicalUrl = new URL(canonicalPath, baseUrl).href;
const defaultImage = `${baseUrl}/images/areas/mayfair.webp`;
const ServiceAreaNames = [
  'Belgravia',
  'Chelsea',
  'Kensington',
  'Mayfair',
  'Knightsbridge',
  'St John\'s Wood',
  'Hampstead',
  'Primrose Hill',
  'Highgate',
  'Weybridge',
  'Hersham',
  'Walton-on-Thames'
];

const sameAs = [
  'https://www.facebook.com/highqualityclean',
  'https://www.yell.com/biz/high-quality-clean-ltd-london-901756897/',
  'https://www.tiktok.com/@highqualityclean',
  'https://www.linkedin.com/company/high-quality-cleaning/',
  'https://www.instagram.com/highqualitycleanltd/',
  'https://www.bark.com/en/gb/company/high-quality-clean-ltd/LnAX9/'

];

const areaNodes = [
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/belgravia/`,
    name: 'Belgravia',
    areaType: 'Home and property cleaning support',
    description:
      'Cleaning support for Central London homes and managed properties, with scopes agreed around the space and timing.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Homeowners, tenants, landlords and property teams'
    }
  },
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/chelsea/`,
    name: 'Chelsea',
    areaType: 'Home and property cleaning support in Chelsea',
    description:
      'Cleaning support for Chelsea homes, move-outs, managed properties and client-facing spaces where presentation matters.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Households, agents, landlords and property managers'
    }
  },
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/kensington/`,
    name: 'Kensington',
    areaType: 'Home and property cleaning support in Kensington',
    description:
      'Cleaning support for Kensington homes and managed properties that need careful handling and ready presentation.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Households, agents, landlords and property managers'
    }
  },
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/mayfair/`,
    name: 'Mayfair',
    areaType: 'Home and property cleaning support in Mayfair',
    description:
      'Cleaning support for Mayfair homes, handovers and client-facing spaces where scope, access and presentation matter.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Households, agents, landlords and property managers'
    }
  },
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/knightsbridge/`,
    name: 'Knightsbridge',
    areaType: 'Home and property cleaning support in Knightsbridge',
    description:
      'Cleaning support for Knightsbridge homes and properties that need careful handling and practical presentation standards.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Households, agents, landlords and property managers'
    }
  },
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/st-johns-wood/`,
    name: 'St John\'s Wood',
    areaType: 'Home and property cleaning support in St John\'s Wood',
    description:
      'Cleaning support for St John\'s Wood homes and managed properties with agreed scopes and careful presentation.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Households, agents, landlords and property managers'
    }
  },
  {
    '@type': 'Area',
    '@id': `${baseUrl}/locations/london/hampstead/`,
    name: 'Hampstead',
    areaType: 'Home and property cleaning support in Hampstead',
    description:
      'Cleaning support for Hampstead homes and property teams where reliability, access and presentation need to be agreed clearly.',
    provider: { '@id': `${baseUrl}/#organization` },
    areaServed: ServiceAreaNames,
    audience: {
      '@type': 'Audience',
      audienceType: 'Households, agents, landlords and property managers'
    }
  }
];

const offerNodes = areaNodes.map((area) => ({
  '@type': 'Offer',
  '@id': `${area['@id']}-offer`,
  itemOffered: { '@id': area['@id'] },
  url: `${baseUrl}/quote/`,
  availability: 'https://schema.org/InStock',
  description: `Discuss cleaning support in ${area.name} with High Quality Clean.`
}));

const offerCatalogNode = {
  '@type': 'OfferCatalog',
  '@id': `${baseUrl}/#offer-catalog`,
  name: 'High Quality Clean areas',
  itemListElement: offerNodes.map((offer, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: { '@id': offer['@id'] }
  }))
};

const organizationNode = {
  '@type': ['LocalBusiness', 'CleaningService'],
  '@id': `${baseUrl}/#organization`,
  name: 'High Quality Clean',
  alternateName: 'High Quality Clean',
  url: baseUrl,
  description,
  image: defaultImage,
  logo: `${baseUrl}/favicon.ico`,
  email: 'sales@highqualityclean.co.uk',
  telephone: '+44 20 8870 3925',
  priceRange: '£££',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressRegion: 'Greater London',
    postalCode: 'SW1',
    addressCountry: 'GB'
  },
  areaServed: ServiceAreaNames,
  sameAs,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'Customer Service',
      telephone: '+44 20 8870 3925',
      email: 'sales@highqualityclean.co.uk',
      areaServed: ServiceAreaNames,
      availableLanguage: ['English']
    }
  ],
  founder: {
    '@type': 'Person',
    name: 'Pedro',
    jobTitle: 'Founder',
    description:
      'Cleaning business founder leading High Quality Clean with a focus on clear scopes, careful handling and practical standards.',
    knowsAbout: [
      'Home cleaning',
      'Property cleaning',
      'End of tenancy cleaning',
      'Post-renovation cleaning'
    ]
  },
  hasOfferCatalog: { '@id': offerCatalogNode['@id'] },
  makesOffer: offerNodes.map((offer) => ({ '@id': offer['@id'] }))
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${baseUrl}/#website`,
  url: baseUrl,
  name: 'High Quality Clean',
  description,
  inLanguage: 'en-GB',
  publisher: { '@id': organizationNode['@id'] },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${baseUrl}/?s={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const webpageNode = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { '@id': websiteNode['@id'] },
  inLanguage: 'en-GB',
  primaryImageOfPage: defaultImage,
  about: { '@id': organizationNode['@id'] }
};

const schemaItem = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteNode,
    offerCatalogNode,
    organizationNode,
    webpageNode,
    ...areaNodes,
    ...offerNodes
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Meta -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="yandexbot" content={robotsContent} />
    <meta name="google" content="notranslate" />
    <meta name="google" content="notranslate" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-0.xml" />
    <title>{title}</title>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="95c24898-5333-41ef-8fbf-a17bcac067af"></script>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <Schema item={schemaItem as any} />
  </head>
  <body class="bg-porcelain text-ink font-sans antialiased">
    <slot />
    <Footer />
    <script src="../scripts/main.js"></script>
    <script
      is:inline
      src="https://widgets.leadconnectorhq.com/loader.js"
      data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
      data-widget-id="696e24618d6c38f8cfb1c78f" >
    </script>
    <script is:inline>
      // Load Keak script after user interaction to prevent flashing
      (function() {
        let keakLoaded = false;
        let interactionOccurred = false;

        function loadKeakScript() {
          if (keakLoaded || document.getElementById('keak-script')) {
            keakLoaded = true;
            return;
          }

          const script = document.createElement('script');
          script.id = 'keak-script';
          script.src = 'https://zzontar2hsjaawcn.public.blob.vercel-storage.com/scripts/domain-402-httpshighqualityclean.co.uk.js';
          script.setAttribute('data-domain', '402');
          script.defer = true;
          document.head.appendChild(script);
          keakLoaded = true;
        }

        // Load after user interaction (scroll, click, touch, keypress)
        function handleInteraction() {
          if (!interactionOccurred) {
            interactionOccurred = true;
            // Small delay after interaction to ensure page is stable
            setTimeout(loadKeakScript, 100);
          }
        }

        // Listen for various user interactions
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(eventType => {
          document.addEventListener(eventType, handleInteraction, { once: true, passive: true });
        });

        // Fallback: Load after a delay if no interaction occurs
        // This ensures the script still loads for analytics purposes
        document.addEventListener('astro:page-load', () => {
          setTimeout(() => {
            if (!interactionOccurred) {
              // Use requestIdleCallback to load when browser is idle
              if ('requestIdleCallback' in window) {
                requestIdleCallback(loadKeakScript, { timeout: 2000 });
              } else {
                setTimeout(loadKeakScript, 2000);
              }
            }
          }, 1000);
        }, { once: false });

        // Initial page load fallback
        if (document.readyState === 'complete') {
          setTimeout(() => {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(() => {
                setTimeout(loadKeakScript, 2000);
              }, { timeout: 2000 });
            } else {
              setTimeout(loadKeakScript, 2000);
            }
          }, 1000);
        } else {
          window.addEventListener('load', () => {
            setTimeout(() => {
              if ('requestIdleCallback' in window) {
                requestIdleCallback(() => {
                  setTimeout(loadKeakScript, 2000);
                }, { timeout: 2000 });
              } else {
                setTimeout(loadKeakScript, 2000);
              }
            }, 1000);
          }, { once: true });
        }
      })();
    </script>
  </body>
</html>
