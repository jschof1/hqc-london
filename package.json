{
  "name": "hqc-london",
  "type": "module",
  "version": "1.0.0",
  "description": "High Quality Cleaning London website with Astro and Tailwind CSS",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:revision && astro build && node scripts/inject-location-sitemap.mjs",
    "test:forms": "node scripts/verify-form-routing.mjs && node --test scripts/verify-form-submission.test.mjs && node --test scripts/verify-form-worker.test.mjs",
    "test:analytics": "node --test scripts/verify-posthog.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate:all": "node scripts/generate-area-pages.js all",
    "generate:single": "node scripts/generate-area-pages.js single",
    "list": "node scripts/generate-area-pages.js list",
    "validate": "node scripts/generate-area-pages.js validate",
    "help": "node scripts/generate-area-pages.js",
    "check:revision": "node tools/client-revisions/check.mjs",
    "check:revision:scope": "node tools/client-revisions/check.mjs --scope",
    "test:revisions": "node --test tools/client-revisions/check.test.mjs",
    "build:review": "npm run check:revision:scope && astro build && node scripts/inject-location-sitemap.mjs"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "cleaning-services",
    "london",
    "seo",
    "luxury-cleaning"
  ],
  "author": "High Quality Cleaning",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.9",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.13",
    "astro": "^5.13.10",
    "astro-masonry": "^1.2.2",
    "astro-robots-txt": "^1.0.0",
    "astro-seo-meta": "^5.2.0",
    "astro-seo-schema": "^5.1.0",
    "google-maps-review-scraper": "^1.5.0",
    "posthog-js": "^1.438.9",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.1.13"
  },
  "directories": {
    "data": "data",
    "templates": "templates",
    "scripts": "scripts",
    "output": "areas"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "miniflare": "4.20250906.2"
  }
}
